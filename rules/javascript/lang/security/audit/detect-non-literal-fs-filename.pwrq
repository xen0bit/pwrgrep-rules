# rules: detect-non-literal-fs-filename
# languages: javascript, typescript
# fixture: javascript/detect-non-literal-fs-filename.js
# from: javascript/lang/security/audit/detect-non-literal-fs-filename.yaml
#
# Repair: dead as written. The file gates fed require matches into
# `at_same_place`, but a require span never coincides with a call, and the
# literal-argument exclusion `$METHOD("$$$", $$$)` read its hole as any
# value. The hundred overlapping per-method sink spellings are one `$FILE`
# hole with the method filtered by `where_capture`, the literal exclusion
# keeps only quoted text, and the gates are file-level. The `function $$$`
# wrappers never matched; sources now cover anon/named declarations and
# arrows.

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "($$$_, $ARG, $$$_) => {$$$_}",
      "($ARG) => {$$$_}",
      "$FS.$METHOD($FILE, $$$_)",
      "$FS.$METHOD($FIRST, $FILE, $$$_)",
      "$FS = require('fs')\n$$$",
      "$FS = require('fs/promises')\n$$$",
      "$METHOD($FILE, $$$_)",
      "$METHOD($FIRST, $FILE, $$$_)",
      "const $FS = require('fs')",
      "const $FS = require('fs/promises')",
      "function ($$$_, $ARG, $$$_) {$$$_}",
      "function $FUNC($$$_, $ARG, $$$_) {$$$_}",
      "import $FS from 'fs'\n$$$",
      "import $FS from 'fs/promises'\n$$$",
      "import * as $FS from 'fs'\n$$$",
      "import * as $FS from 'fs/promises'\n$$$",
      "import 'fs'\n$$$",
      "import 'fs/promises'\n$$$",
      "let $FS = require('fs')",
      "let $FS = require('fs/promises')",
      "var $FS = require('fs')",
      "var $FS = require('fs/promises')"
    ])) as $all
    | ( (($all | of(["$FS.$METHOD($FILE, $$$_)","$METHOD($FILE, $$$_)"])
          | where_capture("METHOD"; "^(access|accessSync|appendFile|appendFileSync|chmod|chmodSync|chown|chownSync|close|closeSync|copyFile|copyFileSync|cp|cpSync|createReadStream|createWriteStream|exists|existsSync|fchmod|fchmodSync|fchown|fchownSync|fdatasync|fdatasyncSync|fstat|fstatSync|fsync|fsyncSync|ftruncate|ftruncateSync|futimes|futimesSync|lchmod|lchmodSync|lchown|lchownSync|link|linkSync|lstat|lstatSync|lutimes|lutimesSync|mkdir|mkdirSync|mkdtemp|mkdtempSync|open|openSync|opendir|opendirSync|read|readFile|readFileSync|readSync|readdir|readdirSync|readlink|readlinkSync|readv|readvSync|realpath|realpath\\.native|realpathSync\\.native|realpathync|rename|renameSync|rm|rmSync|rmdir|rmdirSync|stat|statSync|symlink|symlinkSync|truncate|truncateSync|unlink|unlinkSync|unwatchFile|utimes|utimesSync|watch|watchFile|write|writeFile|writeFileSync|writeSync|writev|writevSync)$")
          | not_at(($all | of(["$FS.$METHOD($FILE, $$$_)","$METHOD($FILE, $$$_)"]) | where_capture("FILE"; "^[\"'].*[\"']$")))
          | focus("FILE"))
          + (($all | of(["$FS.$METHOD($FIRST, $FILE, $$$_)","$METHOD($FIRST, $FILE, $$$_)"])
          | where_capture("METHOD"; "^(access|accessSync|appendFile|appendFileSync|chmod|chmodSync|chown|chownSync|close|closeSync|copyFile|copyFileSync|cp|cpSync|createReadStream|createWriteStream|exists|existsSync|fchmod|fchmodSync|fchown|fchownSync|fdatasync|fdatasyncSync|fstat|fstatSync|fsync|fsyncSync|ftruncate|ftruncateSync|futimes|futimesSync|lchmod|lchmodSync|lchown|lchownSync|link|linkSync|lstat|lstatSync|lutimes|lutimesSync|mkdir|mkdirSync|mkdtemp|mkdtempSync|open|openSync|opendir|opendirSync|read|readFile|readFileSync|readSync|readdir|readdirSync|readlink|readlinkSync|readv|readvSync|realpath|realpath\\.native|realpathSync\\.native|realpathync|rename|renameSync|rm|rmSync|rmdir|rmdirSync|stat|statSync|symlink|symlinkSync|truncate|truncateSync|unlink|unlinkSync|unwatchFile|utimes|utimesSync|watch|watchFile|write|writeFile|writeFileSync|writeSync|writev|writevSync)$")
          | not_at(($all | of(["$FS.$METHOD($FIRST, $FILE, $$$_)","$METHOD($FIRST, $FILE, $$$_)"]) | where_capture("FILE"; "^[\"'].*[\"']$")))
          | focus("FILE")))
          | in_files_with(($all | of(["$FS = require('fs')\n$$$", "const $FS = require('fs')", "let $FS = require('fs')", "var $FS = require('fs')", "$FS = require('fs/promises')\n$$$", "const $FS = require('fs/promises')", "let $FS = require('fs/promises')", "var $FS = require('fs/promises')"])) + ($all | of(["import $FS from 'fs'\n$$$", "import $FS from 'fs/promises'\n$$$", "import * as $FS from 'fs'\n$$$", "import * as $FS from 'fs/promises'\n$$$", "import 'fs'\n$$$", "import 'fs/promises'\n$$$"])))
          | reaching(((($all | of(["function ($$$_, $ARG, $$$_) {$$$_}","function $FUNC($$$_, $ARG, $$$_) {$$$_}"]))
          + ($all | of(["($ARG) => {$$$_}","($$$_, $ARG, $$$_) => {$$$_}"]))
          | focus("ARG")));
              ([]))
        | finding("detect-non-literal-fs-filename";
            "Detected a non-literal filename flowing into the fs module.") ) ))
| report
