# rules: express-libxml-noent
# languages: javascript, typescript
# fixture: javascript/express-libxml-noent.js
# from: javascript/express/security/audit/express-libxml-noent.yaml
#
# Repair: `function $$$_ (...)` matched only named declarations, route callbacks had to be named, `at_same_place` needed exact span coincidence, `within(import...)` confined the sink to the import span, bare `$X = require()` missed const/let/var, and overlapping sink spellings suppressed each other; wrappers now cover anon and named shapes, gates are file-level with const/let/var require variants, and the sink is one `$DATA` hole. Globs cover *.js as well as *.ts.

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$APP.$METHOD($$$_, function $FUNC($REQ, $RES) {$$$_})",
      "$APP.$METHOD($$$_, function $FUNC($REQ, $RES, $NEXT) {$$$_})",
      "$APP.$METHOD($$$_, function ($REQ, $RES) {$$$_})",
      "$APP.$METHOD($$$_, function ($REQ, $RES, $NEXT) {$$$_})",
      "$REQ.query",
      "$REQ.body",
      "$REQ.params",
      "$REQ.cookies",
      "$REQ.headers",
      "$REQ.files.$ANYTHING.data.toString('utf8')",
      "$REQ.files.$ANYTHING['data'].toString('utf8')",
      "$LIB.parseXml($DATA, {$$$_, noent: true, $$$_})",
      "$LIB.parseXmlString($DATA, {$$$_, noent: true, $$$_})",
      "$XML = require('$IMPORT')\n$$$_",
      "const $XML = require('$IMPORT')",
      "let $XML = require('$IMPORT')",
      "var $XML = require('$IMPORT')",
      "import $XML from '$IMPORT'\n$$$_",
      "import * as $XML from '$IMPORT'\n$$$_",
      "({ $REQ }: Request,$RES: Response) => {$$$_}",
      "({ $REQ }: Request,$RES: Response, $NEXT: NextFunction) =>\n{$$$_}",
      "body",
      "cookies",
      "headers",
      "params",
      "query",
      "function ($REQ, $RES) {$$$_}",
      "function $FUNC($REQ, $RES) {$$$_}",
      "function ($REQ, $RES, $NEXT) {$$$_}",
      "function $FUNC($REQ, $RES, $NEXT) {$$$_}"
    ])) as $all
    | ( (($all | of(["$LIB.parseXml($DATA, {$$$_, noent: true, $$$_})", "$LIB.parseXmlString($DATA, {$$$_, noent: true, $$$_})"])
          | focus("DATA"))
          | in_files_with((($all | of(["$XML = require('$IMPORT')\n$$$_", "const $XML = require('$IMPORT')", "let $XML = require('$IMPORT')", "var $XML = require('$IMPORT')"]) | where_capture("IMPORT"; "^(libxmljs|libxmljs2)$"))) + (($all | of(["import $XML from '$IMPORT'\n$$$_", "import * as $XML from '$IMPORT'\n$$$_"]) | where_capture("IMPORT"; "^(libxmljs|libxmljs2)$"))))
          )
          | reaching(((($all | of(["$REQ.query", "$REQ.body", "$REQ.params", "$REQ.cookies", "$REQ.headers", "$REQ.files.$ANYTHING.data.toString('utf8')", "$REQ.files.$ANYTHING['data'].toString('utf8')"]))
          | within((($all | of(["function ($REQ, $RES) {$$$_}", "function $FUNC($REQ, $RES) {$$$_}", "function ($REQ, $RES, $NEXT) {$$$_}", "function $FUNC($REQ, $RES, $NEXT) {$$$_}"])))
          + ((($all | of(["$REQ.query", "$REQ.body", "$REQ.params", "$REQ.cookies", "$REQ.headers", "$REQ.files.$ANYTHING.data.toString('utf8')", "$REQ.files.$ANYTHING['data'].toString('utf8')"])) | within((($all | of(["$APP.$METHOD($$$_, function $FUNC($REQ, $RES) {$$$_})", "$APP.$METHOD($$$_, function $FUNC($REQ, $RES, $NEXT) {$$$_})"])) + ($all | of(["$APP.$METHOD($$$_, function ($REQ, $RES) {$$$_})", "$APP.$METHOD($$$_, function ($REQ, $RES, $NEXT) {$$$_})"])))) | where_capture("METHOD"; "^(get|post|put|head|delete|options)$")))))
              + (($all
          | within($all | of(["({ $REQ }: Request,$RES: Response, $NEXT: NextFunction) =>\n{$$$_}"])))
          + ($all
          | within($all | of(["({ $REQ }: Request,$RES: Response) => {$$$_}"])))
          | at_same_place(($all | of(["params","query","cookies","headers","body"])))
          | focus("REQ")));
              ([]))
        | finding("express-libxml-noent";
            "The libxml library processes user-input with the `noent` attribute is set to `true` which can lead to being vulnerable to XML External Entities (XXE) type attacks.") ) )
| report
