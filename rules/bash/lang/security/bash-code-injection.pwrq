# rules: bash-code-injection
# languages: bash
# fixture: bash/CWE-94b.sh
# from: CWE-94 Code Injection
#
# Repair: the rule also reported `source $VAR` and `. $VAR`, which is how a
# script loads its own config or a virtualenv - 251 findings, and only 4 of
# the 15 the audit judged were real. eval is the sink; sourcing the program's
# own file is not. It also absorbed bash-os-command, which reported the same
# `eval` with a variable under a second id.

. as $root
| ( ($root | scan_regex(["*.sh"]; [
      "eval\\s+\\$",
      "eval\\s+\"\\$",
      "eval\\s+'\\$",
      "eval\\s+\\$\\(",
      "eval\\s+\"\\$\\("
    ])) as $all
    | ( $all | of(["eval\\s+\\$","eval\\s+\"\\$","eval\\s+'\\$","eval\\s+\\$\\(","eval\\s+\"\\$\\("])
        | where_text_not("^eval\\s+\"[^\"]*\"\\s*$")
        | where_text_not("^eval\\s+'[^']*'\\s*$")
        | finding("bash-code-injection";
            "eval parses its argument as shell code, so a value that came from "
            + "outside runs as commands; do not eval input, or validate it "
            + "against a fixed list first") ) )
| report
