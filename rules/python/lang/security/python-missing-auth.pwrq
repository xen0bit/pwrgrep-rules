# rules: python-missing-auth
# languages: python
# fixture: python/CWE-306.py
# from: CWE-306 (Missing Authentication for Critical Function), CWE-287
#
# The rule reports an endpoint in a file that protects some of its others, and
# says nothing about a file that protects none. An application with no
# authentication anywhere has made a decision - the check may live in a filter,
# a gateway or a proxy, or it may be a sample with no accounts at all - and
# reporting every endpoint in it tells the reader nothing they did not know.
# What is a bug is the endpoint that was missed: a guard on three handlers and
# not on the fourth.
#
# There is one rule per language for this, and it reports under
# `<language>-missing-auth`. The corpus briefly carried two or three - an
# `-authn` spelling, an `-auth` spelling and this one - written against
# CWE-287, CWE-306 and CWE-862 but all asking the same question: is there an
# authentication guard on this endpoint. They fired on the same lines and a
# route with no middleware got three findings under three ids. Whether the
# missing guard is called authentication or authorization is not something the
# syntax says, so it is one finding; `<language>-862-rbac` is the separate rule
# for the endpoint that does authenticate and then checks no role.
#
# Flask/Django views that are reachable via @app.route or @router without
# @login_required or @auth_required allow unauthenticated access to
# sensitive operations. The rule finds route handlers that lack an
# authentication decorator; ok cases wrap the view with @login_required.

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "@$APP.route($$$_)\ndef $FUNC($$$_):\n  $$$BODY",
      "@app.route($$$_)\ndef $FUNC($$$_):\n  $$$BODY",
      "@bp.route($$$_)\ndef $FUNC($$$_):\n  $$$BODY",
      "@router.get($$$_)\ndef $FUNC($$$_):\n  $$$BODY",
      "@router.post($$$_)\ndef $FUNC($$$_):\n  $$$BODY",
      "@login_required\ndef $FUNC($$$_):\n  $$$BODY",
      "@login_required($$$_)\ndef $FUNC($$$_):\n  $$$BODY",
      "@auth_required\ndef $FUNC($$$_):\n  $$$BODY",
      "@django.contrib.auth.decorators.login_required\ndef $FUNC($$$_):\n  $$$BODY",
      "@django.contrib.auth.decorators.login_required($$$_)\ndef $FUNC($$$_):\n  $$$BODY"
    ])) as $all
    | ( $all | of(["@$APP.route($$$_)\ndef $FUNC($$$_):\n  $$$BODY","@app.route($$$_)\ndef $FUNC($$$_):\n  $$$BODY","@bp.route($$$_)\ndef $FUNC($$$_):\n  $$$BODY","@router.get($$$_)\ndef $FUNC($$$_):\n  $$$BODY","@router.post($$$_)\ndef $FUNC($$$_):\n  $$$BODY"])
          | outside($all | of(["@login_required\ndef $FUNC($$$_):\n  $$$BODY","@login_required($$$_)\ndef $FUNC($$$_):\n  $$$BODY","@auth_required\ndef $FUNC($$$_):\n  $$$BODY","@django.contrib.auth.decorators.login_required\ndef $FUNC($$$_):\n  $$$BODY","@django.contrib.auth.decorators.login_required($$$_)\ndef $FUNC($$$_):\n  $$$BODY"]))
          | in_files_with($all | of(["@login_required\ndef $FUNC($$$_):\n  $$$BODY","@login_required($$$_)\ndef $FUNC($$$_):\n  $$$BODY","@auth_required\ndef $FUNC($$$_):\n  $$$BODY","@django.contrib.auth.decorators.login_required\ndef $FUNC($$$_):\n  $$$BODY","@django.contrib.auth.decorators.login_required($$$_)\ndef $FUNC($$$_):\n  $$$BODY"]))
        | finding("python-missing-auth";
            "Route handler $FUNC lacks authentication; add @login_required or equivalent to enforce access control") ) )
| report
