# rules: ssrf
# languages: c_sharp
# fixture: csharp/web-request.cs
# from: csharp/lang/security/ssrf/web-request.yaml
#
# As in http-client: the whole-method shapes match nothing, so the created
# URL is a hole the method parameter reaches.

["public $T $M($U $A) { $$$BODY }"] as $methods
| ["WebRequest.Create($U);", "WebRequest.Create($U, $$$);"] as $sinks
| ["using System.Net;"] as $using
| scan_ast("*.cs"; $methods + $sinks + $using) as $all
| ( ($all | of($sinks) | focus("U"))
      | reaching((($all | of($methods) | focus("A"))); ([]))
      | in_files_with($all | of($using))
    | finding("ssrf";
        "The web server receives a URL or similar request from an upstream component and retrieves the contents of this URL, but it does not sufficiently ensure that the request is being sent to the expected destination.") )
| report
