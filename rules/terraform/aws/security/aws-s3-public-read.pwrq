# rules: aws-s3-public-read
# languages: hcl
# fixture: terraform/aws-s3-public-read.tf
# from: CWE-732 (Incorrect Permission Assignment for Critical Resource)
#
# S3 bucket ACL public-read allows anyone to read the bucket — second spell using aws_s3_bucket.

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"aws_s3_bucket\" $NAME {\n  $$$_\n  acl = \"public-read\"\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["resource \"aws_s3_bucket\" $NAME {\n  $$$_\n  acl = \"public-read\"\n  $$$_\n}"])
        | finding("aws-s3-public-read";
            "S3 bucket ACL public-read allows public read access — restrict to private.") ) )
| report
