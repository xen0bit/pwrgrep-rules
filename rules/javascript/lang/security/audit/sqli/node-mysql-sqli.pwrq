# rules: node-mysql-sqli
# languages: javascript, typescript
# fixture: javascript/node-mysql-sqli.js
# from: javascript/lang/security/audit/sqli/node-mysql-sqli.yaml
#
# Repair: `within(require...)` confined matches to the require span, `at_same_place` needed exact coincidence, and the `function $$$` wrappers never matched. Sinks are selected first with file-level gates and sources cover anon/named declarations and arrows. Globs cover *.js as well as *.ts.

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$POOL.execute($QUERY, $$$_)",
      "$POOL.query($QUERY, $$$_)",
      "$X = require('$IMPORT')",
      "($$$_, $Y, $$$_) => {$$$_}",
      "($Y) => {$$$_}",
      "const $X = require('$IMPORT')",
      "function $F($$$_, $Y, $$$_) {$$$_}",
      "function ($$$_, $Y, $$$_) {$$$_}",
      "import $X from '$IMPORT'",
      "import * as $X from '$IMPORT'",
      "parseInt($$$_)"
    ])) as $all
    | ( (($all | of(["$POOL.query($QUERY, $$$_)", "$POOL.execute($QUERY, $$$_)"])
          | focus("QUERY"))
          | in_files_with((($all | of(["$X = require('$IMPORT')", "const $X = require('$IMPORT')", "import $X from '$IMPORT'", "import * as $X from '$IMPORT'"]) | where_capture("IMPORT"; "^(mysql|mysql2)$"))))
          | reaching(((($all | of(["function ($$$_, $Y, $$$_) {$$$_}", "function $F($$$_, $Y, $$$_) {$$$_}"]))
          + ($all | of(["($Y) => {$$$_}", "($$$_, $Y, $$$_) => {$$$_}"]))
          | focus("Y")));
              ($all | of(["parseInt($$$_)"])))
        | finding("node-mysql-sqli";
            "Detected a mysql SQL statement that comes from a function argument.") ) ))
| report
