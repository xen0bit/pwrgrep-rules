<?xml version="1.0" encoding="utf-8"?>
<!-- net-webconfig-debug: debug="true" ships symbol-rich error pages to
     clients. Compile debug="false" for production. -->
<configuration>
  <system.web>
    <!-- ruleid: net-webconfig-debug -->
    <compilation debug="true" targetFramework="4.8" />
  </system.web>
</configuration>
<configuration>
  <system.web>
    <!-- ok: net-webconfig-debug -->
    <compilation debug="false" targetFramework="4.8" />
  </system.web>
</configuration>
