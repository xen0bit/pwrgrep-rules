# rules: compound-sweeptoken-not-restricted
# languages: solidity
# fixture: solidity/compound-sweeptoken-not-restricted.sol
#
# Fragments, gaps and modifier holes never match in the solidity grammar, so
# no form fired. Rewritten as a regex over the sweepToken header: the
# modifier text is captured and access-controlled spellings excluded, while
# the admin-require check stays file-level. A file carrying the require
# suppresses every finding, so the fixed form cannot share a fixture file.
# from: solidity/security/compound-sweeptoken-not-restricted.yaml

. as $root
| ( ($root | scan_regex(["*.sol"]; [
      "function\\s+sweepToken\\s*\\([^)]*\\)\\s*(?P<M>[^{]*?)\\{",
      "token\\.transfer\\s*\\(",
      "require\\s*\\(\\s*(?:msg\\.sender|_msgSender\\s*\\(\\s*\\))\\s*==\\s*admin"
    ])) as $all
    | ( $all | of(["function\\s+sweepToken\\s*\\([^)]*\\)\\s*(?P<M>[^{]*?)\\{"])
          | where_capture_not("M"; "only|admin|owner|private|internal")
          | in_files_with($all | of(["token\\.transfer\\s*\\("]))
          | in_files_without($all | of(["require\\s*\\(\\s*(?:msg\\.sender|_msgSender\\s*\\(\\s*\\))\\s*==\\s*admin"]))
        | finding("compound-sweeptoken-not-restricted";
            "Function sweepToken is allowed to be called by anyone") ) )
| report
