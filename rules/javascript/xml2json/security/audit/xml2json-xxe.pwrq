# rules: xml2json-xxe
# languages: javascript, typescript
# fixture: javascript/xml2json-xxe.js
# from: javascript/xml2json/security/audit/xml2json-xxe.yaml
#
# Repair: the `var`-only statement-sequence shapes never matched `const` declarations or other scopes. Sinks are selected first with file-level gates and function-argument sources.

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "($$$_, $FUNC, $$$_) => {$$$_}",
      "($FUNC) => {$$$_}",
      "$PARSER.toJson($DATA)",
      "$PARSER.toJson($DATA, $OPTS)",
      "var $XML = require('xml2json')",
      "const $XML = require('xml2json')",
      "child_process.exec($CMD, $$$_)",
      "child_process.execSync($CMD, $$$_)",
      "child_process.spawn($CMD, $$$_)",
      "child_process.spawnSync($CMD, $$$_)",
      "const $XML = require('xml2json')",
      "function ($$$_, $FUNC, $$$_) {$$$_}",
      "function $F($$$_, $FUNC, $$$_) {$$$_}",
      "import $CP from 'child_process'\n$$$",
      "import * as $CP from 'child_process'\n$$$",
      "let $CP = require('child_process')",
      "var $CP = require('child_process')",
      "var $XML = require('xml2json')"
    ])) as $all
    | ( (($all | of(["$PARSER.toJson($DATA)", "$PARSER.toJson($DATA, $OPTS)"])
          | not_at(($all | of(["$PARSER.toJson($DATA)", "$PARSER.toJson($DATA, $OPTS)"]) | where_capture("DATA"; "^[\"'].*[\"']$")))
          | focus("DATA"))
          | in_files_with(($all | of(["var $XML = require('xml2json')", "const $XML = require('xml2json')"])) + ($all | of([])))
          | reaching(((($all | of(["function ($$$_, $FUNC, $$$_) {$$$_}","function $F($$$_, $FUNC, $$$_) {$$$_}"]))
          + ($all | of(["($FUNC) => {$$$_}","($$$_, $FUNC, $$$_) => {$$$_}"]))
          | focus("FUNC")));
              ([]))
        | finding("xml2json-xxe";
            "If unverified user data can reach the XML Parser it can result in XML External or Internal Entity (XXE) Processing vulnerabilities") ) ))
| report
