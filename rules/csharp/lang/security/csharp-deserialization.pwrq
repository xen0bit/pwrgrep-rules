# rules: csharp-deserialization
# languages: c_sharp
# fixture: csharp/CWE-502.cs
# from: CWE-502 (Deserialization of Untrusted Data)

["$T $V = $S;"] as $assigned
| ["public $T $M($$$_, string $P, $$$_) { $$$_ }",
   "public $T $M(string $P) { $$$_ }"] as $bound
| ["using Microsoft.AspNetCore.Mvc;", "using System.Web.Mvc;",
   "using System.Web.Http;", "using Microsoft.AspNetCore.Components;"] as $mvcImports
| ["class $C : $B { $$$_ }"] as $classes
| ["$F.Deserialize($STREAM);", "$F.Deserialize($STREAM, $$$_);",
   "JsonConvert.DeserializeObject($DATA);", "JsonConvert.DeserializeObject($DATA, $$$_);",
   "JsonConvert.DeserializeObject<$T>($DATA);", "JsonConvert.DeserializeObject<$T>($DATA, $$$_);"] as $sinks
| "Request\\s*\\.\\s*(Query|Form|Headers|Cookies|QueryString|Params|RouteValues|Body|InputStream)\\b" as $fromRequest
| scan_ast("*.cs"; $assigned + $bound + $mvcImports + $classes + $sinks) as $all
| ( ($all | of($assigned) | where_capture("S"; $fromRequest) | focus("S"))
    + ($all | of($bound) | focus("P")
       | in_files_with( ($all | of($mvcImports))
                        + ($all | of($classes) | where_capture("B"; "Controller")) )) ) as $untrusted
| ( ($all | of(["$F.Deserialize($STREAM);", "$F.Deserialize($STREAM, $$$_);"]) | focus("STREAM"))
    + ($all | of(["JsonConvert.DeserializeObject($DATA);", "JsonConvert.DeserializeObject($DATA, $$$_);",
                  "JsonConvert.DeserializeObject<$T>($DATA);", "JsonConvert.DeserializeObject<$T>($DATA, $$$_);"]) | focus("DATA")) )
| reaching($untrusted; [])
| finding("csharp-deserialization";
    "this deserializes data from the request; a caller who controls it chooses which object is built")
| report
