# rules: clojure-ssrf
# languages: clojure
# fixture: clojure/CWE-918.clj
# from: CWE-918 SSRF

["(slurp $URL)", "(clojure.java.io/reader $URL)", "(http/get $URL)"] as $sinks
| scan_ast(["*.clj"]; $sinks) as $all
| ($all | of($sinks) | where_capture_not("URL"; "^\".*\"$") | finding("clojure-ssrf";
        "the destination of this request is a value the caller chose, so it can "
        + "be pointed at the metadata service or anything else this host can "
        + "reach; check it against the hosts you meant to allow"))
| report
