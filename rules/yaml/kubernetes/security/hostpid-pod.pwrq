# rules: hostpid-pod
# languages: yaml
# fixture: yaml/k8s-hostpid.yaml
# from: yaml/kubernetes/security/hostpid-pod.yaml

. as $root
| ( ($root | scan_ast(["*.yaml","*.yml"]; [
      "hostPID: true"
    ])) as $all
    | ( $all | of(["hostPID: true"])
        | finding("hostpid-pod";
            "Pod is sharing the host process ID namespace.") ) )
| report
