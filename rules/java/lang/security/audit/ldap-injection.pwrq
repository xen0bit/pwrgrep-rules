# rules: ldap-injection
# languages: java
# fixture: java/ldap-injection.java
# from: java/lang/security/audit/ldap-injection.yaml
#
# Every shape was a method scaffold with statement gaps that match nothing,
# so the rule never fired. The finding is the search call itself now, kept
# when its filter is not a literal.

. as $root
| ( ($root | scan_ast(["*.java"]; [
      "$CTX.search($BASE, $FILTER)",
      "$CTX.search($BASE, $FILTER, $CONTROLS)"
    ])) as $all
    | ( $all | of(["$CTX.search($BASE, $FILTER)","$CTX.search($BASE, $FILTER, $CONTROLS)"])
          | where_capture_not("FILTER"; "^\"[^\"]*\"$")
        | finding("ldap-injection";
            "Detected non-constant data passed into an LDAP query.") ) )
| report
