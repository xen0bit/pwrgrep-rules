# rules: spawn-git-clone
# languages: javascript, typescript
# fixture: javascript/spawn-git-clone.js
# from: javascript/lang/security/spawn-git-clone.yaml
#
# The all-literal exclusions read their holes as any argument and
# subtracted every call. The finding keeps only non-literal URLs now.

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$X.spawn('git', ['clone',$$$_,$F])",
      "$X.spawn('git', ['clone',$$$_,$P,$F])",
      "spawn('git', ['clone',$$$_,$F])",
      "spawn('git', ['clone',$$$_,$P,$F])"
    ])) as $all
    | ( $all | of(["spawn('git', ['clone',$$$_,$F])","$X.spawn('git', ['clone',$$$_,$F])","spawn('git', ['clone',$$$_,$P,$F])","$X.spawn('git', ['clone',$$$_,$P,$F])"])
          | where_capture_not("F"; "^\".*\"$|^'.*'$")
          | where_capture_not("P"; "^\".*\"$|^'.*'$")
        | finding("spawn-git-clone";
            "Git allows shell commands to be specified in ext URLs for remote repositories.") ) )
| report