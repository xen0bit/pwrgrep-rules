# rules: detected-heroku-api-key2
# fixture: generic/detected-heroku-api-key2.txt
# from: generic/secrets/security/detected-heroku-api-key.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "heroku_(?P<SECRET>[A-Za-z0-9_\\-]{20,})"
    ])) as $all
    | ( $all | of(["heroku_(?P<SECRET>[A-Za-z0-9_\\-]{20,})"])
          | where_capture_entropy("SECRET")
        | finding("detected-heroku-api-key2";
        "this is a heroku api key written into the source, so it is in every checkout "
        + "and every image built from one; read it from the environment, and "
        + "rotate this one because it has leaked") ) )
| report
