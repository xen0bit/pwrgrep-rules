# rules: playwright-evaluate-code-injection
# languages: javascript, typescript
# fixture: javascript/playwright-evaluate-code-injection.js
# from: javascript/playwright/security/audit/playwright-evaluate-code-injection.yaml
#
# The require gate trailed a statement gap that matches nothing, so no file
# ever qualified. The literal and function exclusions read two-slot shapes
# that subtracted every call; the finding keeps only inputs that are
# neither.

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$PAGE.evaluate($INPUT,$$$_)",
      "$PAGE.evaluateHandle($INPUT,$$$_)",
      "$PAGE.evaluateOnNewDocument($INPUT,$$$_)",
      "require('playwright')",
      "var $INPUT = function $FNAME($$$_){$$$_};\n$$$_"
    ])) as $all
    | ( $all | of(["$PAGE.evaluate($INPUT,$$$_)","$PAGE.evaluateHandle($INPUT,$$$_)","$PAGE.evaluateOnNewDocument($INPUT,$$$_)"])
          | in_files_with($all | of(["require('playwright')"]))
          | in_files_without($all | of(["var $INPUT = function $FNAME($$$_){$$$_};\n$$$_"]))
          | where_capture_not("INPUT"; "^[\"']")
          | where_capture_not("INPUT"; "^function\\b")
          | where_capture_not("INPUT"; "^\\(")
        | finding("playwright-evaluate-code-injection";
            "If unverified user data can reach the `evaluate` method it can result in Server-Side Request Forgery vulnerabilities") ) )
| report
