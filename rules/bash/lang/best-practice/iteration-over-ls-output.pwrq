# rules: iteration-over-ls-output
# languages: bash
# fixture: bash/CWE-22.sh
# from: bash/lang/best-practice/iteration-over-ls-output.yaml

. as $root
| ( ($root | scan_regex(["*.sh"]; [
      "\\$\\(ls"
    ])) as $all
    | ( $all | of(["\\$\\(ls"])
        | finding("iteration-over-ls-output";
            "Iterating over ls output is fragile.") ) )
| report
