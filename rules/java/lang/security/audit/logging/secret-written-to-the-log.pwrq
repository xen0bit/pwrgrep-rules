# rules: java-secret-written-to-the-log
# languages: java
# fixture: java/CWE-532.java
# from: CWE-532 (Insertion of Sensitive Information into Log File), CWE-215
#
# A log line goes somewhere with different rules from the process that wrote
# it: a file that ends up world-readable, a shipper forwarding it to a search
# cluster the whole company can query, a support bundle attached to a ticket.
# A password written into one has left the boundary the program was keeping it
# inside - and unlike a leak through a response it is retained, indexed and
# backed up.
#
# The one thing that separates a finding from a careful log line is whether
# the secret-ish word names the *value* or the *subject*.
# `log.info("password changed for " + user)` says a password exists;
# `log.info("with password " + password)` prints one. Both are concatenations
# containing the word, so "is it entirely a literal" does not separate them
# and the first version of this rule reported the careful one.
#
# What does separate them is what follows the word. An identifier ends at the
# end of the argument or at a `+`, a `.`, a `,`, a `)` or a `(`; a word inside
# a sentence is followed by a space and more sentence, and a word that closes
# a literal is followed by a quote. So `$secretValue` is the word list with
# that terminator spliced on, and `$sensitive` - the loose version - is kept
# for the format string, where naming the subject is the whole point.
#
# The words are written out qualified rather than bare, which the Go pass
# learned the expensive way: `token` on its own matches a lexer's tokens and
# a CSRF token's *name* and reports a compiler. `access_token`, `bearer` and
# `client_secret` are what people actually call the thing.
#
# The slf4j placeholder form is a separate reading and asks for a secret-ish
# word on *both* sides, because `log.info("password reset for {}", user)` and
# `log.info("password {}", pw)` are the same shape and only one of them is a
# finding. That costs the case where the message says nothing and the value is
# the secret - `log.info("{}", pw)` - which is rarer than either.
#
# `System.out` and `System.err` are included because in a program that has a
# logger they are the spelling somebody used while debugging and then left in.

( "passw(or)?d|passwd|secret|private[_.-]?key|credential|api[_.-]?key|"
  + "apikey|access[_.-]?token|refresh[_.-]?token|auth[_.-]?token|"
  + "bearer|client[_.-]?secret|session[_.-]?key" ) as $words
| ("(?i)" + $words) as $sensitive
| ("(?i)(?:" + $words + ")(?:\\s*[-+.,)\\];]|\\(|$)") as $secretValue
| "(?i)encoder|policy|passwordless|prompt|placeholder|\\.length|isEmpty|"
  + "(?i)mask|redact|\\*\\*\\*" as $aboutIt
| "^\"[^\"]*\"$" as $wholeLiteral
| "(?i)log|(?i)^out$|(?i)^err$|System\\.out|System\\.err|(?i)printer|(?i)console" as $logish
| ["trace", "debug", "info", "warn", "error", "fatal", "println", "print"] as $levels
| ($levels | map("$LOG." + . + "($M)")) as $oneArg
| ($levels | map("$LOG." + . + "($FMT, $M)")) as $formatted
| scan_ast("*.java"; $oneArg + $formatted) as $all
| ( ($all | of($oneArg))
    + ($all | of($formatted) | where_capture("FMT"; $sensitive)) )
| where_capture("LOG"; $logish)
| where_capture("M"; $secretValue)
| where_capture_not("M"; $wholeLiteral)
| where_capture_not("M"; $aboutIt)
| focus("M")
| finding("java-secret-written-to-the-log";
    "this writes the secret itself into the log, where it is retained, "
    + "indexed and backed up under whatever rules the log file has")
| report
