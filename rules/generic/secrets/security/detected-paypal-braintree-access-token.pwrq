# rules: detected-paypal-braintree-access-token
# fixture: generic/detected-paypal-braintree-access-token.txt
# from: generic/secrets/security/detected-paypal-braintree-access-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "access_token\\$production\\$[0-9a-z]{16}\\$[0-9a-z]{32}"
    ])) as $all
    | ( $all | of(["access_token\\$production\\$[0-9a-z]{16}\\$[0-9a-z]{32}"])
        | finding("detected-paypal-braintree-access-token";
        "this is a paypal braintree access token written into the source, so it is in every checkout "
        + "and every image built from one; read it from the environment, and "
        + "rotate this one because it has leaked") ) )
| report
