# rules: missing-integrity
# languages: html
# fixture: html/missing-integrity.html
# from: html/security/audit/missing-integrity.yaml
#
# The `src` has to be there and it has to be absolute. Subresource integrity is
# a check on a resource fetched from somewhere else: an inline `<script>` has
# nothing to hash, and a relative `src` is served by the same origin as the
# page, which is already as trusted as the page is. A rule written as
# `<script[^>]*>` reports both, and over a template directory that is almost
# every script tag there is.
#
# A stylesheet is the other half. `<link rel="stylesheet" href="https://...">`
# takes an `integrity` attribute for the same reason and was in this rule
# before, so it is here again.

. as $root
| ( ($root | scan_regex(["*.html"]; [
      "<script[^>]*\\ssrc\\s*=\\s*[\"']https?://[^>]*>",
      "<link[^>]*\\shref\\s*=\\s*[\"']https?://[^>]*>",
      "<script[^>]*integrity[^>]*>",
      "<link[^>]*integrity[^>]*>"
    ])) as $all
    | ( $all | of(["<script[^>]*\\ssrc\\s*=\\s*[\"']https?://[^>]*>","<link[^>]*\\shref\\s*=\\s*[\"']https?://[^>]*>"])
          | not_at($all | of(["<script[^>]*integrity[^>]*>","<link[^>]*integrity[^>]*>"]))
        | finding("missing-integrity";
            "This tag is missing an 'integrity' subresource integrity attribute.") ) )
| report
