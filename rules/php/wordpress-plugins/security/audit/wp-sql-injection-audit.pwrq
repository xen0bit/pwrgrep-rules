# rules: wp-sql-injection-audit
# languages: php
# fixture: php/wp-sql-injection-audit.php
#
# Anonymous holes in call patterns are read as inline HTML text instead
# of code, so the rule never fired. Rewritten with named holes (the eval-use
# shape); see GUIDE.md.
# from: php/wordpress-plugins/security/audit/wp-sql-injection-audit.yaml

. as $root
| ( ($root | scan_ast(["*.php"]; [
      "$wpdb->delete($Q,$$$_)",
      "$wpdb->get_col($Q,$$$_)",
      "$wpdb->get_results($Q,$$$_)",
      "$wpdb->get_row($Q,$$$_)",
      "$wpdb->get_var($Q,$$$_)",
      "$wpdb->insert($Q,$$$_)",
      "$wpdb->prepare($Q,$$$_)",
      "$wpdb->query($Q,$$$_)",
      "$wpdb->replace($Q,$$$_)",
      "$wpdb->update($Q,$$$_)"
    ])) as $all
    | ( $all | of(["$wpdb->query($Q,$$$_)", "$wpdb->get_var($Q,$$$_)", "$wpdb->get_row($Q,$$$_)", "$wpdb->get_col($Q,$$$_)", "$wpdb->get_results($Q,$$$_)", "$wpdb->replace($Q,$$$_)"])
          | not_at($all | of(["$wpdb->prepare($Q,$$$_)"]))
          | not_at($all | of(["$wpdb->delete($Q,$$$_)"]))
          | not_at($all | of(["$wpdb->update($Q,$$$_)"]))
          | not_at($all | of(["$wpdb->insert($Q,$$$_)"]))
        | finding("wp-sql-injection-audit";
            "Detected unsafe API methods.") ) )
| report
