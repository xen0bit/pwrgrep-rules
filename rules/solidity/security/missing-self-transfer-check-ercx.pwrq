# rules: missing-self-transfer-check-ercx
# languages: solidity
# fixture: solidity/missing-self-transfer-check-ercx.sol
#
# Fragments, gaps and contract-level AST never match in the solidity grammar,
# so no form fired. Rewritten as a regex over balance writes outside a
# from!=to guard block. Guard blocks use a brace-depth shape without nesting;
# fixture guards keep flat bodies.
# from: solidity/security/missing-self-transfer-check-ercx.yaml

. as $root
| ( ($root | scan_regex(["*.sol"]; [
      "_balances\\s*\\[[^\\]\n]+\\]\\s*=[^=]",
      "if\\s*\\(\\s*from\\s*!=\\s*to\\s*\\)\\s*\\{[^}]*\\}"
    ])) as $all
    | ( $all | of(["_balances\\s*\\[[^\\]\n]+\\]\\s*=[^=]"])
          | outside($all | of(["if\\s*\\(\\s*from\\s*!=\\s*to\\s*\\)\\s*\\{[^}]*\\}"]))
        | finding("missing-self-transfer-check-ercx";
            "Missing check for 'from' and 'to' being the same before updating balances could lead to incorrect balance manipulation on self-transfers.") ) )
| report
