# rules: detected-datadog-token
# languages:
# fixture: generic/detected-datadog-token.txt
# from: CWE-798 (Use of Hard-coded Credentials)
#
# Datadog token hardcoded.

. as $root
| ( ($root | scan_regex(["*"]; [
      "datadog_(?P<SECRET>[A-Za-z0-9_\\-]{20,})"
    ])) as $all
    | ( $all | of(["datadog_(?P<SECRET>[A-Za-z0-9_\\-]{20,})"])
          | where_capture_entropy("SECRET")
        | finding("detected-datadog-token";
        "this is a datadog token written into the source, so it is in every checkout "
        + "and every image built from one; read it from the environment, and "
        + "rotate this one because it has leaked") ) )
| report
