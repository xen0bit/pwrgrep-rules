# rules: puppeteer-exposed-chrome-devtools
# languages: javascript, typescript
# fixture: javascript/puppeteer-exposed-chrome-devtools.js
# from: javascript/puppeteer/security/audit/puppeteer-exposed-chrome-devtools.yaml
#
# Repair: dead as written. `where_text` filtered the `require` matches
# themselves, whose text never contains a debugging flag. The flags are now
# matched as regexes over the file and gated on the `puppeteer` require.

. as $root
| (($root | scan_regex(["*.js","*.ts"]; [
      "--remote-debugging-address",
      "--remote-debugging-port",
      "--remote-debugging-socket-name",
      "--remote-debugging-targets"
    ])) as $flags | (($root | scan_ast(["*.js","*.ts"]; [
      "$P = require('puppeteer')\n$$$",
      "const $P = require('puppeteer')",
      "require('puppeteer')"
    ])) as $all | ($flags
      | in_files_with(($all | of(["require('puppeteer')"]) + ($all | of(["const $P = require('puppeteer')"])) + ($all | of(["$P = require('puppeteer')\n$$$"]))))
      | finding("puppeteer-exposed-chrome-devtools";
          "Remote debugging protocol does not perform any authentication, so exposing it too widely can be a security risk."))))
| report
