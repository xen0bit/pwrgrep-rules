# rules: ocamllint-unsafe
# languages: ocaml
# fixture: ocaml/ocamllint-unsafe.ml
# from: ocaml/lang/security/unsafe.yaml

. as $root
| ( ($root | scan_ast(["*.ml"]; [
      "Array.$F",
      "Bytes.$F",
      "String.$F"
    ])) as $all
    | ( $all | of(["Array.$F","Bytes.$F","String.$F"])
          | where_capture("F"; "^unsafe_")
        | finding("ocamllint-unsafe";
            "Unsafe functions do not perform boundary checks or have other side effects, use with care.") ) )
| report
