# rules: azure-monitor-log-profile-retention-days
# languages: hcl
# fixture: terraform/azure-monitor-log-profile-retention-days-security.tf
#
# The translated rule filtered `of(["resource"])` — bare-keyword matches that bind no $DAYS — and then compared it, so the comparison saw no hole and the rule was empty (the `at_same_place` against the block could never coincide either). The finding base is now the dated block reading itself, minus the compliant spelling.
# from: terraform/azure/security/azure-monitor-log-profile-retention-days.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"azurerm_monitor_log_profile\" \"$$$_\" {\n$$$_\nretention_policy {\n$$$_\nenabled = true\ndays = $DAYS\n$$$_\n}\n$$$_\n}",
      "resource \"azurerm_monitor_log_profile\" \"$$$_\" {\n$$$_\nretention_policy {\n$$$_\nenabled = false\ndays = 0\n$$$_\n}\n$$$_\n}"
    ])) as $all
    | ( ($all | of(["resource \"azurerm_monitor_log_profile\" \"$$$_\" {\n$$$_\nretention_policy {\n$$$_\nenabled = true\ndays = $DAYS\n$$$_\n}\n$$$_\n}"])
        | outside($all | of(["resource \"azurerm_monitor_log_profile\" \"$$$_\" {\n$$$_\nretention_policy {\n$$$_\nenabled = false\ndays = 0\n$$$_\n}\n$$$_\n}"]))
        | where_capture_compare("$DAYS < 365"))
        | finding("azure-monitor-log-profile-retention-days";
            "Ensure that Activity Log Retention is set 365 days or greater") ) )
| report
