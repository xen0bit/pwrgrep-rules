# rules: scala-dangerous-process-run
# languages: scala
# fixture: scala/CWE-78.scala
# from: scala/lang/security/audit/scala-dangerous-process-run.yaml

["$R.getParameter($$$_)", "$R.getHeader($$$_)", "$R.getQueryString()", "$R.getParameterValues($$$_)"] as $src
| ["Seq($CMD, $$$_).!", "Seq($CMD, $$$_).!!", "Seq($CMD, $$$_).lazyLines"] as $sink
| scan_ast("*.scala"; $src + $sink) as $all
| ( $all | of($sink) | focus("CMD") | reaching($all | of($src); []) | finding("scala-dangerous-process-run"; "Command injection: $CMD came from the request and reaches OS execution") )
| report
