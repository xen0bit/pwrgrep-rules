# rules: puppeteer-evaluate-code-injection
# languages: javascript, typescript
# fixture: javascript/puppeteer-evaluate-code-injection.js
# from: javascript/puppeteer/security/audit/puppeteer-evaluate-code-injection.yaml
#
# The require gate trailed a statement gap that matches nothing, and the
# literal and function exclusions read shapes that subtracted every call.
# The gate is bare now and the finding keeps only other inputs.

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$PAGE.evaluate($INPUT,$$$_)",
      "$PAGE.evaluateHandle($INPUT,$$$_)",
      "$PAGE.evaluateOnNewDocument($INPUT,$$$_)",
      "require('puppeteer')",
      "var $INPUT = function $FNAME($$$_){$$$_};\n$$$_"
    ])) as $all
    | ( $all | of(["$PAGE.evaluate($INPUT,$$$_)","$PAGE.evaluateHandle($INPUT,$$$_)","$PAGE.evaluateOnNewDocument($INPUT,$$$_)"])
          | in_files_with($all | of(["require('puppeteer')"]))
          | in_files_without($all | of(["var $INPUT = function $FNAME($$$_){$$$_};\n$$$_"]))
          | where_capture_not("INPUT"; "^[\"']")
          | where_capture_not("INPUT"; "^function\\b")
          | where_capture_not("INPUT"; "^\\(")
        | finding("puppeteer-evaluate-code-injection";
            "If unverified user data can reach the `evaluate` method it can result in Server-Side Request Forgery vulnerabilities") ) )
| report
