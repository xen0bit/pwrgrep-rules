# rules: python-hardcoded-credential
# languages: python
# fixture: python/CWE-798.py
# from: CWE-798 (Use of Hard-coded Credentials), CWE-259
#
# A secret literal written into the source is in every checkout, every image
# and every log. The name is what makes it checkable — nothing about
# "hunter2" says it is a password, the identifier beside it does.
#
# Repair: a name that merely contains "token" or "key" is not a credential,
# and neither is a URL or a fill-me-in placeholder. `token_url = "https://..."`
# and `os.environ["OPENAI_API_KEY"] = "your_openai_api_key"` were reported;
# the value is now required not to be a URL scheme or a placeholder.

["$VAR = $VALUE"] as $assign
| "(?i)password|passwd|pwd|secret|api_?key|apikey|token" as $names
| "(?i)_(url|uri|endpoint|host|path|dir|name|type|method|scheme|format|prefix|suffix|header|grant|mode)$" as $notNames
| "^[\"'][^\"']{3,}[\"']$" as $literal
| "(?i)^[\"'](?:https?|ftp|ftps|ssh|postgres|postgresql|mysql|mariadb|mongodb|redis|amqp|kafka)://" as $url
| "(?i)^[\"'][^\"']*(?:your_|_your|_here|_goes_here|placeholder|changeme|change_me|dummy|sample|replace_?me|insert_?|fill_?in|redacted|xxxx|\\.\\.\\.)[^\"']*[\"']$" as $placeholder
| scan_ast("*.py"; $assign) as $all
| ($all | of($assign)
    | where_capture("VAR"; $names)
    | where_capture_not("VAR"; $notNames)
    | where_capture("VALUE"; $literal)
    | where_capture_not("VALUE"; "^[\"']\\s*[\"']$")
    | where_capture_not("VALUE"; $url)
    | where_capture_not("VALUE"; $placeholder)
    | finding("python-hardcoded-credential";
        "hardcoded credential; it is in every checkout and cannot be rotated "
        + "without a release — read it from the environment or a vault"))
| report
