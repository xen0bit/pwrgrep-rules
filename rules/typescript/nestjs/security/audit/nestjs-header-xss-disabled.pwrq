# rules: nestjs-header-xss-disabled
# languages: typescript
# fixture: typescript/nestjs-header-xss-disabled.ts
# from: typescript/nestjs/security/audit/nestjs-header-xss-disabled.yaml
#
# As in nestjs-header-cors-any, the header is named literally (`=~/.../`
# matches as text) and the body is `$$$BODY` (`$$$` alone is a statement named
# `$$$`). The translated gaps around the method are dropped: an ellipsis
# beside a method in a class body is refused, so only single-method classes
# match.

. as $root
| ( ($root | scan_ast(["*.ts"]; [
      "class $CN {\n    @Header(\"X-XSS-Protection\", '0')\n    $FN($$$_) {\n        $$$BODY\n    }\n}"
    ])) as $all
    | ( $all | of(["class $CN {\n    @Header(\"X-XSS-Protection\", '0')\n    $FN($$$_) {\n        $$$BODY\n    }\n}"])
        | finding("nestjs-header-xss-disabled";
            "X-XSS-Protection header is set to 0.") ) )
| report
