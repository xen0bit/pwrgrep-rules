# rules: detect-child-process
# languages: javascript, typescript
# fixture: javascript/detect-child-process.js
# from: javascript/lang/security/detect-child-process.yaml
#
# Repair: dead as written. The file gates fed require matches into
# `at_same_place`, but a require span never coincides with a call;
# `in_files_without("$CMD = ...")` dropped every file containing a string;
# the literal-argument exclusions read their holes as any value; bare
# `$X = require()` missed const/let/var; and the `function $$$` wrappers
# never matched. Sinks are selected first with file-level gates, the literal
# exclusion keeps only quoted text, and sources cover anon/named declarations
# and arrows.

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "($$$_, $FUNC, $$$_) => {$$$_}",
      "($FUNC) => {$$$_}",
      "$CP.exec($CMD, $$$_)",
      "$CP.execSync($CMD, $$$_)",
      "$CP.spawn($CMD, $$$_)",
      "$CP.spawnSync($CMD, $$$_)",
      "child_process.exec($CMD, $$$_)",
      "child_process.execSync($CMD, $$$_)",
      "child_process.spawn($CMD, $$$_)",
      "child_process.spawnSync($CMD, $$$_)",
      "const $CP = require('child_process')",
      "function ($$$_, $FUNC, $$$_) {$$$_}",
      "function $F($$$_, $FUNC, $$$_) {$$$_}",
      "import $CP from 'child_process'\n$$$",
      "import * as $CP from 'child_process'\n$$$",
      "let $CP = require('child_process')",
      "var $CP = require('child_process')",
      "$CP = require('child_process')\n$$$"
    ])) as $all
    | ( (($all | of(["$CP.exec($CMD, $$$_)","$CP.execSync($CMD, $$$_)","$CP.spawn($CMD, $$$_)","$CP.spawnSync($CMD, $$$_)","child_process.exec($CMD, $$$_)","child_process.execSync($CMD, $$$_)","child_process.spawn($CMD, $$$_)","child_process.spawnSync($CMD, $$$_)"])
          | not_at(($all | of(["$CP.exec($CMD, $$$_)","$CP.execSync($CMD, $$$_)","$CP.spawn($CMD, $$$_)","$CP.spawnSync($CMD, $$$_)","child_process.exec($CMD, $$$_)","child_process.execSync($CMD, $$$_)","child_process.spawn($CMD, $$$_)","child_process.spawnSync($CMD, $$$_)"]) | where_capture("CMD"; "^[\"'].*[\"']$")))
          | focus("CMD"))
          | in_files_with(($all | of(["$CP = require('child_process')\n$$$", "const $CP = require('child_process')", "let $CP = require('child_process')", "var $CP = require('child_process')"])) + ($all | of(["import $CP from 'child_process'\n$$$", "import * as $CP from 'child_process'\n$$$"])))
          | reaching(((($all | of(["function ($$$_, $FUNC, $$$_) {$$$_}","function $F($$$_, $FUNC, $$$_) {$$$_}"]))
          + ($all | of(["($FUNC) => {$$$_}","($$$_, $FUNC, $$$_) => {$$$_}"]))
          | focus("FUNC")));
              ([]))
        | finding("detect-child-process";
            "Detected calls to child_process from a function argument.") ) ))
| report
