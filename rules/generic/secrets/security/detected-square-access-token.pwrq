# rules: detected-square-access-token
# fixture: generic/detected-square-access-token.txt
# from: generic/secrets/security/detected-square-access-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "sq0atp-[0-9A-Za-z\\-_]{22}"
    ])) as $all
    | ( $all | of(["sq0atp-[0-9A-Za-z\\-_]{22}"])
        | finding("detected-square-access-token";
        "this is a square access token written into the source, so it is in every checkout "
        + "and every image built from one; read it from the environment, and "
        + "rotate this one because it has leaked") ) )
| report
