# rules: useless-equal
# languages: ocaml
# fixture: ocaml/useless-equal.ml
# from: ocaml/lang/correctness/useless-eq.yaml

. as $root
| ( ($root | scan_ast(["*.ml"]; [
      "$X = $X"
    ])) as $all
    | ( $all | of(["$X = $X"])
        | finding("useless-equal";
            "This is always true.") ) )
| report
