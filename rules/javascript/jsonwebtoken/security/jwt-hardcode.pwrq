# rules: hardcoded-jwt-secret
# languages: javascript, typescript
# fixture: javascript/hardcoded-jwt-secret.js
# from: javascript/jsonwebtoken/security/jwt-hardcode.yaml
#
# Repair: the quoted hole `"$$$_"` matched a non-string argument, so the
# literal branch reported `jwt.sign(data, process.env.JWT_SECRET)` - the
# correct code - under this id, and `reaching` cannot carry a module-level
# `const SECRET` into the function that signs (228 findings, 64% safe). A
# real string literal, or an all-caps constant identifier, is the key written
# into the source; a member expression is read at run time and is not.

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$JWT.sign($DATA,$VALUE,$$$_);",
      "$JWT.verify($DATA,$VALUE,$$$_);",
      "$JWT.sign($DATA,$S:string,$$$_);",
      "$JWT.verify($DATA,$S:string,$$$_);",
      "$JWT.sign($DATA,process.env.$K,$$$_);",
      "$JWT.sign($DATA,import.meta.env.$K,$$$_);",
      "$JWT.verify($DATA,process.env.$K,$$$_);",
      "$JWT.verify($DATA,import.meta.env.$K,$$$_);"
    ])) as $all
    | [ "$JWT.sign($DATA,$VALUE,$$$_);", "$JWT.verify($DATA,$VALUE,$$$_);" ] as $sinks
    | [ "$JWT.sign($DATA,$S:string,$$$_);", "$JWT.verify($DATA,$S:string,$$$_);" ] as $literal
    | [ "$JWT.sign($DATA,process.env.$K,$$$_);", "$JWT.sign($DATA,import.meta.env.$K,$$$_);", "$JWT.verify($DATA,process.env.$K,$$$_);", "$JWT.verify($DATA,import.meta.env.$K,$$$_);" ] as $env
    | ( ( $all | of($literal) )
        + ( $all | of($sinks)
            | not_at($all | of($literal))
            | not_at($all | of($env))
            | where_capture("VALUE"; "^[A-Z][A-Z0-9_]*$") )
        | finding("hardcoded-jwt-secret";
            "the token signing key is written into the source, so it is in "
            + "every checkout, anyone who reads it can forge a token, and it "
            + "cannot be rotated without a release; read it from the environment") ) )
| report
