# rules: xml-decoder
# languages: java
# fixture: java/xml-decoder.java
# from: java/lang/security/audit/xml-decoder.yaml
#
# Every shape was a method scaffold with statement gaps that match nothing,
# so the rule never fired. The finding is the construction itself now, kept
# when its argument is not a literal.

. as $root
| ( ($root | scan_ast(["*.java"]; [
      "new XMLDecoder($ARG)"
    ])) as $all
    | ( $all | of(["new XMLDecoder($ARG)"])
          | where_capture_not("ARG"; "^\"")
        | finding("xml-decoder";
            "XMLDecoder should not be used to parse untrusted data.") ) )
| report
