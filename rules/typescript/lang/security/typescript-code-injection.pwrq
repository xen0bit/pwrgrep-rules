# rules: typescript-code-injection
# languages: typescript
# fixture: typescript/CWE-94.ts
# from: CWE-94 (Code Injection)

["req.query.get($$$_)", "req.params.get($$$_)", "req.body.get($$$_)", "location.search"] as $src
| ["eval($CODE)", "Function($CODE)", "new Function($CODE)"] as $sink
| scan_ast(["*.ts","*.tsx"]; $src + $sink) as $all
| ( $all | of($sink) | focus("CODE") | reaching($all | of($src); []) | finding("typescript-code-injection";
        "this evaluates a value the caller chose as code, which is the whole of "
        + "the language and not the part you meant; look the value up in a "
        + "map of the things it is allowed to be") )
| report
