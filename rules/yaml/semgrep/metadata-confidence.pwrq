# rules: metadata-confidence
# languages: yaml
# fixture: yaml/metadata-confidence.yaml
#
# The absence half used multi-line outside spans that never enclose
# anything, so the rule never fired. Rewritten as a regex over the metadata
# block (fixed four/six-space indent, the semgrep style) with text guards;
# the security-category scope rides along in the same text.
# A `rules:` key at column zero is what says the file is a Semgrep rule and
# not something else that spells a key the same way: `metadata:` is every
# Kubernetes manifest, `- id:` is any list of records, and `message: |` is
# any workflow that writes more than a line.
# from: yaml/semgrep/metadata-confidence.yaml

. as $root
| ($root | scan_regex(["*.yaml","*.yml"]; [
      "(?m)^rules:[^\\S\n]*$"
    ])) as $semgrep
| ( (($root | scan_regex(["*.yaml","*.yml"]; [
      "(?m)^    metadata:[^\\S\n]*\n((?:      [^\n]*\n?)*)"
    ])) | in_files_with($semgrep)) as $all
    | ( $all | of(["(?m)^    metadata:[^\\S\n]*\n((?:      [^\n]*\n?)*)"])
          | where_text("category:\\s*security")
          | where_text_not("confidence:")
        | finding("metadata-confidence";
            "This Semgrep rule is missing a valid 'confidence' field in the 'metadata'.") ) )
| report
