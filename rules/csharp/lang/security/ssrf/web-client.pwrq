# rules: ssrf
# languages: c_sharp
# fixture: csharp/web-client.cs
# from: csharp/lang/security/ssrf/web-client.yaml
#
# As in http-client: the whole-method shapes match nothing, so the fetched
# URL is a hole the method parameter reaches.

["public $T $M($U $A) { $$$BODY }"] as $methods
| ["$Y.DownloadString($U);", "$Y.OpenRead($U);", "$Y.OpenReadAsync($U, $$$);"] as $sinks
| ["using System.Net;"] as $using
| scan_ast("*.cs"; $methods + $sinks + $using) as $all
| ( ($all | of($sinks) | focus("U"))
      | reaching((($all | of($methods) | focus("A"))); ([]))
      | in_files_with($all | of($using))
    | finding("ssrf";
        "SSRF is an attack vector that abuses an application to interact with the internal/external network or the machine itself.") )
| report
