# rules: sling-http-request
# languages: go
# fixture: problem-based-packs/go-sling-http-request.go
#
# The `"=~/http.../"` string guards never match and the `;\n$$$_` gaps do
# not span Go statements, so no form fired. Rewritten as direct sling calls
# with the URL in a named hole guarded by where_capture (the http-request
# shape); the builder-chain correlation is out of scope.
# from: problem-based-packs/insecure-transport/go-stdlib/sling-http-request.yaml

. as $root
| ( ($root | scan_ast(["*.go"]; [
      "$REQ.$FUNC($URL)",
      "sling.New().$FUNC($URL)"
    ])) as $all
    | ( $all | of(["$REQ.$FUNC($URL)","sling.New().$FUNC($URL)"])
          | where_capture("URL"; "http://")
          | where_capture("FUNC"; "^(?:(Get|Post|Delete|Head|Put|Options|Patch|Base|Connect))")
        | finding("sling-http-request";
            "Checks for requests to http (unencrypted) sites using gorequest, a popular HTTP client library.") ) )
| report
