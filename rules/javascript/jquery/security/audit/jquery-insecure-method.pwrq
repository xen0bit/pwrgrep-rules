# rules: jquery-insecure-method
# languages: javascript, typescript
# fixture: javascript/jquery-insecure-method.js
# from: javascript/jquery/security/audit/jquery-insecure-method.yaml
#
# Repair: the translated rule reported any non-literal argument to jQuery's
# HTML-writing methods - 477 findings, and 73% of the ones the audit judged
# had a rationale saying the site was safe, because the argument is usually
# markup the page built itself. It now requires the value to name a source
# the page does not own, which is what makes the XSS demonstrable.

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$($$$_).$METHOD($VAR,$$$_)",
      "$.$METHOD($VAR,$$$_)",
      "jQuery($$$_).$METHOD($VAR,$$$_)",
      "jQuery.$METHOD($VAR,$$$_)"
    ])) as $all
    | ( $all | of(["$($$$_).$METHOD($VAR,$$$_)","$.$METHOD($VAR,$$$_)","jQuery($$$_).$METHOD($VAR,$$$_)","jQuery.$METHOD($VAR,$$$_)"])
          | where_capture("METHOD"; "^(html|append|prepend|wrap|wrapInner|wrapAll|before|after|globalEval|getScript|appendTo|insertAfter|insertBefore|prependTo)$")
          | where_capture_not("VAR"; "^[\"'][^\"']*[\"']$")
          | where_capture("VAR"; "(?i)(location|hash|search|query|param|input|value|body|url|uri|referrer|req|request|payload|cookie|user|data|name)")
        | finding("jquery-insecure-method";
            "jQuery parses `$VAR` as markup, so anything in it that looks like "
            + "HTML becomes HTML; pass it to `.text()` or sanitise first") ) )
| report
