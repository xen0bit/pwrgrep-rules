# rules: python-log-injection
# languages: python
# fixture: python/CWE-117.py
# from: CWE-117 (Improper Output Neutralization for Logs)
#
# A value the caller chose that reaches a logging sink can contain `\n` and
# forge a new log entry, hiding or inventing events. The rule is `reaching`:
# an untrusted value from the request (query string, form, route variable, or
# `self.path`) that flows into a logging sink. A literal has nothing to flow.

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "logging.debug($MSG)", "logging.info($MSG)", "logging.warning($MSG)", "logging.error($MSG)", "logging.critical($MSG)", "logging.log($$$_, $MSG, $$$_)",
      "logger.debug($MSG)", "logger.info($MSG)", "logger.warning($MSG)", "logger.error($MSG)", "logger.critical($MSG)", "logger.log($$$_, $MSG, $$$_)",
      "flask.request.args.get($$$_)", "flask.request.args[$$$_]",
      "flask.request.form.get($$$_)", "flask.request.form[$$$_]",
      "flask.request.values.get($$$_)", "flask.request.values[$$$_]",
      "flask.request.cookies.get($$$_)", "flask.request.data",
      "request.args.get($$$_)", "request.args[$$$_]",
      "request.form.get($$$_)", "request.form[$$$_]",
      "request.values.get($$$_)", "request.data",
      "self.path", "self.headers.get($$$_)", "self.headers[$$$_]",
      "@$APP.route($$$_)\ndef $FUNC($$$_, $ROUTEVAR, $$$_):\n  $$$_",
      "def $FUNC(request, $$$_):\n  $$$_"
    ])) as $all
  | ($all | of(["logging.debug($MSG)", "logging.info($MSG)", "logging.warning($MSG)", "logging.error($MSG)", "logging.critical($MSG)", "logging.log($$$_, $MSG, $$$_)", "logger.debug($MSG)", "logger.info($MSG)", "logger.warning($MSG)", "logger.error($MSG)", "logger.critical($MSG)", "logger.log($$$_, $MSG, $$$_)"])
      | focus("MSG")
      | reaching($all | of(["flask.request.args.get($$$_)","flask.request.args[$$$_]","flask.request.form.get($$$_)","flask.request.form[$$$_]","flask.request.values.get($$$_)","flask.request.values[$$$_]","flask.request.cookies.get($$$_)","flask.request.data","request.args.get($$$_)","request.args[$$$_]","request.form.get($$$_)","request.form[$$$_]","request.values.get($$$_)","request.data","self.path","self.headers.get($$$_)","self.headers[$$$_]"])
          + ($all | within($all | of(["@$APP.route($$$_)\ndef $FUNC($$$_, $ROUTEVAR, $$$_):\n  $$$_"])) | focus("ROUTEVAR"))
          + ($all | within($all | of(["def $FUNC(request, $$$_):\n  $$$_"])) | of(["request.args.get($$$_)","request.args[$$$_]","request.form.get($$$_)","request.form[$$$_]"]))
          ; []))
  | finding("python-log-injection";
      "untrusted input reaches log; a newline in it forges a log entry — "
      + "sanitize or encode before logging")
  )
| report
