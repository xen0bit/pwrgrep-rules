# rules: detected-github-token
# fixture: generic/detected-github-token.txt
# from: generic/secrets/security/detected-github-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "\"\\[hH\\]\\[tT\\]\\[tT\\]\\[pP\\]\\[sS\\]\\?:\\/\\/\\.\\*(?P<SECRET>\\S+)\\.\\*\"",
      "'(?P<VAR>\\S+)':\\s+'(?P<SECRET>\\S+)'",
      "'(?P<VAR>\\S+)'\\s+=\\s+'(?P<SECRET>\\S+)'",
      "(?P<VAR>\\S+):\\s+'(?P<SECRET>\\S+)'",
      "(?P<VAR>\\S+):\\s+(?P<SECRET>\\S+)",
      "(?P<VAR>\\S+)\\s+=\\s+'(?P<SECRET>\\S+)'",
      "(?P<VAR>\\S+)\\s+=\\s+(?P<SECRET>\\S+)"
    ])) as $all
    | ( $all | of(["(?P<VAR>\\S+)\\s+=\\s+(?P<SECRET>\\S+)","(?P<VAR>\\S+):\\s+(?P<SECRET>\\S+)","(?P<VAR>\\S+)\\s+=\\s+'(?P<SECRET>\\S+)'","(?P<VAR>\\S+):\\s+'(?P<SECRET>\\S+)'","'(?P<VAR>\\S+)'\\s+=\\s+'(?P<SECRET>\\S+)'","'(?P<VAR>\\S+)':\\s+'(?P<SECRET>\\S+)'","\"\\[hH\\]\\[tT\\]\\[tT\\]\\[pP\\]\\[sS\\]\\?:\\/\\/\\.\\*(?P<SECRET>\\S+)\\.\\*\""])
          | where_capture("SECRET"; "^(?:gh[pousr]_[A-Za-z0-9_]{36,251})")
          | where_capture_entropy("SECRET")
        | finding("detected-github-token";
        "this is a github token written into the source, so it is in every checkout "
        + "and every image built from one; read it from the environment, and "
        + "rotate this one because it has leaked") ) )
| report
