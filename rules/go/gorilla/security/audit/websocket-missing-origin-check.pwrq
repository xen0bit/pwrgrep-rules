# rules: websocket-missing-origin-check
# languages: go
# fixture: go/websocket-missing-origin-check.go
# from: go/gorilla/security/audit/websocket-missing-origin-check.yaml
#
# The translation reported every match in a file importing gorilla/websocket,
# including the import line itself and the Upgrade call, while the two
# CheckOrigin shapes never matched real code (`=` is not `:=`, and the
# multi-field literal reads only its first field). The rule now reports the
# Upgrader construction itself when its text sets no CheckOrigin.

. as $root
| ( ($root | scan_ast(["*.go"]; [
      "$UPGRADER = websocket.Upgrader{$$$B}",
      "$UPGRADER := websocket.Upgrader{$$$B}"
    ])) as $all
    | ( $all | of(["$UPGRADER = websocket.Upgrader{$$$B}","$UPGRADER := websocket.Upgrader{$$$B}"])
          | where_text_not("CheckOrigin")
        | finding("websocket-missing-origin-check";
            "The Origin header in the HTTP WebSocket handshake is used to guarantee that the connection accepted by the WebSocket is from a trusted origin domain.") ) )
| report
