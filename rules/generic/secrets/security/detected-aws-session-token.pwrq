# rules: detected-aws-session-token
# fixture: generic/detected-aws-session-token.txt
# from: generic/secrets/security/detected-aws-session-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "((?i)AWS_SESSION_TOKEN)\\s*(:|=>|=)\\s*(?P<TOKEN>[A-Za-z0-9/+=]{16,})",
      "(?i)example|sample|test|fake"
    ])) as $all
    | ( $all | of(["((?i)AWS_SESSION_TOKEN)\\s*(:|=>|=)\\s*(?P<TOKEN>[A-Za-z0-9/+=]{16,})"])
          | not_at($all | of(["(?i)example|sample|test|fake"]))
          | where_capture_entropy("TOKEN")
        | finding("detected-aws-session-token";
        "this is an aws session token written into the source, so it is in every checkout "
        + "and every image built from one; read it from the environment, and "
        + "rotate this one because it has leaked") ) )
| report
