# rules: typescript-sensitive-log
# languages: typescript
# fixture: typescript/CWE-532.ts
# from: CWE-532 Insertion of Sensitive Information into Log File

["console.log($MSG)", "console.info($MSG)", "console.debug($MSG)", "console.warn($MSG)", "console.error($MSG)", "logger.info($MSG)", "logger.debug($MSG)"] as $sinks
| "(?i)password|passwd|pwd|secret|api_?key|token" as $names
| scan_ast(["*.ts","*.tsx"]; $sinks) as $all
| ($all | of($sinks) | where_capture("MSG"; $names))
| finding("typescript-sensitive-log";
    "sensitive data is written to the log; it will be in log files and "
    + "shipped to any log collector — redact it")
| report
