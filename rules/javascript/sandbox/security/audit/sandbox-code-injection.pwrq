# rules: sandbox-code-injection
# languages: javascript, typescript
# fixture: javascript/sandbox-code-injection.js
# from: javascript/sandbox/security/audit/sandbox-code-injection.yaml
#
# Repair: the file gates fed require matches into `at_same_place`, `in_files_without("..."` dropped every file with a string, and the literal exclusions read holes as anything. Sinks are selected first with file-level gates and function-argument sources.

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "($$$_, $FUNC, $$$_) => {$$$_}",
      "($FUNC) => {$$$_}",
      "$SBX.run($CODE)",
      "new $BOX($OPTS).run($CODE)",
      "new $BOX().run($CODE)",
      "$SBX = new $BOX($$$_)",
      "const $SBX = new $BOX($$$_)",
      "$SBXLIB = require('sandbox')",
      "const $SBXLIB = require('sandbox')",
      "child_process.spawnSync($CMD, $$$_)",
      "const $SBX = new $BOX($$$_)",
      "function ($$$_, $FUNC, $$$_) {$$$_}",
      "function $F($$$_, $FUNC, $$$_) {$$$_}",
      "import $SBXLIB from 'sandbox'\n$$$_",
      "import * as $SBXLIB from 'sandbox'\n$$$_",
      "$SBXLIB = require('sandbox')",
      "const $SBXLIB = require('sandbox')",
      "$SBX = new $BOX($$$_)"
    ])) as $all
    | ( (($all | of(["$SBX.run($CODE)", "new $BOX($OPTS).run($CODE)", "new $BOX().run($CODE)"])
          | not_at(($all | of(["$SBX.run($CODE)", "new $BOX($OPTS).run($CODE)", "new $BOX().run($CODE)"]) | where_capture("CODE"; "^[\"'].*[\"']$")))
          | focus("CODE"))
          | in_files_with(($all | of(["$SBX = new $BOX($$$_)", "const $SBX = new $BOX($$$_)", "$SBXLIB = require('sandbox')", "const $SBXLIB = require('sandbox')"])) + ($all | of([])))
          | reaching(((($all | of(["function ($$$_, $FUNC, $$$_) {$$$_}","function $F($$$_, $FUNC, $$$_) {$$$_}"]))
          + ($all | of(["($FUNC) => {$$$_}","($$$_, $FUNC, $$$_) => {$$$_}"]))
          | focus("FUNC")));
              ([]))
        | finding("sandbox-code-injection";
            "Make sure that unverified user data can not reach `sandbox`.") ) ))
| report
