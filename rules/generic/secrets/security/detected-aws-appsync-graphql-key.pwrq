# rules: detected-aws-appsync-graphql-key
# fixture: generic/detected-aws-appsync-graphql-key.txt
# from: generic/secrets/security/detected-aws-appsync-graphql-key.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "da2-[a-z0-9]{26}"
    ])) as $all
    | ( $all | of(["da2-[a-z0-9]{26}"])
        | finding("detected-aws-appsync-graphql-key";
        "this is an aws appsync graphql key written into the source, so it is in every checkout "
        + "and every image built from one; read it from the environment, and "
        + "rotate this one because it has leaked") ) )
| report
