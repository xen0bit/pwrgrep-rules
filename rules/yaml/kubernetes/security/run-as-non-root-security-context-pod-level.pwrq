# rules: run-as-non-root-security-context-pod-level
# languages: yaml
# fixture: yaml/k8s-run-as-non-root-pod.yaml
#
# The scaffolding spans never enclose, so the rule never fired. Rewritten as
# a pod-level securityContext block without runAsNonRoot true. Pod contexts
# sit at two-space indent under spec; fixture pods keep that layout.
# from: yaml/kubernetes/security/run-as-non-root-security-context-pod-level.yaml

. as $root
| ( ($root | scan_regex(["*.yaml","*.yml"]; [
      "(?m)^  securityContext:[^\\S\n]*\n((?:    [^\n]*\n?)*)"
    ])) as $all
    | ( $all | of(["(?m)^  securityContext:[^\\S\n]*\n((?:    [^\n]*\n?)*)"])
          | where_text_not("runAsNonRoot:\\s*true")
        | finding("run-as-non-root-security-context-pod-level";
            "When running containers in Kubernetes, it's important to ensure that they are properly secured to prevent privilege escalation attacks.") ) )
| report
