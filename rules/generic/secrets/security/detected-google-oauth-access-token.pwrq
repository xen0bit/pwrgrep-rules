# rules: detected-google-oauth-access-token
# fixture: generic/detected-google-oauth-access-token.txt
# from: generic/secrets/security/detected-google-oauth-access-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "ya29\\.[0-9A-Za-z\\-_]+"
    ])) as $all
    | ( $all | of(["ya29\\.[0-9A-Za-z\\-_]+"])
        | finding("detected-google-oauth-access-token";
        "this is a google oauth access token written into the source, so it is in every checkout "
        + "and every image built from one; read it from the environment, and "
        + "rotate this one because it has leaked") ) )
| report
