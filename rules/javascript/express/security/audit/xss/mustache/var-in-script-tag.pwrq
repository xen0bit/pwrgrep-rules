# rules: var-in-script-tag
# from: javascript/express/security/audit/xss/mustache/var-in-script-tag.yaml
# fixture: javascript/var-in-script-tag-mustache.js
#
# Repair: dead as written. `\{\{\s+` needed spaces `{{name}}` omits, and the
# script-body span never coincided with anything. The rule now uses one
# combined regex for a Mustache variable inside a single-line script
# element.

. as $root
| ( ($root | scan_regex(["*.mustache","*.hbs","*.html"]; [
      "<script[^>]*?>.*?\\{\\{.*?\\}\\}.*?</script>"
    ])) as $all
    | ( $all | of(["<script[^>]*?>.*?\\{\\{.*?\\}\\}.*?</script>"])
        | finding("var-in-script-tag";
            "Detected a template variable used in a script tag.") ) )
| report
