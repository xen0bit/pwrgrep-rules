# rules: ocamllint-ssrf
# languages: ocaml
# fixture: ocaml/CWE-918.ml
# from: CWE-918 (SSRF)

. as $root
| ( $root | scan_ast(["*.ml"]; ["Http.get $URL", "Cohttp_lwt_unix.Client.get $URL"]) ) as $all
| ( $all | of(["Http.get $URL", "Cohttp_lwt_unix.Client.get $URL"]) | where_capture_not("URL"; "^\".*\"$") | finding("ocamllint-ssrf";
        "the destination of this request is a value the caller chose, so it can "
        + "be pointed at the metadata service or anything else this host can "
        + "reach; check it against the hosts you meant to allow") )
| report
