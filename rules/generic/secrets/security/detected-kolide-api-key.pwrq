# rules: detected-kolide-api-key
# fixture: generic/detected-kolide-api-key.txt
# from: generic/secrets/security/detected-kolide-api-key.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "k2sk_v[0-9]_[0-9a-zA-Z]{24}"
    ])) as $all
    | ( $all | of(["k2sk_v[0-9]_[0-9a-zA-Z]{24}"])
        | finding("detected-kolide-api-key";
        "this is a kolide api key written into the source, so it is in every checkout "
        + "and every image built from one; read it from the environment, and "
        + "rotate this one because it has leaked") ) )
| report
