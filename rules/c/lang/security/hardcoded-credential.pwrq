# rules: c-hardcoded-credential
# languages: c
# fixture: c/CWE-798.c
# from: CWE-798 (Use of Hard-coded Credentials), CWE-259, CWE-321
#
# A secret written into the source is in every binary built from it, in every
# core dump, and in the repository's history for as long as the repository
# exists. `strings` finds it in a second, and rotating it needs a release. It
# is also, in C, the shape a credential usually takes: there is no config
# library in the standard headers, so the literal goes in the file.
#
# The name is what makes this checkable. There is nothing about "hunter2" that
# says it is a password - it is the identifier beside it that says so - so the
# rule reads the name and takes the string on the strength of it. That is also
# where the false positives come from, and two guards deal with the two kinds
# that turn up: an empty string, which is a placeholder rather than a secret,
# and a string with a conversion specifier in it, which is a format for a
# credential rather than one.
#
# The last patterns are credentials with no name at all: a connection
# function whose password parameter is a literal. There the argument position
# says what an identifier would have, which is also why the message quotes the
# value rather than the name - half these findings have no name to quote.

"(?i)pass(word|wd|phrase)?|secret|token|api_?key|auth_?key|access_?key"
  as $names
| "^L?\"[^\"]{4,}\"$" as $literal
| "%[-#0-9.*hlLqjzt]*[diouxXeEfgGaAcspn]" as $format
| ["#define $NAME $VALUE", "$_ *$NAME = $VALUE;", "$_ $NAME[] = $VALUE;",
   "$_ $NAME[$_] = $VALUE;"] as $named
| ["mysql_real_connect($_, $_, $_, $VALUE, $$$_)",
   "PQsetdbLogin($_, $_, $_, $_, $_, $_, $VALUE)",
   "SQLConnect($_, $_, $_, $_, $_, $VALUE, $_)",
   "sqlite3_key($_, $VALUE, $_)",
   "ldap_simple_bind_s($_, $_, $VALUE)"] as $positional
| scan_ast("*.[ch]"; $named + $positional) as $all
| ( ($all | of($named) | where_capture("NAME"; $names))
    + ($all | of($positional)) )
| where_capture("VALUE"; $literal)
| where_capture_not("VALUE"; $format)
| finding("c-hardcoded-credential";
    "$VALUE is a credential written into the source; it is in every binary "
    + "built from this file, in every core dump, and in this repository's "
    + "history, and it cannot be changed without a release")
| report
