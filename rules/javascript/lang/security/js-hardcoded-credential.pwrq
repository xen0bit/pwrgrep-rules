# rules: js-hardcoded-credential
# languages: javascript, typescript
# fixture: javascript/CWE-798.js
# from: CWE-798 (Use of Hard-coded Credentials)

"(?i)pass(word|wd|phrase)?$|secret|token|api_?key|auth_?key|access_?key|client_?secret" as $names
| "^\"[^\"]{8,}\"$|^'[^']{8,}'$" as $literal
| "(?i)^[\"'](?:changeme|change_me|password|secret|example|placeholder|redacted|your[-_ ]|xxx|todo|fixme|test|dummy|sample)[\"']$" as $placeholder
| "^[\"'][A-Z][A-Z0-9_]*[\"']$" as $envName
| ["const $NAME = $VALUE","let $NAME = $VALUE","var $NAME = $VALUE","$NAME = $VALUE"] as $named
| scan_ast(["*.js","*.ts"]; $named) as $all
| ( $all | of($named)
    | where_capture("NAME"; $names)
    | where_capture("VALUE"; $literal)
    | where_capture_not("VALUE"; $placeholder)
    | where_capture_not("VALUE"; $envName)
    | focus("VALUE") )
| finding("js-hardcoded-credential";
    "hardcoded credential written into source; it is in every checkout and cannot be rotated")
| report
