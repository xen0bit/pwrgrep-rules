# rules: interfile-true-under-metadata-and-no-options
# languages: yaml
# fixture: yaml/semgrep-interfile-true-under-metadata-and-no-options.yaml
#
# Rule-start-anchored spans never line up, so the form never fired. Rewritten
# as a metadata-block match with an interfile guard, in files with no options
# section at all. Fixed four/six-space indent.
# from: yaml/semgrep/interfile-true-under-metadata-and-no-options.yaml

. as $root
| ( ($root | scan_regex(["*.yaml","*.yml"]; [
      "(?m)^    metadata:[^\\S\n]*\n((?:      [^\n]*\n?)*)",
      "(?m)^    options:"
    ])) as $all
    | ( $all | of(["(?m)^    metadata:[^\\S\n]*\n((?:      [^\n]*\n?)*)"])
          | where_text("interfile:\\s*true")
          | in_files_without($all | of(["(?m)^    options:"]))
        | finding("interfile-true-under-metadata-and-no-options";
            "`interfile: true` should be under the `options` field, not the `metadata` field.") ) )
| report
