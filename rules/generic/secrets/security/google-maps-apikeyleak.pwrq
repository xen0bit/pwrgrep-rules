# rules: google-maps-apikeyleak
# languages:
# fixture: generic/google-maps-apikeyleak.txt
# from: generic/secrets/security/google-maps-apikeyleak.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "\\b(?P<SECRET>AIza[0-9A-Za-z_-]{35})\\b"
    ])) as $all
    | ( $all | of(["\\b(?P<SECRET>AIza[0-9A-Za-z_-]{35})\\b"])
          | where_capture("SECRET"; "^AIza[0-9A-Za-z_-]{35}$")
          | where_capture_entropy("SECRET")
        | finding("google-maps-apikeyleak";
        "this is a google maps api key written into the source, so it is in every checkout "
        + "and every image built from one; read it from the environment, and "
        + "rotate this one because it has leaked") ) )
| report
