# rules: exported_loop_pointer
# languages: go
# fixture: go/exported-loop-pointer.go
# from: go/lang/correctness/looppointer.yaml
#
# The translated regexes wrapped their wildcards in literal `<...>` (Semgrep
# ellipsis syntax), so they matched no valid Go file; with the brackets
# stripped the multiline wildcards still spanned loops and double-reported
# lines. The rule now reads the loop structurally and asks whether the body
# takes an address. It does not check the address is the iteration
# variable's, so `&w` for an outer `w` inside the body also reads as a match.

. as $root
| ( ($root | scan_ast(["*.go"]; [
      "for _, $V := range $SRC { $$$B }"
    ])) as $all
    | ( $all | of(["for _, $V := range $SRC { $$$B }"])
          | where_capture_ast("B"; "&$V")
        | finding("exported_loop_pointer";
            "`$V` is a loop pointer that may be exported from the loop.") ) )
| report
