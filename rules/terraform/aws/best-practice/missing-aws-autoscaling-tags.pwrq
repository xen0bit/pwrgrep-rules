# rules: missing-aws-autoscaling-tags
# fixture: terraform/missing-aws-autoscaling-tags.tf
# from: terraform/aws/best-practice/missing-aws-autoscaling-tags.yaml

. as $root
| ( ($root | scan_regex(["*.tf"]; [
      "resource\\s+\"aws_autoscaling_group\"\\s+(?P<ANYTHING>\\S+)\\s+\\{[\\s\\S]*?\\}",
      "resource\\s+\"aws_autoscaling_group\"\\s+(?P<ANYTHING>\\S+)\\s+\\{[\\s\\S]*?tag\\s+\\{[\\s\\S]*?\\}[\\s\\S]*?\\}",
      "resource\\s+\"aws_autoscaling_group\"\\s+(?P<ANYTHING>\\S+)\\s+\\{[\\s\\S]*?tags\\s+=\\s+concat\\([\\s\\S]*?\\)[\\s\\S]*?\\}"
    ])) as $all
    | ( $all | of(["resource\\s+\"aws_autoscaling_group\"\\s+(?P<ANYTHING>\\S+)\\s+\\{[\\s\\S]*?\\}"])
          | outside($all | of(["resource\\s+\"aws_autoscaling_group\"\\s+(?P<ANYTHING>\\S+)\\s+\\{[\\s\\S]*?tag\\s+\\{[\\s\\S]*?\\}[\\s\\S]*?\\}"]))
          | outside($all | of(["resource\\s+\"aws_autoscaling_group\"\\s+(?P<ANYTHING>\\S+)\\s+\\{[\\s\\S]*?tags\\s+=\\s+concat\\([\\s\\S]*?\\)[\\s\\S]*?\\}"]))
        | finding("missing-aws-autoscaling-tags";
            "The AWS Autoscaling Group is not tagged.") ) )
| report

