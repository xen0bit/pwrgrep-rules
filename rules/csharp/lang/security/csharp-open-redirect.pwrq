# rules: csharp-open-redirect
# languages: c_sharp
# fixture: csharp/CWE-601.cs
# from: CWE-601 (Open Redirect)
#
# Response.Redirect with URL from Request.QueryString/Form allows open redirect.

["$T $V = $S;"] as $assigned
| ["public $T $M($$$_, string $P, $$$_) { $$$_ }", "public $T $M(string $P) { $$$_ }"] as $bound
| ["using Microsoft.AspNetCore.Mvc;", "using System.Web.Mvc;"] as $mvcImports
| ["class $C : $B { $$$_ }"] as $classes
| ["Response.Redirect($URL, $$$_)", "Redirect($URL, $$$_)"] as $sinks
| "Request\\s*\\.\\s*(Query|Form|Headers|Cookies|QueryString|Params)\\b" as $fromRequest
| scan_ast("*.cs"; $assigned + $bound + $mvcImports + $classes + $sinks) as $all
| ( ($all | of($assigned) | where_capture("S"; $fromRequest) | focus("S"))
    + ($all | of($bound) | focus("P") | in_files_with(($all | of($mvcImports)) + ($all | of($classes) | where_capture("B"; "Controller")))) ) as $untrusted
| ($all | of($sinks) | focus("URL"))
| reaching($untrusted; [])
| finding("csharp-open-redirect"; "Open redirect: $URL came from request and reaches Redirect")
| report
