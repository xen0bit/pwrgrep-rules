# rules: express-xml2json-xxe-event
# languages: javascript, typescript
# fixture: javascript/express-xml2json-xxe-event.js
# from: javascript/express/security/audit/express-xml2json-xxe-event.yaml
#
# Repair: dead as written. `function $$$_ (...)` matched only named
# declarations so no source ever counted, and `at_same_place` needed exact
# span coincidence between the handler and the `req` use inside it. The
# finding is really the `req.on(...)` nesting with `toJson` inside, so the
# rule now matches that shape directly (callback must contain a `toJson`
# call) with a file-level `xml2json` gate. Globs cover *.js as well as *.ts.

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$P.toJson($D)",
      "$REQ.on($EVT, $CB)",
      "const $X = require('xml2json')",
      "let $X = require('xml2json')",
      "var $X = require('xml2json')",
      "require('xml2json');\n$$$",
      "import 'xml2json';\n$$$"
    ])) as $all
    | ( ($all | of(["$REQ.on($EVT, $CB)"])
          | where_capture_ast("CB"; "$P.toJson($D)")
          | focus("CB"))
          | in_files_with(($all | of(["require('xml2json');\n$$$", "import 'xml2json';\n$$$", "const $X = require('xml2json')", "let $X = require('xml2json')", "var $X = require('xml2json')"])))
        | finding("express-xml2json-xxe-event";
            "Xml Parser is used inside Request Event.") ) )
| report
