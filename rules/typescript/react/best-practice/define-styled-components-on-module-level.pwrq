# rules: define-styled-components-on-module-level
# languages: javascript, typescript
# fixture: typescript/define-styled-components-on-module-level.ts
#
# The function and class linchpins were bodies written `$$$`, which compile
# to a statement literally named `$$$` and match nothing - leaving `within`
# against an empty set, which is vacuous, so the rule fired on module-level
# definitions too. Both are `$$$BODY` now and the import lost its trailing gap
# (dead for the same reason). An `export` in front breaks both linchpins: the
# wrapped declaration misses the bare spelling, and spelling it with `export`
# matches but cannot serve as a `within` container, so exported components
# are missed and the fixture keeps its components unexported.
# from: typescript/react/best-practice/define-styled-components-on-module-level.yaml

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "class $CLASS {\n  $$$BODY\n}",
      "function $FUNC($$$_) {\n  $$$BODY\n}",
      "import styled from 'styled-components';",
      "styled($EL)`$$$_`;",
      "styled.$EL`$$$_`;"
    ])) as $all
    | ( ($all
          | within($all | of(["function $FUNC($$$_) {\n  $$$BODY\n}"])))
          + ($all
          | within($all | of(["class $CLASS {\n  $$$BODY\n}"])))
          | at_same_place(($all | of(["styled.$EL`$$$_`;","styled($EL)`$$$_`;"])))
          | in_files_with($all | of(["import styled from 'styled-components';"]))
        | finding("define-styled-components-on-module-level";
            "By declaring a styled component inside the render method of a react component, you are dynamically creating a new component on every render.") ) )
| report
