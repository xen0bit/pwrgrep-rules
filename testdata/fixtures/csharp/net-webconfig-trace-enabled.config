<?xml version="1.0" encoding="utf-8"?>
<!-- net-webconfig-trace-enabled: tracing exposes request details at a public
     endpoint. Leave it disabled in production. -->
<configuration>
  <system.web>
    <!-- ruleid: net-webconfig-trace-enabled -->
    <trace enabled="true" requestLimit="10" />
  </system.web>
</configuration>
<configuration>
  <system.web>
    <!-- ok: net-webconfig-trace-enabled -->
    <trace enabled="false" requestLimit="10" />
  </system.web>
</configuration>
