# rules: dangerous-groovy-shell
# languages: java
# fixture: java/dangerous-groovy-shell.java
# from: java/lang/security/audit/dangerous-groovy-shell.yaml
#
# The shell constructions trailed a statement gap that matches nothing,
# so the file gate never held; the construction itself is asked instead. The
# static exclusions read a two-slot shape that subtracted every call, so they
# name their arities and keep only the literal-first-argument spelling.

. as $root
| ( ($root | scan_ast(["*.java"]; [
      "$SHELL.evaluate($A)",
      "$SHELL.evaluate($A, $B)",
      "$SHELL.evaluate($$$_)",
      "$SHELL.parse($A)",
      "$SHELL.parse($A, $B)",
      "$SHELL.parse($$$_)",
      "$SHELL.parseClass($A)",
      "$SHELL.parseClass($A, $B)",
      "$SHELL.parseClass($$$_)",
      "new groovy.lang.GroovyClassLoader()",
      "new groovy.lang.GroovyShell()"
    ])) as $all
    | ( $all | of(["$SHELL.parse($$$_)","$SHELL.evaluate($$$_)","$SHELL.parseClass($$$_)"])
          | at_same_place((($all
          | in_files_with($all | of(["new groovy.lang.GroovyShell()"])))
          + ($all
          | in_files_with($all | of(["new groovy.lang.GroovyClassLoader()"])))))
          | not_at(($all | of(["$SHELL.parse($A)", "$SHELL.parse($A, $B)"]) | where_capture("A"; "^\"")))
          | not_at(($all | of(["$SHELL.evaluate($A)", "$SHELL.evaluate($A, $B)"]) | where_capture("A"; "^\"")))
          | not_at(($all | of(["$SHELL.parseClass($A)", "$SHELL.parseClass($A, $B)"]) | where_capture("A"; "^\"")))
        | finding("dangerous-groovy-shell";
            "A expression is built with a dynamic value.") ) )
| report
