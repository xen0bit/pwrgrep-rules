# rules: detected-slack-webhook2
# fixture: generic/detected-slack-webhook2.txt
# from: generic/secrets/security/detected-slack-webhook.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "https://hooks[.]slack[.]com/services/T[A-Za-z0-9_]{8,}/B[A-Za-z0-9_]{8,}/(?P<SECRET>[A-Za-z0-9_]{20,})"
    ])) as $all
    | ( $all | of(["https://hooks[.]slack[.]com/services/T[A-Za-z0-9_]{8,}/B[A-Za-z0-9_]{8,}/(?P<SECRET>[A-Za-z0-9_]{20,})"])
          | where_capture_entropy("SECRET")
        | finding("detected-slack-webhook2";
        "this is a slack webhook written into the source, so it is in every checkout "
        + "and every image built from one; read it from the environment, and "
        + "rotate this one because it has leaked") ) )
| report
