# rules: use-of-basic-authentication
# languages: yaml
# fixture: yaml/openapi-basic-auth.yaml
# from: yaml/openapi/security/use-of-basic-authentication.yaml

. as $root
| ($root | scan_ast(["*.yaml","*.yml"]; [
      "scheme: basic"
    ])) as $all
| ($all | of(["scheme: basic"]) | finding("use-of-basic-authentication"; "Basic authentication is considered weak and should be avoided."))
| report
