# rules: localhost-base-url
# fixture: generic/localhost-base-url.txt
#
# The translated first pattern is the regex source `.*(localhost|...)` as a
# literal, which no config contains; the rule could never fire. It is replaced
# with the host literals the message is about, read inside the baseURL value.
# from: generic/hugo/best-practice/localhost-base-url.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "localhost",
      "127\\.0\\.0\\.1",
      "baseURL\\s+=\\s+\"[\\s\\S]*?\""
    ])) as $all
    | ( ($all | of(["localhost","127\\.0\\.0\\.1"]))
          | within($all | of(["baseURL\\s+=\\s+\"[\\s\\S]*?\""]))
        | finding("localhost-base-url";
            "The 'baseURL' is set to localhost.") ) )
| report
