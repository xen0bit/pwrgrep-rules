# rules: detected-mailchimp-api-key
# fixture: generic/detected-mailchimp-api-key.txt
# from: generic/secrets/security/detected-mailchimp-api-key.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "[0-9a-f]{32}-us[0-9]{1,2}"
    ])) as $all
    | ( $all | of(["[0-9a-f]{32}-us[0-9]{1,2}"])
        | finding("detected-mailchimp-api-key";
        "this is a mailchimp api key written into the source, so it is in every checkout "
        + "and every image built from one; read it from the environment, and "
        + "rotate this one because it has leaked") ) )
| report
