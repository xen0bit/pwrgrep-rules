# rules: hardcoded-passport-secret
# languages: javascript, typescript
# fixture: javascript/passport-hardcode.js
# from: javascript/passport-jwt/security/passport-hardcode.yaml
#
# Repair: dead as written. `within(require...)` confined matches to the
# require span and `at_same_place` needed exact coincidence, so the strategy
# constructor never connected to its options. The rule now matches option objects with a quoted secret key plus direct
# secret assignments, with file-level `passport-*` gates (bare `new`
# patterns never match).

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$OBJ.clientSecret = $VAL",
      "$OBJ.consumerSecret = $VAL",
      "$OBJ.secretOrKey = $VAL",
      "const $F = require('$LIB')",
      "const $F = require('$LIB').$MEMBER",
      "import $F from '$LIB'\n$$$",
      "{$KEY: $S}"
    ])) as $all
    | ( (($all | of(["{$KEY: $S}"])
          | where_capture("KEY"; "^(secretOrKey|clientSecret|consumerSecret)$") | where_capture("S"; "^[\"'].*[\"']$"))
          + (($all | of(["$OBJ.secretOrKey = $VAL","$OBJ.clientSecret = $VAL","$OBJ.consumerSecret = $VAL"])
          | where_capture("VAL"; "^[\"']")))
          | in_files_with(($all | of(["const $F = require('$LIB')", "const $F = require('$LIB').$MEMBER"]) | where_capture("LIB"; "^passport-")) + ($all | of(["import $F from '$LIB'\n$$$"]) | where_capture("LIB"; "^passport-"))))
        | finding("hardcoded-passport-secret";
            "A hard-coded credential was detected.") ) )
| report
