# rules: detected-outlook-team
# fixture: generic/detected-outlook-team.txt
# from: generic/secrets/security/detected-outlook-team.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "https://outlook\\.office\\.com/webhook/[0-9a-f-]{36}"
    ])) as $all
    | ( $all | of(["https://outlook\\.office\\.com/webhook/[0-9a-f-]{36}"])
        | finding("detected-outlook-team";
        "this is an outlook team written into the source, so it is in every checkout "
        + "and every image built from one; read it from the environment, and "
        + "rotate this one because it has leaked") ) )
| report
