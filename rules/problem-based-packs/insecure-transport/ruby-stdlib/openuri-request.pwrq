# rules: openuri-request
# languages: ruby
# fixture: problem-based-packs/ruby-openuri-request.rb
# from: problem-based-packs/insecure-transport/ruby-stdlib/openuri-request.yaml

. as $root
| ( ($root | scan_ast(["*.rb"]; [
      "$URI = URI.parse($URL, $$$_)\n$$$_\n$URI.open",
      "URI.open($URL, $$$_)"
    ])) as $all
    | ( $all | of(["URI.open($URL, $$$_)","$URI = URI.parse($URL, $$$_)\n$$$_\n$URI.open"])
          | where_capture("URL"; "http://|ftp://")
        | finding("openuri-request";
            "Checks for requests to http and ftp (unencrypted) sites using OpenURI.") ) )
| report
