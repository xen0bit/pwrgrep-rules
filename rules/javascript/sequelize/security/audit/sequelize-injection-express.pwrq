# rules: express-sequelize-injection
# languages: javascript, typescript
# fixture: javascript/sequelize-injection-express.js
# from: javascript/sequelize/security/audit/sequelize-injection-express.yaml
#
# Repair: `function $$$_ (...)` matched only named declarations, route callbacks had to be named, and `at_same_place` needed exact span coincidence; wrappers now cover anon and named shapes and the sinks are one `$QUERY` hole each. Globs cover *.js as well as *.ts.

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$APP.$METHOD($$$_, function $FUNC($REQ, $RES) {$$$_})",
      "$APP.$METHOD($$$_, function $FUNC($REQ, $RES, $NEXT) {$$$_})",
      "$APP.$METHOD($$$_, function ($REQ, $RES) {$$$_})",
      "$APP.$METHOD($$$_, function ($REQ, $RES, $NEXT) {$$$_})",
      "$REQ.query",
      "$REQ.body",
      "$REQ.params",
      "$REQ.cookies",
      "$REQ.headers",
      "$REQ.files.$ANYTHING.data.toString('utf8')",
      "$REQ.files.$ANYTHING['data'].toString('utf8')",
      "$DB.sequelize.query($QUERY, $$$_)",
      "sequelize.query($QUERY, $$$_)",
      "parseInt($$$_)",
      "$FUNC.$PROP.hash($$$_)",
      "({ $REQ }: Request,$RES: Response) => {$$$_}",
      "({ $REQ }: Request,$RES: Response, $NEXT: NextFunction) =>\n{$$$_}",
      "body",
      "cookies",
      "headers",
      "params",
      "query",
      "function ($REQ, $RES) {$$$_}",
      "function $FUNC($REQ, $RES) {$$$_}",
      "function ($REQ, $RES, $NEXT) {$$$_}",
      "function $FUNC($REQ, $RES, $NEXT) {$$$_}"
    ])) as $all
    | ( (($all | of(["$DB.sequelize.query($QUERY, $$$_)", "sequelize.query($QUERY, $$$_)"])
          | focus("QUERY"))
          )
          | reaching(((($all | of(["$REQ.query", "$REQ.body", "$REQ.params", "$REQ.cookies", "$REQ.headers", "$REQ.files.$ANYTHING.data.toString('utf8')", "$REQ.files.$ANYTHING['data'].toString('utf8')"]))
          | within((($all | of(["function ($REQ, $RES) {$$$_}", "function $FUNC($REQ, $RES) {$$$_}", "function ($REQ, $RES, $NEXT) {$$$_}", "function $FUNC($REQ, $RES, $NEXT) {$$$_}"])))
          + ((($all | of(["$REQ.query", "$REQ.body", "$REQ.params", "$REQ.cookies", "$REQ.headers", "$REQ.files.$ANYTHING.data.toString('utf8')", "$REQ.files.$ANYTHING['data'].toString('utf8')"])) | within((($all | of(["$APP.$METHOD($$$_, function $FUNC($REQ, $RES) {$$$_})", "$APP.$METHOD($$$_, function $FUNC($REQ, $RES, $NEXT) {$$$_})"])) + ($all | of(["$APP.$METHOD($$$_, function ($REQ, $RES) {$$$_})", "$APP.$METHOD($$$_, function ($REQ, $RES, $NEXT) {$$$_})"])))) | where_capture("METHOD"; "^(get|post|put|head|delete|options)$")))))
              + (($all
          | within($all | of(["({ $REQ }: Request,$RES: Response, $NEXT: NextFunction) =>\n{$$$_}"])))
          + ($all
          | within($all | of(["({ $REQ }: Request,$RES: Response) => {$$$_}"])))
          | at_same_place(($all | of(["params","query","cookies","headers","body"])))
          | focus("REQ")));
              ((($all | of(["parseInt($$$_)"])) + ($all | of(["$FUNC.$PROP.hash($$$_)"])))))
        | finding("express-sequelize-injection";
            "Detected a sequelize statement that is tainted by user-input.") ) )
| report
