# rules: args
# languages: rust
# fixture: rust/args.rs
# from: rust/lang/security/args.yml

. as $root
| ( ($root | scan_ast(["*.rs"]; [
      "std::env::args()"
    ])) as $all
    | ( $all | of(["std::env::args()"])
        | finding("args";
            "args should not be used for security operations.") ) )
| report
