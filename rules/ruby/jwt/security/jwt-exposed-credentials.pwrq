# rules: ruby-jwt-exposed-credentials
# fixture: ruby/ruby-jwt-exposed-credentials.rb
# from: ruby/jwt/security/jwt-exposed-credentials.yaml
#
# The payload pattern wanted `,password:` with no space after the comma,
# which standard code never writes; it allows whitespace there now.

. as $root
| ( ($root | scan_regex(["*.rb"]; [
      "(?P<PAYLOAD>\\S+)\\s+=\\s+\\{[\\s\\S]*?,\\s*password:[\\s\\S]*?,[\\s\\S]*?\\}\\s+[\\s\\S]*?\\s+JWT\\.encode\\((?P<PAYLOAD>\\S+),[\\s\\S]*?\\)",
      "require\\s+'jwt'\\s+[\\s\\S]*?"
    ])) as $all
    | ( $all | of(["(?P<PAYLOAD>\\S+)\\s+=\\s+\\{[\\s\\S]*?,\\s*password:[\\s\\S]*?,[\\s\\S]*?\\}\\s+[\\s\\S]*?\\s+JWT\\.encode\\((?P<PAYLOAD>\\S+),[\\s\\S]*?\\)"])
          | in_files_with($all | of(["require\\s+'jwt'\\s+[\\s\\S]*?"]))
        | finding("ruby-jwt-exposed-credentials";
            "Password is exposed through JWT token payload.") ) )
| report
