# rules: go-hardcoded-credential
# languages: go
# fixture: go/CWE-798.go
# from: CWE-798 (Use of Hard-coded Credentials), CWE-259, CWE-321
#
# A password in a Go file is in every binary built from it - strings(1) finds
# it in seconds - in every core dump, and in this repository's history for
# good, where deleting the line does not remove it. It is the same secret for
# every deployment, and changing it needs a release.
#
# The rule reads the name and then the value, and most of it is deciding what
# a value is not. A placeholder is not a credential, and neither is the name
# of the environment variable the real one comes from: `const TokenEnv =
# "PWRQ_MCP_TOKEN"` is the opposite of this bug, and reporting it is how a
# rule about secrets teaches people to skip it. Prose is subtracted for the
# same reason - a doc string beside a field called Token is not a token.
#
# A credential in a composite literal is only found when it is the literal's
# only field. The pattern's match is the literal, the matcher gives one match
# per node, and so only the first keyed element is ever bound; a rule written
# as `$T{$$$_, $NAME: $VALUE, $$$_}` looks like it reads every field and reads
# one. The narrow form is honest about what it finds.

"(?i)pass(word|wd|phrase)?$|secret|token|api_?key|auth_?key|access_?key|client_?secret"
  as $names
| "^\"[^\"]{8,}\"$" as $literal
| "(?i)^\"(?:changeme|change_me|password|secret|example|placeholder|redacted"
  + "|your[-_ ]|xxx|todo|fixme|<[^>]*>|\\$\\{|%s|test|dummy|sample)"
  as $placeholder
| "^\"[A-Z][A-Z0-9_]*\"$" as $envName
| "^\"[^\"]*[ ]" as $prose
| ["$NAME := $VALUE", "$NAME = $VALUE",
   "const $NAME = $VALUE", "var $NAME = $VALUE",
   "$T{$NAME: $VALUE}"] as $named
| scan_ast("*.go"; $named) as $all
| ( $all | of($named)
    | where_capture("NAME"; $names)
    | where_capture("VALUE"; $literal)
    | where_capture_not("VALUE"; $placeholder)
    | where_capture_not("VALUE"; $envName)
    | where_capture_not("VALUE"; $prose)
    | focus("VALUE") )
| finding("go-hardcoded-credential";
    "$VALUE is a credential written into the source; it is in every binary "
    + "built from this file and in this repository's history, and it cannot "
    + "be changed without a release")
| report
