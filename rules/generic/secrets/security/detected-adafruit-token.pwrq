# rules: detected-adafruit-token
# fixture: generic/detected-adafruit-token.txt
# from: CWE-798 (Use of Hard-coded Credentials)

. as $root
| ( ($root | scan_regex(["*"]; [
      "adafruit_(?P<SECRET>[A-Za-z0-9_\\-]{20,})"
    ])) as $all
    | ( $all | of(["adafruit_(?P<SECRET>[A-Za-z0-9_\\-]{20,})"])
          | where_capture_entropy("SECRET")
        | finding("detected-adafruit-token";
        "this is an adafruit token written into the source, so it is in every checkout "
        + "and every image built from one; read it from the environment, and "
        + "rotate this one because it has leaked") ) )
| report
