# rules: mvc-missing-antiforgery
# fixture: csharp/mvc-missing-antiforgery.cs
# from: csharp/dotnet/security/mvc-missing-antiforgery.yaml
#
# Method attributes break AST matching entirely - `[HttpPost]` before a
# method matches nothing, listed or not (class attributes work, method ones
# do not). The rule reads the attribute block as text instead: stacked
# attributes ending at a public IActionResult method, kept when one names a
# state-changing verb and none names ValidateAntiForgeryToken or Consumes.

. as $root
| ( ($root | scan_regex(["*.cs"]; [
      "(?P<ATTRS>(?:\\[[^\\]]+\\]\\s*)+)public\\s+IActionResult\\s+(?P<M>\\S+)\\((?P<P>[^)]*?)\\)\\s+\\{",
      "using\\s+Microsoft\\.AspNetCore\\.Mvc;"
    ])) as $all
    | ( $all | of(["(?P<ATTRS>(?:\\[[^\\]]+\\]\\s*)+)public\\s+IActionResult\\s+(?P<M>\\S+)\\((?P<P>[^)]*?)\\)\\s+\\{"])
          | where_capture("ATTRS"; "Http(Post|Put|Delete|Patch)")
          | where_capture_not("ATTRS"; "ValidateAntiForgeryToken|Consumes")
          | in_files_with($all | of(["using\\s+Microsoft\\.AspNetCore\\.Mvc;"]))
        | finding("mvc-missing-antiforgery";
            "$M is a state-changing MVC method that does not validate the antiforgery token or do strict content-type checking.") ) )
| report
