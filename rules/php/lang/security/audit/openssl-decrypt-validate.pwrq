# rules: openssl-decrypt-validate
# languages: php
# fixture: php/openssl-decrypt-validate.php
#
# The original subtracted validated forms with two-statement patterns, but
# holes do not span statements, so no guard ever matched and the rule never
# fired at all. Dataflow negation ("never checked") is not expressible here
# either - reaching sanitizers do not subtract - so the rule audits every
# openssl_decrypt call instead: each finding names a result the reviewer
# must confirm is compared against false.
# from: php/lang/security/audit/openssl-decrypt-validate.yaml

. as $root
| ( ($root | scan_ast(["*.php"]; [
      "openssl_decrypt($D,$$$_)"
    ])) as $all
    | ( $all | of(["openssl_decrypt($D,$$$_)"])
        | finding("openssl-decrypt-validate";
            "The function `openssl_decrypt` returns either a string of the decrypted data on success or `false` on failure.") ) )
| report
