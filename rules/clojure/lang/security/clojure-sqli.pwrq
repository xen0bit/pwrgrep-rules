# rules: clojure-sqli
# languages: clojure
# fixture: clojure/CWE-89.clj
# from: CWE-89 SQL Injection
#
# clojure.java.jdbc query with non-literal SQL.

["(clojure.java.jdbc/query $DB $SQL)", "(jdbc/query $DB $SQL)", "(jdbc/execute! $DB $SQL)"] as $sinks
| scan_ast(["*.clj"]; $sinks) as $all
| ($all | of($sinks) | where_capture_not("SQL"; "^\".*\"$") | finding("clojure-sqli";
        "this query is assembled from a value the caller chose, so a quote in "
        + "it ends the literal and the rest is SQL; bind the value as a "
        + "parameter instead"))
| report
