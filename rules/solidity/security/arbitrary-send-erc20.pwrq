# rules: arbitrary-send-erc20
# languages: solidity
# fixture: solidity/CWE-710-arbitrary-send.sol
# from: solidity/security/arbitrary-send-erc20.yaml

. as $root
| ( ($root | scan_regex(["*.sol"]; [
      "\\.transferFrom\\s*\\("
    ])) as $all
    | ( $all | of(["\\.transferFrom\\s*\\("])
        | finding("arbitrary-send-erc20";
            "msg.sender is not being used when calling erc20.transferFrom.") ) )
| report
