# rules: detect-mistral
# languages: python
# fixture: ai/python/detect-mistral.py
# from: ai/python/detect-mistral.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$CLIENT.chat($$$_,model=$$$_,$$$_)",
      "MistralClient($$$_)",
      "import mistralai"
    ])) as $all
    | ( $all | of(["import mistralai","MistralClient($$$_)","$CLIENT.chat($$$_,model=$$$_,$$$_)"])
        | finding("detect-mistral";
            "Possibly found usage of AI: Mistral") ) )
| report
