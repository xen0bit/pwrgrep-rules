# rules: java-insecure-deserialization
# languages: java
# fixture: java/CWE-502.java
# from: CWE-502 Deserialization of Untrusted Data

["$R.getParameter($K)", "$R.getHeader($K)", "$R.getInputStream()", "$R.getQueryString()", "$R.getCookies()"] as $outside
| ["new ObjectInputStream($IN).readObject()", "new ObjectInputStream($IN).readUnshared()"] as $sinks
| scan_ast("*.java"; $outside + $sinks) as $all
| ( $all | of($sinks) | focus("IN") | reaching($all | of($outside); []) )
| finding("java-insecure-deserialization"; "Insecure deserialization: $IN came from the request and reaches ObjectInputStream")
| report
