# rules: apex-hardcoded-secret
# languages: apex
# fixture: apex/CWE-798b.cls
# from: CWE-798 Use of Hard-coded Credentials
#
# Apex ships to the org; a String literal assigned to a credential-shaped name
# is visible to anyone with metadata access. The rule flags String $N = 'value'
# where $N looks like a secret and $V is a quoted literal containing a digit,
# excluding placeholders and env-var style names.

["String $N = $V;"] as $props
| "(?i)passw|secret|^.*api[_-]?key|token|credential|private[_-]?key|passphrase|auth" as $namesASecret
| "^'" as $isLiteral
| "[0-9]" as $hasDigit
| "\\$\\{|%[sd]|^'\\s*'$" as $isPlaceholder
| "^'[a-z]+://" as $isUrl
| "(?i)^'(?:changeme|change_me|password|secret|example|placeholder|redacted|your[-_ ]|xxx|todo|fixme|<[^>]*>|\\$\\{|%s|test|dummy|sample)" as $placeholderWord
| "^'[A-Z][A-Z0-9_]*'$" as $envName
| scan_ast(["*.cls"]; $props) as $all
| ($all | of($props)
    | where_capture("N"; $namesASecret)
    | where_capture("V"; $isLiteral)
    | where_capture("V"; $hasDigit)
    | where_capture_not("V"; $isPlaceholder)
    | where_capture_not("V"; $isUrl)
    | where_capture_not("V"; $placeholderWord)
    | where_capture_not("V"; $envName)
    | focus("V"))
| finding("apex-hardcoded-secret";
    "$N is a hardcoded credential compiled into Apex; store it in Protected Custom Settings or Named Credentials")
| report
