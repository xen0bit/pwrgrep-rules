# rules: detected-artifactory-password
# languages:
# fixture: generic/detected-artifactory-password.txt
# from: generic/secrets/security/detected-artifactory-password.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "\\b(?P<SECRET>AP[0-9A-F][A-Za-z0-9]{8,})\\b"
    ])) as $all
    | ( $all | of(["\\b(?P<SECRET>AP[0-9A-F][A-Za-z0-9]{8,})\\b"])
          | where_capture_not("SECRET"; "(?i)sha(1|2|3|118|256|512)")
          | where_capture_not("SECRET"; "(?i)----BE*GIN.*KEY")
          | where_capture_entropy("SECRET")
        | finding("detected-artifactory-password";
        "this is an artifactory password written into the source, so it is in every checkout "
        + "and every image built from one; read it from the environment, and "
        + "rotate this one because it has leaked") ) )
| report
