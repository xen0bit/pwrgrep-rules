# rules: php-hardcoded-credential
# languages: php
# fixture: php/CWE-798.php
# from: CWE-798 (Use of Hard-coded Credentials), CWE-259, CWE-321
#
# A secret written into a PHP file is in every deployment of that file, in the
# repository's history for as long as the repository exists, and in whatever
# backup of the document root somebody left readable. Rotating it needs a
# release. PHP makes it easy in a way other languages do not, because there is
# no build step to keep configuration out of the source.
#
# The name is what makes this checkable: nothing about "hunter2" says it is a
# password, the identifier beside it does. Which is where the false positives
# come from too, and two guards deal with the two kinds that turn up - an
# empty string, which is a placeholder, and a string with a conversion
# specifier in it, which is a format for a credential rather than one.
#
# Two of the four places a PHP credential is written have no pattern that
# reaches them. A property declaration - `private $password = '...'` - and an
# array entry - `'password' => '...'` - are both syntax the matcher has no
# reading of, so they are matched as text beside the two that are syntax, and
# the same guards run over both. Mixing the two searches in one rule is what
# scan_regex is for.
#
# The fourth kind is a placeholder that has the shape of a secret: PEAR's
# DB.php writes `$dsn['password'] = 'PASSWORD'` when asked to redact a
# connection string, and nothing about those eight characters says they are
# not a password. What says it is that they are all capitals - which no secret
# generator produces and every placeholder convention does - so a value that
# is nothing but capitals and underscores, or is one of the words people
# write when they mean "put yours here", is let through.
#
# A prompt is the third kind of false positive and cannot be guarded against
# by shape, only by length of sentence: `'Please enter your password'` is a message and
# `'hunter2trustno1'` is not, and the rule tells them apart by insisting a
# credential has no spaces in it. That is a real limit and it is the right way
# round - a secret with a space in it goes unreported, rather than every
# sentence about passwords being reported.

"(?i)pass(word|wd|phrase)?|pwd|secret|api_?key|auth_?key|access_?key|token"
  as $names
| "^(?:'[^']{6,}'|\"[^\"]{6,}\")$" as $literal
| "^['\"](?:[A-Z][A-Z0-9_]*"
  + "|(?i:change_?me|your[-_a-z]*|my[-_a-z]*|example[-_a-z]*|sample[-_a-z]*"
  + "|placeholder|redacted|hidden|unset|none|null|todo|test(?:ing)?"
  + "|password|passwd|secret|s3cr3t|xxx+|\\*+|\\.+))['\"]$" as $placeholder
| "'[^']{6,}'|\"[^\"]{6,}\"" as $literal_in_text
| "(?i:pass(word|wd|phrase)?|pwd|secret|api_?key|auth_?key|access_?key|token)"
  as $names_in_text
| ["$LHS = $VALUE;", "define($LHS, $VALUE)", "define($LHS, $VALUE, $$$_)",
   "const $LHS = $VALUE;"] as $bindings
| [ "(?:private|protected|public)(?:\\s+static)?\\s+"
    + "(?P<LHS>\\$\\w*" + $names_in_text + "\\w*)\\s*=\\s*"
    + "(?P<VALUE>" + $literal_in_text + ")",
    "(?P<LHS>['\"]\\w*" + $names_in_text + "\\w*['\"])\\s*=>\\s*"
    + "(?P<VALUE>" + $literal_in_text + ")" ] as $written
| ( scan_ast("*.php"; $bindings) + scan_regex("*.php"; $written) )
| where_capture("LHS"; $names)
| where_capture("VALUE"; $literal)
| where_capture_not("VALUE"; "%[sdfux]|\\s")
| where_capture_not("VALUE"; $placeholder)
| focus("VALUE")
| finding("php-hardcoded-credential";
    "$VALUE is a credential written into the source; it is in every deploy of "
    + "this file and in the repository's history, and changing it needs a "
    + "release")
| report
