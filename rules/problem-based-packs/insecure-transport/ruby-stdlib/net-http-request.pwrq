# rules: net-http-request
# languages: ruby
# fixture: problem-based-packs/ruby-net-http-request.rb
# from: problem-based-packs/insecure-transport/ruby-stdlib/net-http-request.yaml

. as $root
| ( ($root | scan_ast(["*.rb"]; [
      "$URI = URI($URL)\n$$$_\nNet::HTTP.$FUNC($URI, $$$_)",
      "$URI = URI($URL)\n$$$_\nNet::HTTP::$FUNC.new $URI",
      "Net::HTTP.$FUNC(URI($URL), $$$_)"
    ])) as $all
    | ( $all | of(["$URI = URI($URL)\n$$$_\nNet::HTTP::$FUNC.new $URI","$URI = URI($URL)\n$$$_\nNet::HTTP.$FUNC($URI, $$$_)","Net::HTTP.$FUNC(URI($URL), $$$_)"])
          | where_capture("URL"; "http://")
          | where_capture_not("URL"; "127\\.0\\.0\\.1")
          | where_capture_not("URL"; "localhost")
          | where_capture("FUNC"; "^(?:([gG]et|post_form|[pP]ost|get_response|get_print|Head|Patch|Put|Proppatch|Lock|Unlock|Options|Propfind|Delete|Move|Copy|Trace|Mkcol))")
        | finding("net-http-request";
            "Checks for requests sent to http:// URLs.") ) )
| report
