# rules: allow-privilege-escalation-true
# languages: yaml
# fixture: yaml/k8s-allow-privilege-escalation-true.yaml
#
# The scaffolding spans never enclose their targets (and the AST capture of a
# bare true never compiled), so the rule never fired. Rewritten as a direct
# key match.
# from: yaml/kubernetes/security/allow-privilege-escalation-true.yaml

. as $root
| ( ($root | scan_regex(["*.yaml","*.yml"]; [
      "allowPrivilegeEscalation\\s*:\\s*true"
    ])) as $all
    | ( $all | of(["allowPrivilegeEscalation\\s*:\\s*true"])
        | finding("allow-privilege-escalation-true";
            "In Kubernetes, each pod runs in its own isolated environment with its own set of security policies.") ) )
| report
