# rules: url-rewriting
# languages: java
# fixture: java/url-rewriting.java
# from: java/lang/security/audit/url-rewriting.yaml
#
# Every shape was a method scaffold with statement gaps that match nothing,
# so the rule never fired. The finding is the encoding call itself now.

. as $root
| ( ($root | scan_ast(["*.java"]; [
      "$RES.encodeRedirectURL($URL)",
      "$RES.encodeRedirectUrl($URL)",
      "$RES.encodeURL($URL)",
      "$RES.encodeUrl($URL)"
    ])) as $all
    | ( $all | of(["$RES.encodeRedirectURL($URL)","$RES.encodeRedirectUrl($URL)","$RES.encodeURL($URL)","$RES.encodeUrl($URL)"])
        | finding("url-rewriting";
            "URL rewriting has significant security risks.") ) )
| report
