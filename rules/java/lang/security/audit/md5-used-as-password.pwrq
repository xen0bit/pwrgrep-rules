# rules: md5-used-as-password
# languages: java
# fixture: java/md5-used-as-password.java
# from: java/lang/security/audit/md5-used-as-password.yaml
#
# The digest gate trailed a statement gap that matches nothing, and the
# sink never focused its argument, so no flow was ever joined. Both are
# repaired.

. as $root
| ( ($root | scan_ast(["*.java"]; [
      "$MD.digest($$$_);",
      "$MODEL.$METHOD($ARG);",
      "$METHOD($ARG);",
      "$TYPE $MD = MessageDigest.getInstance(\"MD5\");"
    ])) as $all
    | ( (($all | of(["$MODEL.$METHOD($ARG);", "$METHOD($ARG);"]) | focus("ARG")
          | where_capture("METHOD"; "^(?:(?i)(.*password.*))")))
          | reaching((($all | of(["$MD.digest($$$_);"])
          | in_files_with($all | of(["$TYPE $MD = MessageDigest.getInstance(\"MD5\");"]))));
              ([]))
        | finding("md5-used-as-password";
            "It looks like MD5 is used as a password hash.") ) )
| report
