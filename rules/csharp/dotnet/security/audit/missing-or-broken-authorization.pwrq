# rules: missing-or-broken-authorization
# languages: c_sharp
# fixture: csharp/missing-or-broken-authorization.cs
#
# The class linchpins were bodies written `$$$` (a statement literally named
# `$$$`) and the MVC `using` ended in a dead gap. Both read whole bodies and
# plain imports now.
# from: csharp/dotnet/security/audit/missing-or-broken-authorization.yaml

. as $root
| ( ($root | scan_ast(["*.cs"]; [
      "[AllowAnonymous]\npublic class $CLASS : Controller {\n  $$$BODY\n}",
      "[Authorize(Policy = $$$_)]\npublic class $CLASS : Controller {\n  $$$BODY\n}",
      "[Authorize(Roles = $$$_)]\npublic class $CLASS : Controller {\n  $$$BODY\n}",
      "[Authorize]\npublic class $CLASS : Controller {\n  $$$BODY\n}",
      "public class $CLASS : Controller {\n  $$$BODY\n}",
      "using Microsoft.AspNetCore.Mvc;"
    ])) as $all
    | ( $all | of(["public class $CLASS : Controller {\n  $$$BODY\n}"])
          | in_files_with($all | of(["using Microsoft.AspNetCore.Mvc;"]))
          | not_at($all | of(["[AllowAnonymous]\npublic class $CLASS : Controller {\n  $$$BODY\n}"]))
          | not_at($all | of(["[Authorize]\npublic class $CLASS : Controller {\n  $$$BODY\n}"]))
          | not_at($all | of(["[Authorize(Roles = $$$_)]\npublic class $CLASS : Controller {\n  $$$BODY\n}"]))
          | not_at($all | of(["[Authorize(Policy = $$$_)]\npublic class $CLASS : Controller {\n  $$$BODY\n}"]))
        | finding("missing-or-broken-authorization";
            "Anonymous access shouldn't be allowed unless explicit by design.") ) )
| report
