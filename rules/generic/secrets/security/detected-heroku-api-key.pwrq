# rules: detected-heroku-api-key
# fixture: generic/detected-heroku-api-key.txt
# from: generic/secrets/security/detected-heroku-api-key.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "[hH][eE][rR][oO][kK][uU].*[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}"
    ])) as $all
    | ( $all | of(["[hH][eE][rR][oO][kK][uU].*[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}"])
        | finding("detected-heroku-api-key";
        "this is a heroku api key written into the source, so it is in every checkout "
        + "and every image built from one; read it from the environment, and "
        + "rotate this one because it has leaked") ) )
| report
