# rules: prototype-pollution-assignment
# languages: javascript, typescript
# fixture: javascript/prototype-pollution-assignment.js
# from: javascript/lang/security/audit/prototype-pollution/prototype-pollution-assignment.yaml
#
# Repair: dead as written. The sink `$X[$B] = $$$` never matched with a bare
# hole in value position, the literal-value exclusion `'$$$'` read its hole
# as any value and subtracted every assignment, and
# `in_files_without("if ...")` dropped every file containing an `if`. The
# sink names its value hole, the exclusion keeps only quoted text, and the
# `if` gates are gone; the index-read gate (now with const/let/var spellings) and loop guards stay.

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$X = $SMTH[$A]\n$$$_",
      "$X.forEach(function $NAME($OBJ, $B,$$$_) {$$$_})",
      "$X[$B] = $LIT",
      "$X[$B] = $VAL",
      "const $X = $SMTH[$A]",
      "let $X = $SMTH[$A]",
      "var $X = $SMTH[$A]",
      "for($B = $S; $$$_; $$$_) {$$$_}",
      "for(var $B = $S; $$$_; $$$_) {$$$_}"
    ])) as $all
    | ( $all | of(["$X[$B] = $VAL"])
          | not_at(($all | of(["$X[$B] = $LIT"]) | where_capture("LIT"; "^[\"']")))
          | in_files_with(($all | of(["$X = $SMTH[$A]\n$$$", "const $X = $SMTH[$A]", "let $X = $SMTH[$A]", "var $X = $SMTH[$A]"])))
          | outside($all | of(["for(var $B = $S; $$$_; $$$_) {$$$_}"]))
          | outside($all | of(["for($B = $S; $$$_; $$$_) {$$$_}"]))
          | outside($all | of(["$X.forEach(function $NAME($OBJ, $B,$$$_) {$$$_})"]))
        | finding("prototype-pollution-assignment";
            "Possibility of prototype polluting assignment detected.") ) )
| report
