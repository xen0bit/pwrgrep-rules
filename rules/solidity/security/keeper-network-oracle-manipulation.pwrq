# rules: keeper-network-oracle-manipulation
# languages: solidity
# fixture: solidity/keeper-network-oracle-manipulation.sol
#
# Statement and expression fragments never match in the solidity grammar
# - only whole functions (and regex) do - so the original AST pattern could
# never fire. Rewritten as a regex over the text.
# from: solidity/security/keeper-network-oracle-manipulation.yaml

. as $root
| ( ($root | scan_regex(["*.sol"]; [
      "\\.current\\s*\\("
    ])) as $all
    | ( $all | of(["\\.current\\s*\\("])
        | finding("keeper-network-oracle-manipulation";
            "Keep3rV2.current() call has high data freshness, but it has low security, an exploiter simply needs to manipulate 2 data points to be able to impact the feed.") ) )
| report
