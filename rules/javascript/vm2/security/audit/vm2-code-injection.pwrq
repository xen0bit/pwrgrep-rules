# rules: vm2-code-injection
# languages: javascript, typescript
# fixture: javascript/vm2-code-injection.js
# from: javascript/vm2/security/audit/vm2-code-injection.yaml
#
# Repair: the statement-sequence shapes needed exact bare-`var` spellings in one statement list, `in_files_without("..."` dropped every file with a string, and the literal exclusions read holes as anything. Sinks are selected first with file-level gates and function-argument sources.

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "($$$_, $FUNC, $$$_) => {$$$_}",
      "($FUNC) => {$$$_}",
      "$VM.run($CODE)",
      "new VM($OPTS).run($CODE)",
      "new NodeVM($OPTS).run($CODE)",
      "new VMScript($CODE)","new $LIB.VMScript($CODE)",
      "$VM = new VM($$$_)",
      "const $VM = new VM($$$_)",
      "$VM = new NodeVM($$$_)",
      "const $VM = new NodeVM($$$_)",
      "function ($$$_, $FUNC, $$$_) {$$$_}",
      "function $F($$$_, $FUNC, $$$_) {$$$_}",
      "$V2 = require('vm2')",
      "const $V2 = require('vm2')"
    ])) as $all
    | ( (($all | of(["$VM.run($CODE)", "new VM($OPTS).run($CODE)", "new NodeVM($OPTS).run($CODE)", "new VMScript($CODE)","new $LIB.VMScript($CODE)"])
          | not_at(($all | of(["$VM.run($CODE)", "new VM($OPTS).run($CODE)", "new NodeVM($OPTS).run($CODE)", "new VMScript($CODE)","new $LIB.VMScript($CODE)"]) | where_capture("CODE"; "^[\"'].*[\"']$")))
          | focus("CODE"))
          | in_files_with(($all | of(["$VM = new VM($$$_)", "const $VM = new VM($$$_)", "$VM = new NodeVM($$$_)", "const $VM = new NodeVM($$$_)", "$V2 = require('vm2')", "const $V2 = require('vm2')"])))
          | reaching(((($all | of(["function ($$$_, $FUNC, $$$_) {$$$_}","function $F($$$_, $FUNC, $$$_) {$$$_}"]))
          + ($all | of(["($FUNC) => {$$$_}","($$$_, $FUNC, $$$_) => {$$$_}"]))
          | focus("FUNC")));
              ([]))
        | finding("vm2-code-injection";
            "Make sure that unverified user data can not reach `vm2`.") ) ))
| report
