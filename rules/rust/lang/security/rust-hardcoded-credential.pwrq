# rules: rust-hardcoded-credential
# languages: rust
# fixture: rust/CWE-798.rs
# from: CWE-798 (Hardcoded Credentials)

"(?i)pass(word|wd|phrase)?$|secret|token|api_?key|auth_?key|access_?key|client_?secret" as $names
| "^\"[^\"]{8,}\"$" as $literal
| "(?i)^\"(?:changeme|change_me|password|secret|example|placeholder|redacted|your[-_ ]|xxx|todo|fixme|<[^>]*>|\\$\\{|%s|test|dummy|sample)" as $placeholder
| "^\"[A-Z][A-Z0-9_]*\"$" as $envName
| "^\"[^\"]*[ ]" as $prose
| ["let $NAME = $VALUE;", "const $NAME: &str = $VALUE;", "static $NAME: &str = $VALUE;"] as $named
| scan_ast("*.rs"; $named) as $all
| ( $all | of($named) | where_capture("NAME"; $names) | where_capture("VALUE"; $literal) | where_capture_not("VALUE"; $placeholder) | where_capture_not("VALUE"; $envName) | where_capture_not("VALUE"; $prose) | focus("VALUE") )
| finding("rust-hardcoded-credential"; "$VALUE is a credential written into the source")
| report
