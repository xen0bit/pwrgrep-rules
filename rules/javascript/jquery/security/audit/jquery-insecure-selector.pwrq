# rules: jquery-insecure-selector
# languages: javascript, typescript
# fixture: javascript/jquery-insecure-selector.js
# from: javascript/jquery/security/audit/jquery-insecure-selector.yaml
#
# Repair: the `where_capture_ast(P; $HOLE)` comparisons read the hole as any
# value, so every `$(...)` inside a function with parameters matched,
# including static selectors like `$('#out')`. They now require a bare
# identifier.

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$STR + $PWRQDEEP1",
      "$($PWRQDEEP1)",
      "$PWRQDEEP1 + $STR",
      "$(document)",
      "$(this)",
      "$(window)",
      "$JQUERY.each(function($INDEX, $Y) {\n  $$$_\n})",
      "$X = $PWRQDEEP1;\n$$$_\n$($PWRQDEEP2);",
      "function $FUNC($$$_, $Y, $$$_) {\n  $$$_\n}",
      "function $FUNC($$$_,$Z,$$$_) {\n  $$$_\n  $Y = $PWRQDEEP1;\n  $$$_\n}",
      "function ($$$_, $Y, $$$_) {\n  $$$_\n}",
      "function ($$$_,$Z,$$$_) {\n  $$$_\n  $Y = $PWRQDEEP1;\n  $$$_\n}"
    ])) as $all
    | ( ($all | of(["$($PWRQDEEP1)"])
          | where_capture_ast("PWRQDEEP1"; "window"))
          + ($all | of(["$($PWRQDEEP1)"])
          | where_capture_ast("PWRQDEEP1"; "location"))
          + ($all | of(["$X = $PWRQDEEP1;\n$$$_\n$($PWRQDEEP2);"])
          | where_capture_ast("PWRQDEEP1"; "window")
          | where_capture("PWRQDEEP2"; "^[A-Za-z_$][A-Za-z0-9_$]*$")
          | focus("X"))
          + ($all | of(["$X = $PWRQDEEP1;\n$$$_\n$($PWRQDEEP2);"])
          | where_capture_ast("PWRQDEEP1"; "location")
          | where_capture("PWRQDEEP2"; "^[A-Za-z_$][A-Za-z0-9_$]*$")
          | focus("X"))
          + (($all
          | within($all | of(["function $FUNC($$$_, $Y, $$$_) {\n  $$$_\n}"])))
          + ($all
          | within($all | of(["function ($$$_, $Y, $$$_) {\n  $$$_\n}"])))
          + ($all
          | within($all | of(["function $FUNC($$$_,$Z,$$$_) {\n  $$$_\n  $Y = $PWRQDEEP1;\n  $$$_\n}"])
          | where_capture("PWRQDEEP1"; "^[A-Za-z_$][A-Za-z0-9_$]*$")))
          + ($all
          | within($all | of(["function ($$$_,$Z,$$$_) {\n  $$$_\n  $Y = $PWRQDEEP1;\n  $$$_\n}"])
          | where_capture("PWRQDEEP1"; "^[A-Za-z_$][A-Za-z0-9_$]*$")))
          | at_same_place((($all | of(["$($PWRQDEEP1)"])
          | where_capture("PWRQDEEP1"; "^[A-Za-z_$][A-Za-z0-9_$]*$"))
          + ($all | of(["$STR + $PWRQDEEP1"])
          | where_capture("PWRQDEEP1"; "^[A-Za-z_$][A-Za-z0-9_$]*$") | where_capture("STR"; "^[\"']"))
          + ($all | of(["$PWRQDEEP1 + $STR"])
          | where_capture("PWRQDEEP1"; "^[A-Za-z_$][A-Za-z0-9_$]*$") | where_capture("STR"; "^[\"']"))))
          | outside($all | of(["$JQUERY.each(function($INDEX, $Y) {\n  $$$_\n})"]))
          | focus("Y"))
          | not_at($all | of(["$(window)"]))
          | not_at($all | of(["$(document)"]))
          | not_at($all | of(["$(this)"]))
        | finding("jquery-insecure-selector";
            "User controlled data in a `$(...)` is an anti-pattern that can lead to XSS vulnerabilities") ) )
| report
