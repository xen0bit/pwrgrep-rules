# rules: scala-20-validation
# languages: scala
# fixture: scala/CWE-20.scala
# from: CWE-20 (Improper Input Validation) — request query without validation
#
# request query parameter without validation reaches SQL/exec.
# The rule tracks getParameter reaching prepareStatement and excludes regex allowlist via where_capture_not.

["$R.getParameter($$$_)", "$R.getQueryString()", "$R.getHeader($$$_)"] as $src
| ["$C.prepareStatement($Q)", "$S.executeQuery($Q)", "$S.executeUpdate($Q)", "$S.execute($Q)", "Runtime.getRuntime().exec($Q)"] as $sink
| scan_ast("*.scala"; $src + $sink) as $all
| ( $all | of($sink) | focus("Q") | reaching($all | of($src); []) | where_capture_not("Q"; "allowlist|whitelist|regex|Pattern|matches") )
| finding("scala-20-validation"; "Improper validation: $Q from request query reaches SQL/exec without regex allowlist")
| report
