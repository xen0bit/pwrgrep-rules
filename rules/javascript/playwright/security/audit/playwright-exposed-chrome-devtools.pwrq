# rules: playwright-exposed-chrome-devtools
# languages: javascript, typescript
# fixture: javascript/playwright-exposed-chrome-devtools.js
# from: javascript/playwright/security/audit/playwright-exposed-chrome-devtools.yaml
#
# Repair: dead as written. `where_text` filtered the `require` matches
# themselves, whose text never contains a debugging flag. The flags are now
# matched as regexes over the file and gated on the `playwright` require.

. as $root
| (($root | scan_regex(["*.js","*.ts"]; [
      "--remote-debugging-address",
      "--remote-debugging-port",
      "--remote-debugging-socket-name",
      "--remote-debugging-targets"
    ])) as $flags | (($root | scan_ast(["*.js","*.ts"]; [
      "$P = require('playwright')\n$$$",
      "const $P = require('playwright')",
      "require('playwright')"
    ])) as $all | ($flags
      | in_files_with(($all | of(["require('playwright')"]) + ($all | of(["const $P = require('playwright')"])) + ($all | of(["$P = require('playwright')\n$$$"]))))
      | finding("playwright-exposed-chrome-devtools";
          "Remote debugging protocol does not perform any authentication, so exposing it too widely can be a security risk."))))
| report
