# rules: spring-actuator-fully-enabled-yaml
# fixture: java/spring-actuator-fully-enabled-yaml.yaml
# from: java/spring/security/audit/spring-actuator-fully-enabled-yaml.yaml
#
# The management context ended in an open wildcard, so it matched almost
# nothing and no include was ever within it. It runs over the indented
# exposure block now.

. as $root
| ( ($root | scan_regex(["*.yaml"]; [
      "include:\\s+\"\\*\"",
      "management:\\s+[\\s\\S]*?\\s+endpoints:\\s+[\\s\\S]*?\\s+web:\\s+[\\s\\S]*?\\s+exposure:\\s*\\n((?:[ ]+[^\\n]*\\n)+)"
    ])) as $all
    | ( $all | of(["include:\\s+\"\\*\""])
          | within($all | of(["management:\\s+[\\s\\S]*?\\s+endpoints:\\s+[\\s\\S]*?\\s+web:\\s+[\\s\\S]*?\\s+exposure:\\s*\\n((?:[ ]+[^\\n]*\\n)+)"]))
        | finding("spring-actuator-fully-enabled-yaml";
            "Spring Boot Actuator is fully enabled.") ) )
| report
