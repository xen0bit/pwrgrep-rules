# rules: slow-pattern-top-ellipsis
# languages: yaml
# fixture: yaml/semgrep-slow-top-ellipsis.yaml
#
# Block-scalar values are invisible to AST patterns (only the key matched),
# so the sandwich form never fired. Rewritten as a regex over a pattern
# block whose first line is an ellipsis. Both globs are scanned.
# from: yaml/semgrep/slow-pattern-top-ellipsis.yaml
. as $root
| ( ($root | scan_regex(["*.yaml","*.yml"]; [
      "pattern:\\s*\\|\\s*\\n\\s*\\.\\.\\."
    ])) as $all
    | ( $all | of(["pattern:\\s*\\|\\s*\\n\\s*\\.\\.\\."])
        | finding("slow-pattern-top-ellipsis";
            "Using the ellipsis operator `...` at the top of the pattern drastically slows down the rule performance.") ) )
| report
