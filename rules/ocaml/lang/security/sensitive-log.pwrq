# rules: ocaml-sensitive-log
# languages: ocaml
# fixture: ocaml/CWE-532.ml
# from: CWE-532 Insertion of Sensitive Information into Log File

["print_endline $MSG", "print_string $MSG", "Logs.info $MSG", "Logs.warn $MSG"] as $sinks
| "(?i)password|passwd|pwd|secret|api_?key|token" as $names
| scan_ast(["*.ml"]; $sinks) as $all
| ($all | of($sinks) | where_capture("MSG"; $names))
| finding("ocaml-sensitive-log";
    "sensitive data is written to the log; it will be in log files and "
    + "shipped to any log collector — redact it")
| report
