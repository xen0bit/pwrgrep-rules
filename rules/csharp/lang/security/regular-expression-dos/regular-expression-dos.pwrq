# rules: regular-expression-dos
# languages: c_sharp
# fixture: csharp/regular-expression-dos.cs
# from: csharp/lang/security/regular-expression-dos/regular-expression-dos.yaml
#
# The translated method shapes span `[\s\S]*?` from a signature to a Match
# call, which crosses method boundaries - one method's header plus the next
# method's body reported as one finding, twice. The rule reads the timeout
# decision where it is made instead: one- and two-argument constructions and
# static calls, minus any argument list naming a TimeSpan. Named holes pin
# the arity, so each shape is read at exactly the overloads it names.

["using System.Text.RegularExpressions;"] as $using
| ["new Regex($P)", "Regex.Match($X, $P)", "new Regex($P, $O)",
   "Regex.Match($X, $P, $O)"] as $sinks
| scan_ast("*.cs"; $using + $sinks) as $all
| ( (($all | of(["new Regex($P)", "Regex.Match($X, $P)"])
      | where_capture_not("P"; "TimeSpan"))
      + ($all | of(["new Regex($P, $O)", "Regex.Match($X, $P, $O)"])
      | where_capture_not("O"; "TimeSpan")))
      | in_files_with($all | of($using))
    | finding("regular-expression-dos";
        "When using `System.Text.RegularExpressions` to process untrusted input, pass a timeout.") )
| report
