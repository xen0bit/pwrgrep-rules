# rules: build-gradle-password-hardcoded
# languages: kotlin
# fixture: kotlin/CWE-798-gradle.kts
# from: kotlin/gradle/security/build-gradle-password-hardcoded.yaml
#
# A signing password or a repository credential written into the build script
# is a credential in the repository, in every clone of it and in every CI log
# that echoes the file. `env["KEY"] ?: "hunter2"` is the shape it takes: the
# environment variable is the intended path and the literal after the elvis is
# the fallback somebody added to make a local build work.
#
# Two things were wrong with the rule as translated and either one on its own
# made it dead.
#
# It searched `*.kt`, and a Gradle Kotlin build script is `build.gradle.kts`.
# The grammar reads both - `.kts` is one of Kotlin's extensions in this build -
# but the glob never offered it a file.
#
# And it was written `$PASS = env[...] ?: $VALUE`, an assignment, where a
# Gradle script writes `val signingPassword = ...`. A declaration is a
# different node, so even pointed at the right file it would have found
# nothing.
#
# The fallback has to be a literal. `env["A"] ?: env["B"]` and
# `env["A"] ?: error("set it")` are both the correct shape - a second place to
# look, or a refusal - and neither is a password.

["val $PASS = $E[$K] ?: $VALUE", "var $PASS = $E[$K] ?: $VALUE",
 "val $PASS: $T = $E[$K] ?: $VALUE", "$PASS = $E[$K] ?: $VALUE",
 "val $PASS = $E.get($K) ?: $VALUE", "$PASS = $E.get($K) ?: $VALUE"] as $fallbacks
| "(?i)passw|secret|token|credential|api[_-]?key|keystore" as $namesASecret
| "^\"" as $isALiteral
| "^\"\\s*\"$" as $isEmpty
| scan_ast(["*.kts", "*.kt"]; $fallbacks) as $all
| ( $all | of($fallbacks)
    | where_capture("PASS"; $namesASecret)
    | where_capture("VALUE"; $isALiteral)
    | where_capture_not("VALUE"; $isEmpty)
    | focus("VALUE") )
| finding("build-gradle-password-hardcoded";
    "$PASS falls back to a value written into the build script, so it is in "
    + "the repository and in every clone of it")
| report
