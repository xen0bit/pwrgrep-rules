# rules: laravel-cookie-same-site
# languages:
# fixture: php/laravel-cookie-same-site.php
#
# The array patterns only ever match a single item, so the within/outside
# guards comparing whole-array spans could never subtract anything: every
# session array with a cookie entry was flagged. Rewritten as one regex over
# the config array with where_text_not guards for the remediated keys (flat
# arrays only). `# languages:` is empty because the query is text-only.
# from: php/laravel/security/laravel-cookie-same-site.yaml

. as $root
| ( ($root | scan_regex(["*.php"]; [
      "return\\s+\\[[\\s\\S]*?'cookie'\\s*=>\\s*env\\([\\s\\S]*?\\]"
    ])) as $all
    | ( $all | of(["return\\s+\\[[\\s\\S]*?'cookie'\\s*=>\\s*env\\([\\s\\S]*?\\]"])
          | where_text_not("'same_site'\\s*=>\\s*'lax'")
          | where_text_not("'same_site'\\s*=>\\s*'strict'")
          | where_text_not("'same_site'\\s*=>\\s*env\\(")
        | finding("laravel-cookie-same-site";
            "Found a configuration file where the same_site attribute is not set to 'lax' or 'strict'.") ) )
| report
