# rules: insecure-innerhtml
# languages: javascript, typescript
# fixture: javascript/insecure-innerhtml.js
# from: javascript/browser/security/insecure-innerhtml.yaml
#
# The static exclusion read its hole as any value and subtracted every
# assignment. It keeps only the literal spelling now.

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$EL.innerHTML = $H;",
      "$EL.innerHTML = $HTML;"
    ])) as $all
    | ( $all | of(["$EL.innerHTML = $HTML;"])
          | not_at(($all | of(["$EL.innerHTML = $H;"]) | where_capture("H"; "^[\"']")))
        | finding("insecure-innerhtml";
            "User controlled data in a `$EL.innerHTML` is an anti-pattern that can lead to XSS vulnerabilities") ) )
| report
