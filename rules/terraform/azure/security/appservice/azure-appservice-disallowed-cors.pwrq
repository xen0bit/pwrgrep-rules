# rules: azure-appservice-disallowed-cors
# fixture: terraform/azure-appservice-disallowed-cors.tf
#
# The `allowed_origins\s+=\s+[\s\S]*?` container matches with an empty tail, ending at the `=`, so the `["*"]` literal after it is never `within` it. The tail now swallows the bracketed list into a (?P<V>...) capture kept by guard, so multi-origin lists match too; the exact-literal alternative is dropped.
# from: terraform/azure/security/appservice/azure-appservice-disallowed-cors.yaml

. as $root
| ( ($root | scan_regex(["*.tf"]; [
      "(?P<RESOURCE>\\S+)\\s+\"azurerm_app_service\"\\s+\"[\\s\\S]*?\"\\s+\\{\\s+[\\s\\S]*?\\s+\\}",
      "allowed_origins\\s*=\\s*(?P<V>\\[[^\\]]*\\])"
    ])) as $all
    | ( $all | of(["allowed_origins\\s*=\\s*(?P<V>\\[[^\\]]*\\])"])
          | where_capture("V"; "\\\"\\*\\\"")
          | within($all | of(["(?P<RESOURCE>\\S+)\\s+\"azurerm_app_service\"\\s+\"[\\s\\S]*?\"\\s+\\{\\s+[\\s\\S]*?\\s+\\}"]))
        | finding("azure-appservice-disallowed-cors";
            "Ensure that CORS disallows every resource to access app services") ) )
| report
