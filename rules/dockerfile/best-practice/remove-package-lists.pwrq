# rules: remove-package-lists
# languages: dockerfile
# fixture: dockerfile/remove-package-lists.dockerfile
#
# The ported query paired a multi-line RUN span with at_same_place against a
# narrower match starting at `apt-get`, so the two never coincided and the
# rule never fired. Rewritten as a single-line regex with a where_text_not
# guard for the `rm -rf /var/lib/apt/lists` remediation. Globs widened to
# cover *.dockerfile fixtures too.
# from: dockerfile/best-practice/remove-package-lists.yaml

. as $root
| ( ($root | scan_regex(["Dockerfile*","*.dockerfile"]; [
      "RUN[^\\n]*apt-get\\s+update[^\\n]*"
    ])) as $all
    | ( $all | of(["RUN[^\\n]*apt-get\\s+update[^\\n]*"])
          | where_text_not("rm -rf /var/lib/apt/lists")
        | finding("remove-package-lists";
            "The package lists were not deleted after running 'apt-get update', which increases the size of the image.") ) )
| report
