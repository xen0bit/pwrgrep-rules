# rules: grpc-server-insecure-connection
# languages: go
# fixture: go/grpc-server-insecure-connection.go
# from: go/grpc/security/grpc-server-insecure-connection.yaml
#
# The translated sources listed grpc.Creds($$$_) beside the insecure
# spellings, so a server built WITH credentials reached its own sink and the
# secure form fired. Creds is not a source of insecurity and is not read as
# one; only the option literal and the bare constructor remain.

. as $root
| ( ($root | scan_ast(["*.go"]; [
      "grpc.NewServer($OPT, $$$_)",
      "grpc.NewServer()",
      "grpc.ServerOption{ $$$_ }"
    ])) as $all
    | ( (($all | of(["grpc.NewServer($OPT, $$$_)"]))
              + ($all | of(["grpc.NewServer()"])))
          | reaching((($all | of(["grpc.ServerOption{ $$$_ }"]))
              + ($all | of(["grpc.NewServer()"])));
              ([]))
        | finding("grpc-server-insecure-connection";
            "Found an insecure gRPC server without 'grpc.Creds()' or options with credentials.") ) )
| report
