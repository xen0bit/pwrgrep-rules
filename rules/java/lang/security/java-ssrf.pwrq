# rules: java-ssrf
# languages: java
# fixture: java/CWE-918-2.java
# from: CWE-918 Server-Side Request Forgery

["$R.getParameter($K)", "$R.getHeader($K)", "$R.getQueryString()", "$R.getCookies()"] as $outside
| ["new URL($URL)", "new URL($URL).openConnection()", "new URL($URL).openStream()", "URI.create($URL)", "new HttpGet($URL)", "new HttpPost($URL)"] as $sinks
| scan_ast("*.java"; $outside + $sinks) as $all
| ( $all | of($sinks) | focus("URL") | reaching($all | of($outside); []) )
| finding("java-ssrf"; "SSRF: $URL came from the request and controls the host this server connects to")
| report
