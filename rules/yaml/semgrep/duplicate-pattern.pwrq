# rules: duplicate-pattern
# languages: yaml
# fixture: yaml/semgrep-duplicate-pattern.yaml
#
# Duplicate detection needs value equality across two matches, which the
# ported scaffolding (reusing one capture name for both) never established.
# Rewritten as one regex over a pattern pair with where_same.
# from: yaml/semgrep/duplicate-pattern.yaml

. as $root
| ( ($root | scan_regex(["*.yaml","*.yml"]; [
      "-\\s+pattern:\\s+(?P<A>\\S+)[\\s\\S]*?-\\s+pattern:\\s+(?P<B>\\S+)"
    ])) as $all
    | ( $all | of(["-\\s+pattern:\\s+(?P<A>\\S+)[\\s\\S]*?-\\s+pattern:\\s+(?P<B>\\S+)"])
          | where_same("A"; "B")
          | focus("A")
        | finding("duplicate-pattern";
            "Two identical pattern clauses were detected.") ) )
| report
