# rules: code-string-concat
# languages: javascript, typescript
# fixture: javascript/code-string-concat.js
# from: javascript/lang/security/audit/code-string-concat.yaml
#
# Repair: dead as written. The `function $$$_ (...)` wrappers matched only
# named declarations and `at_same_place` needed exact span coincidence, so
# no source ever reached the `eval` sink. Sources are now taken `within`
# fixed anon/named wrappers, and the Next.js router shapes gate file-level.

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$APP.$METHOD($$$_, function $FUNC($REQ, $RES) {$$$_})",
      "$APP.$METHOD($$$_, function $FUNC($REQ, $RES, $NEXT) {$$$_})",
      "$APP.$METHOD($$$_, function ($REQ, $RES) {$$$_})",
      "$APP.$METHOD($$$_, function ($REQ, $RES, $NEXT) {$$$_})",
      "$IMPORT().query.$VALUE",
      "$REQ.body",
      "$REQ.cookies",
      "$REQ.headers",
      "$REQ.params",
      "$REQ.query",
      "$ROUTER = $IMPORT()\n$$$",
      "$ROUTER.query.$VALUE",
      "const $ROUTER = $IMPORT()",
      "eval($CODE)",
      "function ($REQ, $RES) {$$$_}",
      "function $FUNC($REQ, $RES) {$$$_}",
      "function ($REQ, $RES, $NEXT) {$$$_}",
      "function $FUNC($REQ, $RES, $NEXT) {$$$_}",
      "import $IMPORT from 'next/router'\n$$$"
    ])) as $all
    | ( (($all | of(["eval($CODE)"])
          | focus("CODE")))
          | reaching(((($all | of(["$REQ.query","$REQ.body","$REQ.params","$REQ.cookies","$REQ.headers"]))
          | within((($all | of(["function ($REQ, $RES) {$$$_}","function $FUNC($REQ, $RES) {$$$_}","function ($REQ, $RES, $NEXT) {$$$_}","function $FUNC($REQ, $RES, $NEXT) {$$$_}"]))
          + ((($all | of(["$APP.$METHOD($$$_, function $FUNC($REQ, $RES) {$$$_})","$APP.$METHOD($$$_, function ($REQ, $RES) {$$$_})"]))
          + ($all | of(["$APP.$METHOD($$$_, function $FUNC($REQ, $RES, $NEXT) {$$$_})","$APP.$METHOD($$$_, function ($REQ, $RES, $NEXT) {$$$_})"])))
          | where_capture("METHOD"; "^(get|post|put|head|delete|options)$")))))
              + (($all | of(["$ROUTER.query.$VALUE","$IMPORT().query.$VALUE"])
          | in_files_with(($all | of(["$ROUTER = $IMPORT()\n$$$", "const $ROUTER = $IMPORT()"])) + ($all | of(["import $IMPORT from 'next/router'\n$$$"])))
          | focus("VALUE"))));
              ([]))
        | finding("code-string-concat";
            "Found data from an Express or Next web request flowing to `eval`.") ) )
| report
