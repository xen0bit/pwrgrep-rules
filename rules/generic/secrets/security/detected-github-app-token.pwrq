# rules: detected-github-app-token
# fixture: generic/detected-github-app-token.txt
# from: CWE-798 (Use of Hard-coded Credentials)

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?P<SECRET>(ghu|ghs)_[A-Za-z0-9_]{36,})"
    ])) as $all
    | ( $all | of(["(?P<SECRET>(ghu|ghs)_[A-Za-z0-9_]{36,})"])
          | where_capture_entropy("SECRET")
        | finding("detected-github-app-token";
        "this is a github app token written into the source, so it is in every checkout "
        + "and every image built from one; read it from the environment, and "
        + "rotate this one because it has leaked") ) )
| report
