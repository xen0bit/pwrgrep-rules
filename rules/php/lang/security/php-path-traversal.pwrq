# rules: php-path-traversal
# languages: php
# fixture: php/CWE-22b.php
# from: CWE-22 (Path Traversal)
#
# A PHP superglobal cannot be written into a pattern: `$_GET` is a `$` and
# a name, which is how a hole is spelled, so `$_GET[$K]` reads as "any
# variable subscripted by anything". The four spellings were one pattern
# four times over, and the source set was every array access in the file.
# The name is pinned by guard on the capture instead, whose text carries
# the `$`.

["file_put_contents($PATH, $$$_)",  "fopen($PATH, $$$_)",  "mkdir($PATH, $$$_)",
 "unlink($PATH)", "rename($PATH, $$$_)", "rename($_, $PATH)",
 "copy($PATH, $$$_)", "copy($_, $PATH)"] as $sinks
| ["$SG[$K]"] as $outside
| scan_ast("*.php"; $sinks + $outside) as $all
| ($all | of($sinks) | focus("PATH") | reaching(($all | of($outside) | where_capture("SG"; "^\\$_(?:GET|POST|REQUEST|COOKIE)$")); []))
| finding("php-path-traversal";
    "$PATH comes from the request, so a caller who sends ../ writes outside the intended directory")
| report
