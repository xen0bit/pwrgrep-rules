# rules: detected-artifactory-token
# languages:
# fixture: generic/detected-artifactory-token.txt
# from: generic/secrets/security/detected-artifactory-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "\\b(?P<SECRET>AKC[A-Za-z0-9]{10,})\\b"
    ])) as $all
    | ( $all | of(["\\b(?P<SECRET>AKC[A-Za-z0-9]{10,})\\b"])
          | where_capture_not("SECRET"; "(?i)sha(12|256|512)")
          | where_capture_not("SECRET"; "---BEGIN")
          | where_capture_entropy("SECRET")
        | finding("detected-artifactory-token";
        "this is an artifactory token written into the source, so it is in every checkout "
        + "and every image built from one; read it from the environment, and "
        + "rotate this one because it has leaked") ) )
| report
