# rules: check-rails-secret-yaml
# fixture: ruby/check-rails-secret-yaml.yaml
# from: ruby/rails/security/brakeman/check-rails-secret-yaml.yaml
#
# The production context ended in an open wildcard, so it matched almost
# nothing and no secret was ever within it. It runs to the section's secret
# now.

. as $root
| ( ($root | scan_regex(["*.yaml"]; [
      "production:\\n((?:  [^\\n]*\\n)+)",
      "secret_key_base:\\s+(?P<VALUE>\\S+)"
    ])) as $all
    | ( $all | of(["secret_key_base:\\s+(?P<VALUE>\\S+)"])
          | within($all | of(["production:\\n((?:  [^\\n]*\\n)+)"]))
        | finding("check-rails-secret-yaml";
            "$VALUE Found a string literal assignment to a production Rails session secret in `secrets.yaml`.") ) )
| report
