# rules: msg-value-multicall
# languages: solidity
# fixture: solidity/msg-value-multicall.sol
#
# Fragments and contract-level AST never match in the solidity grammar, so no
# form fired. Rewritten as a regex over msg.value uses inside a function
# span, in files whose contract inherits Multicall or BoringBatchable.
# Function spans use a lazy body without nested braces. The $F hole had no
# regex capture to bind to, so the message is reworded without it.
# from: solidity/security/msg-value-multicall.yaml

. as $root
| ( ($root | scan_regex(["*.sol"]; [
      "msg\\.value",
      "contract\\s+\\w+\\s+is\\s+[^{]*?(?:Multicall|BoringBatchable)[^{]*?\\{",
      "function\\s+\\w+\\s*\\([\\s\\S]*?\\)\\s*[^{]*\\{[^}]*\\}"
    ])) as $all
    | ( $all | of(["msg\\.value"])
          | within($all | of(["function\\s+\\w+\\s*\\([\\s\\S]*?\\)\\s*[^{]*\\{[^}]*\\}"]))
          | in_files_with($all | of(["contract\\s+\\w+\\s+is\\s+[^{]*?(?:Multicall|BoringBatchable)[^{]*?\\{"]))
        | finding("msg-value-multicall";
            "msg.value stays constant across a multicall batch and can be spent multiple times") ) )
| report
