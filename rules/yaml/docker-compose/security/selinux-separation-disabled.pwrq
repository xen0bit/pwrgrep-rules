# rules: selinux-separation-disabled
# languages: yaml
# fixture: yaml/compose-selinux-disabled.yaml
#
# The service-spanning shapes never coincide, so the rule never fired.
# Rewritten as a service block containing the disable flag.
# Service spans use an indent-anchored block (name plus deeper fields);
# fixture services keep the standard two/four-space layout.
# from: yaml/docker-compose/security/selinux-separation-disabled.yaml

. as $root
| ( ($root | scan_regex(["*.yaml","*.yml"]; [
      "(?m)^  (?P<SVC>[A-Za-z_]\\w*):[^\\S\n]*\n((?:    [^\n]*\n?)*)"
    ])) as $all
    | ( $all | of(["(?m)^  (?P<SVC>[A-Za-z_]\\w*):[^\\S\n]*\n((?:    [^\n]*\n?)*)"])
          | where_text("label:disable")
          | focus("SVC")
        | finding("selinux-separation-disabled";
            "Service '$SVC' is explicitly disabling SELinux separation.") ) )
| report
