# rules: detected-aws-account-id
# languages:
# fixture: generic/detected-aws-account-id.txt
# from: generic/secrets/security/detected-aws-account-id.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)(?:aws[_-]?account[_-]?id|account[_-]?id)[\\s\\\"':=>]{0,10}[\\\"']?(?P<SECRET>[0-9]{12})[\\\"']?"
    ])) as $all
    | ( $all | of(["(?i)(?:aws[_-]?account[_-]?id|account[_-]?id)[\\s\\\"':=>]{0,10}[\\\"']?(?P<SECRET>[0-9]{12})[\\\"']?"])
          | where_capture("SECRET"; "^[0-9]{12}$")
          | where_capture_not("SECRET"; "^12345")
          | where_capture_not("SECRET"; "^0000")
        | finding("detected-aws-account-id";
        "this is an aws account id written into the source, so it is in every checkout "
        + "and every image built from one; read it from the environment, and "
        + "rotate this one because it has leaked") ) )
| report
