# rules: detected-codeclimate
# fixture: generic/detected-codeclimate.txt
# from: generic/secrets/security/detected-codeclimate.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)codeclima.{0,50}[\"|'|`]?[0-9a-f]{64}[\"|'|`]?"
    ])) as $all
    | ( $all | of(["(?i)codeclima.{0,50}[\"|'|`]?[0-9a-f]{64}[\"|'|`]?"])
        | finding("detected-codeclimate";
        "this is a codeclimate written into the source, so it is in every checkout "
        + "and every image built from one; read it from the environment, and "
        + "rotate this one because it has leaked") ) )
| report
