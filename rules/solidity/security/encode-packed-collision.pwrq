# rules: encode-packed-collision
# languages: solidity
# fixture: solidity/encode-packed-collision.sol
#
# Fragments never match in the solidity grammar, so no form fired. Rewritten
# as an audit over keccak256(abi.encodePacked(...)) uses; the reviewer checks
# whether two dynamic arguments collide.
# from: solidity/security/encode-packed-collision.yaml

. as $root
| ( ($root | scan_regex(["*.sol"]; [
      "keccak256\\s*\\(\\s*abi\\.encodePacked\\s*\\("
    ])) as $all
    | ( $all | of(["keccak256\\s*\\(\\s*abi\\.encodePacked\\s*\\("])
        | finding("encode-packed-collision";
            "abi.encodePacked hash collision with variable length arguments in $F()") ) )
| report
