# rules: insecure-request-object
# languages: python
# fixture: python/insecure-request-object.py
#
# The translated patterns embedded a Semgrep `=~/.../` regex inside a string literal, where the matcher reads it as literal text, so the rule could never fire. Each literal is now a $P hole guarded by where_capture with the same character class; the finding set is unchanged.
# from: python/lang/security/audit/insecure-transport/urllib/insecure-request-object.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "urllib.request.Request($P, $$$_)",
      "$URL = $P\n$$$_\nurllib.request.Request($URL, $$$_)",
      "def $FUNC($$$_, $URL = $P, $$$_):\n  $$$_BODY",
      "urllib.request.Request($URL, $$$_)"
    ])) as $all
    | ( ($all | of(["urllib.request.Request($P, $$$_)","$URL = $P\n$$$_\nurllib.request.Request($URL, $$$_)"]) | where_capture("P"; "[Hh][Tt][Tt][Pp]://"))
        + ($all | of(["urllib.request.Request($URL, $$$_)"]) | within($all | of(["def $FUNC($$$_, $URL = $P, $$$_):\n  $$$_BODY"]) | where_capture("P"; "[Hh][Tt][Tt][Pp]://"))) )
    | finding("insecure-request-object";
        "Detected a 'urllib.request.Request()' object using an insecure transport protocol, 'http://'.") )
| report
