# rules: expat-xxe
# languages: javascript, typescript
# fixture: javascript/expat-xxe.js
# from: javascript/node-expat/security/audit/expat-xxe.yaml
#
# Repair: dead as written. The ten statement-sequence shapes needed the
# `require`, the constructor, and the call to sit in one statement list with
# exact bare-`var` spellings, and the literal-argument exclusions read their
# holes as any value. The rule now matches `parse`/`write` calls directly
# with a file-level `node-expat` gate, excluding fully-quoted arguments.

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$PARSER.parse($DATA)",
      "$PARSER.parse($DATA, $OPTS)",
      "$PARSER.write($DATA)",
      "$PARSER.write($DATA, $OPTS)",
      "const $X = require('node-expat')",
      "require('node-expat');\n$$$"
    ])) as $all
    | ( (($all | of(["$PARSER.parse($DATA)","$PARSER.parse($DATA, $OPTS)","$PARSER.write($DATA)","$PARSER.write($DATA, $OPTS)"])
          | not_at(($all | of(["$PARSER.parse($DATA)","$PARSER.parse($DATA, $OPTS)","$PARSER.write($DATA)","$PARSER.write($DATA, $OPTS)"]) | where_capture("DATA"; "^[\"'].*[\"']$")))
          | focus("DATA"))
          | in_files_with(($all | of(["require('node-expat');\n$$$", "const $X = require('node-expat')"])))
        | finding("expat-xxe";
            "If unverified user data can reach the XML Parser it can result in XML External or Internal Entity (XXE) Processing vulnerabilities") ) ))
| report
