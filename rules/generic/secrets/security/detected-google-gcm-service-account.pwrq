# rules: detected-google-gcm-service-account
# fixture: generic/detected-google-gcm-service-account.txt
# from: generic/secrets/security/detected-google-gcm-service-account.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "((\"|'|`)?type(\"|'|`)?\\s{0,50}(:|=>|=)\\s{0,50}(\"|'|`)?service_account(\"|'|`)?,?)"
    ])) as $all
    | ( $all | of(["((\"|'|`)?type(\"|'|`)?\\s{0,50}(:|=>|=)\\s{0,50}(\"|'|`)?service_account(\"|'|`)?,?)"])
        | finding("detected-google-gcm-service-account";
        "this is a google (gcm) service account written into the source, so it is in every checkout "
        + "and every image built from one; read it from the environment, and "
        + "rotate this one because it has leaked") ) )
| report
