# rules: detected-twilio-api-key
# fixture: generic/detected-twilio-api-key.txt
# from: generic/secrets/security/detected-twilio-api-key.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "SK[0-9a-fA-F]{32}"
    ])) as $all
    | ( $all | of(["SK[0-9a-fA-F]{32}"])
        | finding("detected-twilio-api-key";
        "this is a twilio api key written into the source, so it is in every checkout "
        + "and every image built from one; read it from the environment, and "
        + "rotate this one because it has leaked") ) )
| report
