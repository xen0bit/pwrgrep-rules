# rules: csharp-os-command-injection
# languages: c_sharp
# fixture: csharp/CWE-78b.cs
# from: CWE-78 (OS Command Injection)

["$T $V = $S;"] as $assigned
| ["public $T $M($$$_, string $P, $$$_) { $$$_ }",
   "public $T $M(string $P) { $$$_ }"] as $bound
| ["using Microsoft.AspNetCore.Mvc;", "using System.Web.Mvc;",
   "using System.Web.Http;", "using Microsoft.AspNetCore.Components;"] as $mvcImports
| ["class $C : $B { $$$_ }"] as $classes
| ["Process.Start($CMD);", "Process.Start($F, $CMD);", "Process.Start($F, $CMD, $$$_);",
   "new ProcessStartInfo($CMD, $$$_)",
   "new ProcessStartInfo($F, $CMD, $$$_)",
   "$P.Arguments = $CMD;", "$P.StartInfo.Arguments = $CMD;",
   "$P.FileName = $CMD;", "$P.StartInfo.FileName = $CMD;"] as $sinks
| "Request\\s*\\.\\s*(Query|Form|Headers|Cookies|QueryString|Params|RouteValues)\\b" as $fromRequest
| scan_ast("*.cs"; $assigned + $bound + $mvcImports + $classes + $sinks) as $all
| ( ($all | of($assigned) | where_capture("S"; $fromRequest) | focus("S"))
    + ($all | of($bound) | focus("P")
       | in_files_with( ($all | of($mvcImports))
                        + ($all | of($classes) | where_capture("B"; "Controller")) )) ) as $untrusted
| ($all | of($sinks) | focus("CMD"))
| reaching($untrusted; [])
| finding("csharp-os-command-injection";
    "untrusted input from the request reaches a command sink; a `;` or `&` in the value starts a second command")
| report
