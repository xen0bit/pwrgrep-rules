# rules: detect-gemini
# languages: python
# fixture: ai/python/detect-gemini.py
# from: ai/python/detect-gemini.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "import google.generativeai"
    ])) as $all
    | ( $all | of(["import google.generativeai"])
        | finding("detect-gemini";
            "Possibly found usage of AI: Gemini") ) )
| report
