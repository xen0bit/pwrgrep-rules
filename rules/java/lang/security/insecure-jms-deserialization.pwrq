# rules: insecure-jms-deserialization
# languages: java
# fixture: java/insecure-jms-deserialization.java
#
# The translated rule read `$X = $Y.getObject($$$_);` — but getObject
# takes no arguments — and wrapped everything in multi-statement
# scaffolds, which do not compose in Java. The sink is now the three
# no-arg declaration shapes (typed, cast, bare), kept when inside a
# MessageListener, whose class scaffold does have a reading.
# from: java/lang/security/insecure-jms-deserialization.yaml

. as $root
| ( ($root | scan_ast(["*.java"]; [
      "$T $X = $Y.getObject();",
      "$T $X = ($Z) $Y.getObject();",
      "$X = $Y.getObject();",
      "public class $C implements MessageListener {\n  $$$BODY}"
    ])) as $all
    | ( ($all | of(["$T $X = $Y.getObject();", "$T $X = ($Z) $Y.getObject();", "$X = $Y.getObject();"])
        | within($all | of(["public class $C implements MessageListener {\n  $$$BODY}"]))) )
    | finding("insecure-jms-deserialization";
        "JMS Object messages depend on Java Serialization for marshalling/unmarshalling of the message payload when ObjectMessage.getObject() is called.") )
| report
