# rules: jpa-sqli
# languages: java
# fixture: java/jpa-sqli.java
# from: java/lang/security/audit/sqli/jpa-sqli.yaml

["$R.getParameter($$$_)", "$R.getHeader($$$_)", "$R.getQueryString()", "$R.getCookies()", "$R.getParameterValues($$$_)"] as $src
| ["$EM.createQuery($Q)", "$EM.createNativeQuery($Q)"] as $sinks
| scan_ast("*.java"; $src + $sinks) as $all
| ($all | of($sinks) | focus("Q") | reaching($all | of($src); []) | finding("jpa-sqli"; "Detected a formatted string in a SQL statement."))
| report
