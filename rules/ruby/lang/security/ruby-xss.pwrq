# rules: ruby-xss
# languages: ruby
# fixture: ruby/CWE-79.rb
# from: ruby/rails/security/audit/xss/templates/html-safe.yaml (alias-for-html-safe), CWE-79 (Cross-site Scripting)

. as $root
| ( ($root | scan_ast(["*.rb"]; [
      "raw($X)",
      "$X.html_safe",
      "render $X",
      "render($X)",
      "params",
      "params[$$$_]",
      "params.get($$$_)",
      "cookies",
      "request.query_string",
      "request.body"
    ])) as $all
  | ($all | of(["raw($X)","$X.html_safe","render $X","render($X)"]) | focus("X") | reaching($all | of(["params","params[$$$_]","params.get($$$_)","cookies","request.query_string","request.body"]); []))
  | finding("ruby-xss"; "Untrusted input rendered as HTML without escaping; use html_escape")
  )
| report
