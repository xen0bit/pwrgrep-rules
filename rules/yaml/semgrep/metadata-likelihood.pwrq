# rules: metadata-likelihood
# languages: yaml
# fixture: yaml/metadata-likelihood.yaml
#
# The absence half used multi-line outside spans that never enclose
# anything, so the rule never fired. Rewritten as a regex over the metadata
# block (fixed four/six-space indent, the semgrep style) with text guards;
# the security-category scope rides along in the same text.
# from: yaml/semgrep/metadata-likelihood.yaml

. as $root
| ( ($root | scan_regex(["*.yaml","*.yml"]; [
      "(?m)^    metadata:[^\\S\n]*\n((?:      [^\n]*\n?)*)"
    ])) as $all
    | ( $all | of(["(?m)^    metadata:[^\\S\n]*\n((?:      [^\n]*\n?)*)"])
          | where_text("category:\\s*security")
          | where_text_not("likelihood:")
        | finding("metadata-likelihood";
            "This Semgrep rule is missing a valid 'likelihood' field in the 'metadata'.") ) )
| report
