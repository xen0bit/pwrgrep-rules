# rules: detected-hashicorp-token
# languages:
# fixture: generic/detected-hashicorp-token.txt
# from: CWE-798 (Use of Hard-coded Credentials)
#
# Hashicorp token hardcoded.

. as $root
| ( ($root | scan_regex(["*"]; [
      "hashicorp_(?P<SECRET>[A-Za-z0-9_\\-]{20,})"
    ])) as $all
    | ( $all | of(["hashicorp_(?P<SECRET>[A-Za-z0-9_\\-]{20,})"])
          | where_capture_entropy("SECRET")
        | finding("detected-hashicorp-token";
        "this is a hashicorp token written into the source, so it is in every checkout "
        + "and every image built from one; read it from the environment, and "
        + "rotate this one because it has leaked") ) )
| report
