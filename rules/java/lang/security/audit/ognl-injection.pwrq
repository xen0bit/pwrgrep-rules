# rules: ognl-injection
# languages: java
# fixture: java/ognl-injection.java
#
# The translated rule wrapped every call in a multi-statement method
# scaffold, but statement sequences do not compose in Java, so all 116
# patterns were empty. The finding is per-call — an OGNL evaluator fed
# a non-literal — asked directly: each OGNL entry point as a single
# statement, kept when its expression argument is not a string
# literal. The receiver-type scaffolding (OgnlUtil, ValueStack, ...)
# has no single-statement reading and is not re-checked; the method
# names carry the finding.
# from: java/lang/security/audit/ognl-injection.yaml

. as $root
| ( ($root | scan_ast(["*.java"]; [
      "$P.callMethod($INPUT, $$$_)",
      "$P.commaDelimitedStringToSet($INPUT, $$$_)",
      "$P.compile($INPUT, $$$_)",
      "$P.evaluate($INPUT, $$$_)",
      "$P.findString($INPUT, $$$_)",
      "$P.findValue($INPUT, $$$_)",
      "$P.getField($T, $INPUT, $$$_)",
      "$P.getGetMethod($T, $INPUT, $$$_)",
      "$P.getSetMethod($T, $INPUT, $$$_)",
      "$P.getText($INPUT, $$$_)",
      "$P.getValue($INPUT, $$$_)",
      "$P.isTrue($INPUT, $$$_)",
      "$P.makeSelectList($INPUT, $$$_)",
      "$P.setParameter($INPUT, $$$_)",
      "$P.setProperties($INPUT, $$$_)",
      "$P.setProperty($INPUT, $$$_)",
      "$P.setValue($INPUT, $$$_)",
      "$P.shallBeIncluded($INPUT, $$$_)",
      "$P.translateVariables($INPUT, $$$_)",
      "$P.translateVariablesCollection($INPUT, $$$_)"
    ])) as $all
    | ( ($all | of(["$P.callMethod($INPUT, $$$_)", "$P.commaDelimitedStringToSet($INPUT, $$$_)", "$P.compile($INPUT, $$$_)", "$P.evaluate($INPUT, $$$_)", "$P.findString($INPUT, $$$_)", "$P.findValue($INPUT, $$$_)", "$P.getField($T, $INPUT, $$$_)", "$P.getGetMethod($T, $INPUT, $$$_)", "$P.getSetMethod($T, $INPUT, $$$_)", "$P.getText($INPUT, $$$_)", "$P.getValue($INPUT, $$$_)", "$P.isTrue($INPUT, $$$_)", "$P.makeSelectList($INPUT, $$$_)", "$P.setParameter($INPUT, $$$_)", "$P.setProperties($INPUT, $$$_)", "$P.setProperty($INPUT, $$$_)", "$P.setValue($INPUT, $$$_)", "$P.shallBeIncluded($INPUT, $$$_)", "$P.translateVariables($INPUT, $$$_)", "$P.translateVariablesCollection($INPUT, $$$_)"])
        | where_capture_not("INPUT"; "^\"")) )
    | finding("ognl-injection";
        "A expression is built with a dynamic value.") )
| report
