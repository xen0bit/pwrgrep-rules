# rules: check-reverse-tabnabbing
# fixture: ruby/check-reverse-tabnabbing.erb
#
# The `target:\s+[\s\S]*?` container matches with an empty tail, so a `_blank` value after it is never `within` it. The tail now reads the value itself (`\s*\S+`). The `rel: ...noopener` exclusion is likewise fenced to one tag (`[^%]*?`), since its gaps otherwise span from an unsafe tag into a safe one and exclude everything.
# from: ruby/rails/security/brakeman/check-reverse-tabnabbing.yaml

. as $root
| ( ($root | scan_regex(["*.erb"]; [
      "<%=\\s+(?P<INLINERUBY>[\\s\\S]*?)\\s+%>",
      "<%=\\s+(?P<INLINERUBYDO>[\\s\\S]*?)\\s+do\\s+\\-%>\\s+[\\s\\S]*?\\s+<%\\s+end\\s+%>",
      "<%=\\s+[\\s\\S]*?\\s+do\\s+\\-\\s+%>",
      "<%=\\s+[^%]*?\\s+rel:\\s+'noopener\\s+noreferrer'\\s+[^%]*?%>",
      "_blank",
      "target:\\s*\\S+"
    ])) as $all
    | ( $all | of(["_blank"])
          | at_same_place((($all
          | within($all | of(["<%=\\s+(?P<INLINERUBYDO>[\\s\\S]*?)\\s+do\\s+\\-%>\\s+[\\s\\S]*?\\s+<%\\s+end\\s+%>"])))
          + ($all
          | outside($all | of(["<%=\\s+[\\s\\S]*?\\s+do\\s+\\-\\s+%>"]))
          | within($all | of(["<%=\\s+(?P<INLINERUBY>[\\s\\S]*?)\\s+%>"])))))
          | within($all | of(["target:\\s*\\S+"]))
          | outside($all | of(["<%=\\s+[^%]*?\\s+rel:\\s+'noopener\\s+noreferrer'\\s+[^%]*?%>"]))
        | finding("check-reverse-tabnabbing";
            "Setting an anchor target of `_blank` without the `noopener` or `noreferrer` attribute allows reverse tabnabbing on Internet Explorer, Opera, and Android Webview.") ) )
| report
