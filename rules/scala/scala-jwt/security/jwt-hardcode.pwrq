# rules: scala-jwt-hardcoded-secret
# languages: scala
# fixture: scala/scala-jwt-hardcoded-secret.scala
# from: scala/scala-jwt/security/jwt-hardcode.yaml

. as $root
| ( ($root | scan_ast(["*.scala"]; [
      "com.auth0.jwt.algorithms.Algorithm.HMAC256($K)",
      "com.auth0.jwt.algorithms.Algorithm.HMAC384($K)",
      "com.auth0.jwt.algorithms.Algorithm.HMAC512($K)"
    ])) as $all
    | ( $all | of(["com.auth0.jwt.algorithms.Algorithm.HMAC256($K)", "com.auth0.jwt.algorithms.Algorithm.HMAC384($K)", "com.auth0.jwt.algorithms.Algorithm.HMAC512($K)"])
          | where_capture("K"; "^\\\".*\\\"$")
        | finding("scala-jwt-hardcoded-secret";
            "Hardcoded JWT secret or private key is used.") ) )
| report
