# rules: detected-etc-shadow
# fixture: generic/detected-etc-shadow.txt
# from: generic/secrets/security/detected-etc-shadow.yaml
#
# (?m) so ^ matches every shadow line, not just the start of the file.

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?m)^(\\s*)(?P<ROOT>root:[x!*]*:[0-9]*:[0-9]*)"
    ])) as $all
    | ( $all | of(["(?m)^(\\s*)(?P<ROOT>root:[x!*]*:[0-9]*:[0-9]*)"])
          | focus("ROOT")
        | finding("detected-etc-shadow";
            "linux shadow file detected") ) )
| report
