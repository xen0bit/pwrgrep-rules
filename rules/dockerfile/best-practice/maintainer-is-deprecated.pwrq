# rules: maintainer-is-deprecated
# languages: dockerfile
# fixture: dockerfile/CWE-maintainer.dockerfile
# from: dockerfile/best-practice/maintainer-is-deprecated.yaml

. as $root
| ( ($root | scan_regex(["Dockerfile*","*.dockerfile"]; [
      "MAINTAINER"
    ])) as $all
    | ( $all | of(["MAINTAINER"])
        | finding("maintainer-is-deprecated";
            "MAINTAINER has been deprecated.") ) )
| report
