# rules: doctrine-dbal-dangerous-query
# languages: php
# fixture: php/doctrine-dbal-dangerous-query.php
#
# Two port artifacts are repaired: the `;\n$$$_` statement gaps in the
# in_files_with patterns never span statements, so the file scoping never
# matched; and the `"$$$_"` literal exclusions lost their quotes, matching
# every call and subtracting all findings. Gaps dropped (file scope needs no
# following statement) and literals guarded with where_capture_not instead.
# from: php/doctrine/security/audit/doctrine-dbal-dangerous-query.yaml

. as $root
| ( ($root | scan_ast(["*.php"]; [
      "$CONNECTION = $SMTH->getConnection($C);",
      "$CONNECTION->createQuery($QUERY,$$$_)",
      "$CONNECTION->executeQuery($QUERY,$$$_)",
      "$CONNECTION->prepare($QUERY,$$$_)",
      "use Doctrine\\DBAL\\Connection;"
    ])) as $all
    | ( $all | of(["$CONNECTION->prepare($QUERY,$$$_)","$CONNECTION->createQuery($QUERY,$$$_)","$CONNECTION->executeQuery($QUERY,$$$_)"])
          | at_same_place((($all
          | in_files_with($all | of(["use Doctrine\\DBAL\\Connection;"])))
          + ($all
          | in_files_with($all | of(["$CONNECTION = $SMTH->getConnection($C);"])))))
          | where_capture_not("QUERY"; "^\".*\"$")
          | where_capture_not("QUERY"; "^'.*'$")
        | finding("doctrine-dbal-dangerous-query";
            "Detected string concatenation with a non-literal variable in a Doctrine DBAL query method.") ) )
| report
