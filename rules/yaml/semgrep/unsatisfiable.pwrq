# rules: unsatisfiable-rule
# languages: yaml
# fixture: yaml/semgrep-unsatisfiable.yaml
#
# A pattern contradicted by an identical pattern-not can never match, but
# the ported same-place scaffolding never coincided. Rewritten as one regex
# over the pair with where_same, in both orders.
# from: yaml/semgrep/unsatisfiable.yaml

. as $root
| ( ($root | scan_regex(["*.yaml","*.yml"]; [
      "-\\s+pattern:\\s+(?P<A>\\S+)(?:\\n      [^\\n]*)*\\n      -\\s+pattern-not:\\s+(?P<B>\\S+)",
      "-\\s+pattern-not:\\s+(?P<A>\\S+)(?:\\n      [^\\n]*)*\\n      -\\s+pattern:\\s+(?P<B>\\S+)"
    ])) as $all
    | ( (($all | of(["-\\s+pattern:\\s+(?P<A>\\S+)(?:\\n      [^\\n]*)*\\n      -\\s+pattern-not:\\s+(?P<B>\\S+)"]) | where_same("A"; "B") | focus("A"))
          + ($all | of(["-\\s+pattern-not:\\s+(?P<A>\\S+)(?:\\n      [^\\n]*)*\\n      -\\s+pattern:\\s+(?P<B>\\S+)"]) | where_same("A"; "B") | focus("A"))
        | finding("unsatisfiable-rule";
            "You can not use 'pattern' $A and 'pattern-not' $A together; this will always be empty.") ) ) )
| report
