# rules: pg-orm-sqli
# languages: go
# fixture: go/pg-orm-sqli.go
#
# The translated rule was scan_regex over Go, whose chain patterns demand
# a literal comma before the concatenated pair (`,\s+(?P<X>\S+)\s+\+`) —
# but a `Where("..." + x)` call has no such comma — and then intersect
# everything with file-span at_same_place tests that cannot coincide, so
# it was empty twice over. The original was AST patterns, and Go reads
# method chains directly, so the rule is structural again: a chained
# `$M($X + $Y)` or `$M(fmt.Sprintf(...))` call with $M one of the ORM
# clause builders, minus the all-literal concatenation. Import/connect
# scaffolding from the original is not re-checked: the clause names are
# distinctive enough to stand alone.
# from: go/lang/security/audit/sqli/pg-orm-sqli.yaml

. as $root
| ( ($root | scan_ast(["*.go"]; [
      "$DB.$I1($$$_).$M($X + $Y, $$$_).$I2($$$_)",
      "$DB.$I1($$$_).$M(fmt.Sprintf($F, $$$_), $$$_).$I2($$$_)"
    ])) as $all
    | ( (($all | of(["$DB.$I1($$$_).$M($X + $Y, $$$_).$I2($$$_)"]) | where_capture_not("X"; "^\"[^\"]*\"\\s*\\+\\s*\"[^\"]*\"$"))
        + ($all | of(["$DB.$I1($$$_).$M(fmt.Sprintf($F, $$$_), $$$_).$I2($$$_)"])))
        | where_capture("M"; "^(Where|WhereOr|Join|GroupExpr|OrderExpr|ColumnExpr)$")
        | finding("pg-orm-sqli";
            "Detected string concatenation with a non-literal variable in a go-pg ORM SQL statement.") ) )
| report
