# rules: spring-actuator-dangerous-endpoints-enabled
# fixture: java/spring-actuator-dangerous-endpoints-enabled.properties
# from: java/spring/security/audit/spring-actuator-non-health-enabled.yaml
#
# The value hole ended in an open wildcard, so it caught nothing and the
# health-only exclusion never held; every line fired. It runs to the value
# now.

. as $root
| ( ($root | scan_regex(["*"]; [
      "management\\.endpoints\\.web\\.exposure\\.include=(?P<ACTUATORS>\\S+)"
    ])) as $all
    | ( $all | of(["management\\.endpoints\\.web\\.exposure\\.include=(?P<ACTUATORS>\\S+)"])
          | where_capture_not("ACTUATORS"; "^\"?(?:health|\\*)\"?$")
        | finding("spring-actuator-dangerous-endpoints-enabled";
            "Spring Boot Actuators \"$...ACTUATORS\" are enabled.") ) )
| report
