# rules: string-formatted-query
# languages: go
# fixture: go/string-formatted-query.go
#
# In Go a quoted $$$_ matches any argument, not just a string literal, so every
# "literal-only" exclusion (the seven not_at call legs and the constant-concat
# outside leg) coincided with the firing legs and cancelled them all. The
# exclusions now bind the argument as $S/$T and keep only full string literals
# via guard. Queries built through a variable ($QUERY assigned apart from the
# call) are out of scope: relating the assignment to the use needs dataflow
# the rule does not do.
# from: go/lang/security/audit/database/string-formatted-query.yaml

. as $root
| ( ($root | scan_ast(["*.go"]; [
      "$OBJ.Exec($X + $$$_)",
      "$OBJ.Exec(fmt.$P(\"$$$_\", $$$_))",
      "$OBJ.ExecContext($CTX, $X + $$$_)",
      "$OBJ.ExecContext($CTX, fmt.$P(\"$$$_\", $$$_))",
      "$OBJ.Query($X + $$$_)",
      "$OBJ.Query(fmt.$P(\"$$$_\", $$$_))",
      "$OBJ.QueryContext($CTX, $X + $$$_)",
      "$OBJ.QueryContext($CTX, fmt.$P(\"$$$_\", $$$_))",
      "$OBJ.QueryRow($CTX, $X + $$$_)",
      "$OBJ.QueryRow($CTX, fmt.$U(\"$$$_\", $$$_))",
      "$OBJ.QueryRow($X + $$$_)",
      "$OBJ.QueryRow(fmt.$P(\"$$$_\", $$$_))",
      "$OBJ.QueryRowContext($CTX, $X + $$$_)",
      "$OBJ.QueryRowContext($CTX, fmt.$P(\"$$$_\", $$$_))",
      "$VAR = $S + $T\n$$$_\n$OBJ.$SINK($$$_, $VAR, $$$_)",
      "$OBJ.Exec($S)",
      "$OBJ.ExecContext($CTX, $S)",
      "$OBJ.Query($S)",
      "$OBJ.QueryContext($CTX, $S)",
      "$OBJ.QueryRow($S)",
      "$OBJ.QueryRow($CTX, $S)",
      "$OBJ.QueryRowContext($CTX, $S)"
    ])) as $all
    | (($all | of(["$OBJ.Exec($X + $$$_)", "$OBJ.ExecContext($CTX, $X + $$$_)", "$OBJ.Query($X + $$$_)", "$OBJ.QueryContext($CTX, $X + $$$_)", "$OBJ.QueryRow($CTX, $X + $$$_)", "$OBJ.QueryRow($X + $$$_)", "$OBJ.QueryRowContext($CTX, $X + $$$_)"]) | where_capture_not("X"; "^\"[^\"]*\"\\s*\\+\\s*\"[^\"]*\"$") | where_capture("OBJ"; "^(?:(?i).*(db|database))")) + ($all | of(["$OBJ.Exec(fmt.$P(\"$$$_\", $$$_))", "$OBJ.ExecContext($CTX, fmt.$P(\"$$$_\", $$$_))", "$OBJ.Query(fmt.$P(\"$$$_\", $$$_))", "$OBJ.QueryContext($CTX, fmt.$P(\"$$$_\", $$$_))", "$OBJ.QueryRow($CTX, fmt.$U(\"$$$_\", $$$_))", "$OBJ.QueryRow(fmt.$P(\"$$$_\", $$$_))", "$OBJ.QueryRowContext($CTX, fmt.$P(\"$$$_\", $$$_))"]) | where_capture("OBJ"; "^(?:(?i).*(db|database))")) | outside($all | of(["$VAR = $S + $T\n$$$_\n$OBJ.$SINK($$$_, $VAR, $$$_)"]) | where_capture("S"; "^\"[^\"]*\"$") | where_capture("T"; "^\"[^\"]*\"$")) | not_at($all | of(["$OBJ.Exec($S)"]) | where_capture("S"; "^\"[^\"]*\"$")) | not_at($all | of(["$OBJ.ExecContext($CTX, $S)"]) | where_capture("S"; "^\"[^\"]*\"$")) | not_at($all | of(["$OBJ.Query($S)"]) | where_capture("S"; "^\"[^\"]*\"$")) | not_at($all | of(["$OBJ.QueryContext($CTX, $S)"]) | where_capture("S"; "^\"[^\"]*\"$")) | not_at($all | of(["$OBJ.QueryRow($S)"]) | where_capture("S"; "^\"[^\"]*\"$")) | not_at($all | of(["$OBJ.QueryRow($CTX, $S)"]) | where_capture("S"; "^\"[^\"]*\"$")) | not_at($all | of(["$OBJ.QueryRowContext($CTX, $S)"]) | where_capture("S"; "^\"[^\"]*\"$")))
    | finding("string-formatted-query";
        "String-formatted SQL query detected.") )
| report
