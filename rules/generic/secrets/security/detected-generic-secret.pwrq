# rules: detected-generic-secret
# fixture: generic/detected-generic-secret.txt
# from: generic/secrets/security/detected-generic-secret.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "[sS][eE][cC][rR][eE][tT][:= \\t]*['|\\\"]?(?<SECRET>[0-9a-zA-Z]{32,45})['|\\\"]?"
    ])) as $all
    | ( $all | of(["[sS][eE][cC][rR][eE][tT][:= \\t]*['|\\\"]?(?<SECRET>[0-9a-zA-Z]{32,45})['|\\\"]?"])
          | where_capture_entropy("SECRET")
        | finding("detected-generic-secret";
        "this is a generic secret written into the source, so it is in every checkout "
        + "and every image built from one; read it from the environment, and "
        + "rotate this one because it has leaked") ) )
| report
