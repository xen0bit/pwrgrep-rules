# rules: code-after-unconditional-return, return-not-in-function
# languages: python
# fixture: python/return.py
#
# Both halves self-fired: `code-after-unconditional-return` was a regex
# matching `return <anything>` on its own line, so it reported the
# return rather than the dead code; `return-not-in-function` subtracted
# `def` patterns that end in a literal `# TODO` comment no real file
# has, so every function return was "outside" one. A two-statement
# `return` + follower pattern is no rescue either: beside a gap the
# `return` keyword is dropped and the pattern matches `def` lines with
# comments for followers. The rule therefore asks the function body as
# text whether a `return` line is followed by a code-opening line, which
# is the corpus's body-as-text technique; a comment between return and
# dead code hides it, and a trailing comment after a final return is
# correctly silent. The finding lands on the `def`. The second half
# subtracts real `def` scaffolds with named body holes.
# from: python/lang/maintainability/return.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "def $F($$$_):\n  $$$BODY",
      "def $F($$$_) -> $Y:\n  $$$BODY",
      "return $R"
    ])) as $all
    | ( (($all | of(["return $R"])
          | outside($all | of(["def $F($$$_):\n  $$$BODY"]))
          | outside($all | of(["def $F($$$_) -> $Y:\n  $$$BODY"])))
        | finding("return-not-in-function";
            "`return` only makes sense inside a function"))
        + (($all | of(["def $F($$$_):\n  $$$BODY", "def $F($$$_) -> $Y:\n  $$$BODY"])
          | where_capture("BODY"; "\\breturn\\b[^\\n]*\\n[ \\t]*[A-Za-z0-9_\"'({\\[]"))
        | finding("code-after-unconditional-return";
            "code after return statement will not be executed")) ))
| report
| report
| report
