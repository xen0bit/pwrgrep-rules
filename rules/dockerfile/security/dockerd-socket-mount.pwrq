# rules: dockerfile-dockerd-socket-mount
# languages: dockerfile
# fixture: dockerfile/CWE-docker-socket.dockerfile
# from: dockerfile/security/dockerd-socket-mount.yaml

. as $root
| ( ($root | scan_regex(["Dockerfile*","*.dockerfile"]; [
      "/var/run/docker[.]sock"
    ])) as $all
    | ( $all | of(["/var/run/docker[.]sock"])
        | finding("dockerfile-dockerd-socket-mount";
            "The Dockerfile(image) mounts docker.sock to the container which may allow an attacker already inside of the container to escape container and execute arbitrary commands on the host machine.") ) )
| report
