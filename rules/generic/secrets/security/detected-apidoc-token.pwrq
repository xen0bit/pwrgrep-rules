# rules: detected-apidoc-token
# languages:
# fixture: generic/detected-apidoc-token.txt
# from: CWE-798 (Use of Hard-coded Credentials)
#
# Apidoc token hardcoded.

. as $root
| ( ($root | scan_regex(["*"]; [
      "apidoc_(?P<SECRET>[A-Za-z0-9_\\-]{20,})"
    ])) as $all
    | ( $all | of(["apidoc_(?P<SECRET>[A-Za-z0-9_\\-]{20,})"])
          | where_capture_entropy("SECRET")
        | finding("detected-apidoc-token";
        "this is an apidoc token written into the source, so it is in every checkout "
        + "and every image built from one; read it from the environment, and "
        + "rotate this one because it has leaked") ) )
| report
