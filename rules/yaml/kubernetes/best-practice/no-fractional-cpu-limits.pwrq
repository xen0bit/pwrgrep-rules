# rules: no-fractional-cpu-limits
# languages: yaml
# fixture: yaml/k8s-fractional-cpu.yaml
#
# The limits-span scaffolding never encloses, so the rule never fired.
# Rewritten as a direct millicpu value match.
# from: yaml/kubernetes/best-practice/no-fractional-cpu-limits.yaml

. as $root
| ( ($root | scan_regex(["*.yaml","*.yml"]; [
      "cpu:\\s*[\"']?\\d{0,3}m[\"']?"
    ])) as $all
    | ( $all | of(["cpu:\\s*[\"']?\\d{0,3}m[\"']?"])
        | finding("no-fractional-cpu-limits";
            "When you set a fractional CPU limit on a container, the CPU cycles available will be throttled, even though most nodes can handle processes alternating between using 100% of the CPU.") ) )
| report
