# rules: non-payable-constructor
# languages: solidity
# fixture: solidity/non-payable-constructor.sol
#
# Constructor and contract-level AST never match in the solidity grammar, so
# no form fired. Rewritten as a regex over the constructor header with a
# guard for the payable modifier.
# from: solidity/performance/non-payable-constructor.yaml

. as $root
| ( ($root | scan_regex(["*.sol"]; [
      "(?m)^    constructor\\s*\\([^)]*\\)\\s*(?P<M>[^{]*?)\\{"
    ])) as $all
    | ( $all | of(["(?m)^    constructor\\s*\\([^)]*\\)\\s*(?P<M>[^{]*?)\\{"])
          | where_capture_not("M"; "payable")
        | finding("non-payable-constructor";
            "Consider making costructor payable to save gas.") ) )
| report
