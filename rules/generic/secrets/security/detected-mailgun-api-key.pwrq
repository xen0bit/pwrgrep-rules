# rules: detected-mailgun-api-key
# fixture: generic/detected-mailgun-api-key.txt
# from: generic/secrets/security/detected-mailgun-api-key.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "key-[0-9a-zA-Z]{32}"
    ])) as $all
    | ( $all | of(["key-[0-9a-zA-Z]{32}"])
        | finding("detected-mailgun-api-key";
        "this is a mailgun api key written into the source, so it is in every checkout "
        + "and every image built from one; read it from the environment, and "
        + "rotate this one because it has leaked") ) )
| report
