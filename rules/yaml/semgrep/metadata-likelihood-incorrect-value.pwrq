# rules: metadata-likelihood-incorrect-value
# languages: yaml
# fixture: yaml/metadata-likelihood-incorrect-value.yaml
#
# Multi-line within spans never enclose their targets, so the value check
# never ran. Rewritten as a direct value match with an allowlist guard;
# the security-category scope is file-level.
# from: yaml/semgrep/metadata-likelihood-incorrect-value.yaml

. as $root
| ( ($root | scan_regex(["*.yaml","*.yml"]; [
      "likelihood:\\s+(?P<VALUE>\\S+)",
      "metadata:\\s+[\\s\\S]*?\\s+category:\\s+security"
    ])) as $all
    | ( $all | of(["likelihood:\\s+(?P<VALUE>\\S+)"])
          | where_capture_not("VALUE"; "^(?:LOW|MEDIUM|HIGH)$")
          | in_files_with($all | of(["metadata:\\s+[\\s\\S]*?\\s+category:\\s+security"]))
        | finding("metadata-likelihood-incorrect-value";
            "Semgrep rule likelihood: $VALUE detected, but the value must be LOW, MEDIUM, or HIGH.") ) )
| report
