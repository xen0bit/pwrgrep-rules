# rules: privileged-service
# languages: yaml
# fixture: yaml/compose-privileged-service.yaml
# from: yaml/docker-compose/security/privileged-service.yaml

. as $root
| ($root | scan_ast(["*.yaml","*.yml"]; [
      "privileged: true"
    ])) as $all
| ($all | of(["privileged: true"]) | finding("privileged-service"; "Service '$SERVICE' is running in privileged mode."))
| report
