# rules: openai-consequential-action-false
# languages: yaml
# fixture: yaml/openapi-consequential-false.yaml
#
# Two-line method shapes never match in the yaml grammar, so no form fired.
# Rewritten as a state-changing-method block with a text guard for the false
# flag. Blocks use lazy bodies without nested braces.
# from: yaml/openapi/security/openai-consequential-action-false.yaml

. as $root
| ( ($root | scan_regex(["*.yaml","*.yml"]; [
      "(?m)^\\s+(?P<METHOD>post|put|patch|delete):[^\\S\n]*((?:\n      [^\n]*)*)"
    ])) as $all
    | ( $all | of(["(?m)^\\s+(?P<METHOD>post|put|patch|delete):[^\\S\n]*((?:\n      [^\n]*)*)"])
          | where_text("x-openai-isConsequential:\\s*false")
        | finding("openai-consequential-action-false";
            "Found 'x-openai-isConsequential: false' in state-changing $METHOD: the operation is marked non-consequential.") ) )
| report
