# rules: lang-consistency-go
# languages: yaml
# fixture: yaml/semgrep-lang-consistency-go.yaml
#
# The bare token never equals a bracketed or listed language, so the rule
# never fired. The guard now accepts bracket, comma and space boundaries.
# from: yaml/semgrep/consistency/lang-consistency-go.yaml

. as $root
| ( ($root | scan_regex(["*.yaml","*.yml"]; [
      "(?P<X>\\S+)",
      "languages:\\s+[^\\n]*"
    ])) as $all
    | ( $all | of(["(?P<X>\\S+)"])
          | within($all | of(["languages:\\s+[^\\n]*"]))
          | where_capture("X"; "(?:\\[|,| )(golang)(?:\\]|,| |$)")
        | finding("lang-consistency-go";
            "Found '$X' in language config which diverges from semgrep.dev normalization.") ) )
| report
