# rules: httpurlconnection-http-request
# languages: java
# fixture: problem-based-packs/java-httpurlconnection-http-request.java
#
# The `"=~/.../"` string guards never match and untyped `$X = new ...`
# declarations never match typed Java, so the rule never fired. Rewritten with
# typed declarations and the URL in a named hole guarded by where_capture.
# from: problem-based-packs/insecure-transport/java-stdlib/httpurlconnection-http-request.yaml

. as $root
| ( ($root | scan_ast(["*.java"]; [
      "URL $URL = new URL($U);
$$$_
URLConnection $CON = $URL.openConnection($$$_);
$$$_
$CON.$FUNC($$$_);",
      "URL $URL = new URL($U);
$$$_
HttpURLConnection $CON = (HttpURLConnection) $URL.openConnection($$$_);
$$$_
$CON.$FUNC($$$_);"
    ])) as $all
    | ( $all | of(["URL $URL = new URL($U);
$$$_
URLConnection $CON = $URL.openConnection($$$_);
$$$_
$CON.$FUNC($$$_);","URL $URL = new URL($U);
$$$_
HttpURLConnection $CON = (HttpURLConnection) $URL.openConnection($$$_);
$$$_
$CON.$FUNC($$$_);"])
          | where_capture("U"; "http://")
        | finding("httpurlconnection-http-request";
            "Detected an HTTP request sent via HttpURLConnection.") ) )
| report
