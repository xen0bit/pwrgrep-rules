# rules: md5-used-as-password
# languages: php
# fixture: php/CWE-916.php
# from: php/lang/security/md5-used-as-password.yaml, CWE-916, CWE-327
#
# MD5 and SHA-1 are fast, and for a password hash fast is the vulnerability. A
# GPU tries billions of candidates a second against either, so a stolen table
# of md5 hashes is a stolen table of passwords, and salting only means each one
# has to be cracked separately.
#
# password_hash() is slow on purpose, salts on its own, and records the cost
# in the hash so it can be raised later; password_verify() reads it back.
# There is no case for hashing a password any other way in PHP.
#
# What makes this checkable is the name rather than the call - md5() over a
# file is a checksum and md5() over a password is a vulnerability, and nothing
# but the identifier says which. So the rule reads the argument, and the
# assignment's left side too, since `$password_hash = md5($x)` says what it is
# for on the other side of the equals.
#
# The original tried to say this with reaching, from an md5 call to a function
# whose *name* contained "password" - which is not what reaching is for, and
# its patterns could not compile besides.
#
# The two questions are asked of disjoint sets rather than of the same one.
# `md5($password)` is caught by the argument's name; `$password_hash = md5($x)`
# is caught by the variable's, and only where the argument's name said nothing.
# Written that way neither can report what the other reported, which matters
# because the two readings cannot be made to agree on a span: how far a hole is
# folded depends on what is around it, so $ARG is the argument in one reading
# and the parenthesised argument list in the other, and no amount of focus
# collapses them.

["md5", "sha1", "crc32"] as $fast
| "(?i)pass(word|wd|phrase)?|pwd|secret|credential" as $names
| "^['\"](?:md5|sha1|crc32b?)['\"]$" as $fast_algo
| ($fast | map(. + "($ARG)")) as $direct
| ($fast | map("$LHS = " + . + "($ARG);")) as $assigned
| scan_ast("*.php"; $direct + $assigned
                    + ["hash($ALGO, $ARG)", "$LHS = hash($ALGO, $ARG);"]) as $all
| ( ($all | of($direct))
    + ($all | of(["hash($ALGO, $ARG)"])
       | where_capture("ALGO"; $fast_algo)) ) as $hashing
| ( ($all | of($assigned))
    + ($all | of(["$LHS = hash($ALGO, $ARG);"])
       | where_capture("ALGO"; $fast_algo)) ) as $stored
| ( ($hashing | where_capture("ARG"; $names) | focus("ARG"))
    + ($stored | where_capture("LHS"; $names)
              | where_capture_not("ARG"; $names) | focus("LHS")) )
| finding("md5-used-as-password";
    "this hashes a password with something built to be fast, which is what a "
    + "cracker needs it to be; password_hash and password_verify")
| report
