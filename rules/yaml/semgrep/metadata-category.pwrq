# rules: metadata-category
# languages: yaml
# fixture: yaml/semgrep-metadata-category.yaml
#
# The id-without-category shape used spans that never coincide, so the rule
# never fired. Rewritten as a regex over the metadata block with a text
# guard (fixed four/six-space indent, the semgrep style).
# A `rules:` key at column zero is what says the file is a Semgrep rule and
# not something else that spells a key the same way: `metadata:` is every
# Kubernetes manifest, `- id:` is any list of records, and `message: |` is
# any workflow that writes more than a line.
# from: yaml/semgrep/metadata-category.yaml

. as $root
| ($root | scan_regex(["*.yaml","*.yml"]; [
      "(?m)^rules:[^\\S\n]*$"
    ])) as $semgrep
| ( (($root | scan_regex(["*.yaml","*.yml"]; [
      "(?m)^    metadata:[^\\S\n]*\n((?:      [^\n]*\n?)*)"
    ])) | in_files_with($semgrep)) as $all
    | ( $all | of(["(?m)^    metadata:[^\\S\n]*\n((?:      [^\n]*\n?)*)"])
          | where_text_not("category:")
        | finding("metadata-category";
            "This Semgrep rule is missing a valid 'category' field in the 'metadata'.") ) )
| report
