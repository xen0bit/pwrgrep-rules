# rules: avoid-yum-update
# languages: dockerfile
# fixture: dockerfile/CWE-yum-update.dockerfile
# from: dockerfile/best-practice/avoid-yum-update.yaml

. as $root
| ( ($root | scan_regex(["Dockerfile*","*.dockerfile"]; [
      "yum\\s+update"
    ])) as $all
    | ( $all | of(["yum\\s+update"])
        | finding("avoid-yum-update";
            "Packages in base images should be up-to-date, removing the need for 'yum update'.") ) )
| report
