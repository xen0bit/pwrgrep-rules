# rules: jdbc-sqli
# languages: java
# fixture: java/CWE-89-jdbc.java
# from: java/lang/security/audit/sqli/jdbc-sqli.yaml

["$R.getParameter($$$_)", "$R.getHeader($$$_)", "$R.getQueryString()", "$R.getCookies()", "$R.getParameterValues($$$_)"] as $src
| ["$S.executeQuery($Q)", "$S.executeUpdate($Q)", "$S.execute($Q)"] as $sinks
| scan_ast("*.java"; $src + $sinks) as $all
| ($all | of($sinks) | focus("Q") | reaching($all | of($src); []) | finding("jdbc-sqli"; "Detected a formatted string in a SQL statement."))
| report
