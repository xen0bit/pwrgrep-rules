# rules: ssrf
# languages: c_sharp
# fixture: csharp/http-client.cs
# from: csharp/lang/security/ssrf/http-client.yaml
#
# The translated whole-method shapes nest gaps inside a modifier-less method
# and match nothing. The sinks name the fetched URL as a hole now, and the
# method parameter reaches it.

["public $T $M($U $A) { $$$BODY }"] as $methods
| ["$Y.GetAsync($U);", "$Y.GetAsync($U, $$$);", "$Y.GetStringAsync($U);",
   "$Y.GetStringAsync($U, $$$);"] as $sinks
| ["using System.Net.Http;"] as $using
| scan_ast("*.cs"; $methods + $sinks + $using) as $all
| ( ($all | of($sinks) | focus("U"))
      | reaching((($all | of($methods) | focus("A"))); ([]))
      | in_files_with($all | of($using))
    | finding("ssrf";
        "SSRF is an attack vector that abuses an application to interact with the internal/external network or the machine itself.") )
| report
