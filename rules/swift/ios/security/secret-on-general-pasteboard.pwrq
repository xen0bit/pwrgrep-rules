# rules: swift-secret-on-general-pasteboard
# languages: swift
# fixture: swift/CWE-200.swift
# from: CWE-200 (Exposure of Sensitive Information), CWE-522, MASVS-PLATFORM-4
#
# `UIPasteboard.general` is shared by every app on the device. The next app the
# user opens can read it with no prompt, no entitlement and - before iOS 16 -
# no notification, and with Universal Clipboard switched on the value is also
# on their Mac and their iPad within seconds of being written.
#
# Copying a password is the case the API is for, and it is also the case that
# has been abused often enough that Apple added `expirationDate` and
# `localOnly` to `setItems(_:options:)` for it. So the rule is not "do not put
# a secret on the pasteboard": it is that a write with neither of those options
# leaves the secret there for whatever comes next.
#
# What is read is the value's name rather than the pasteboard call, because the
# call is the same either way. `UIPasteboard.general.string = note` is a share
# sheet and `= password` is the finding, and the only thing separating them is
# what the programmer called the thing.
#
# The bounded spelling is not in the pattern list at all, so
# `setItems(_:options:)` is invisible to this rule by construction. That is the
# cheapest kind of exclusion there is - the same one `swift-accepts-any-
# certificate` gets from `URLCredential(identity:)`.

[ "UIPasteboard.general.string = $V", "UIPasteboard.general.strings = $V",
  "$$$P.string = $V",
  "UIPasteboard.general.setValue($V, forPasteboardType: $T)",
  "$$$P.setValue($V, forPasteboardType: $T)" ] as $writes
| "(?i)passw|secret|token|api[_-]?key|credential|private[_-]?key|passphrase"
  + "|session[_-]?id|seed[_-]?phrase|mnemonic|card[_-]?number|cvv" as $namesASecret
| "^UIPasteboard\\.general$|(?i)pasteboard|clipboard" as $isTheGeneralBoard
| scan_ast("*.swift"; $writes) as $all
| ( ($all | of(["UIPasteboard.general.string = $V",
                "UIPasteboard.general.strings = $V",
                "UIPasteboard.general.setValue($V, forPasteboardType: $T)"])
     | where_capture("V"; $namesASecret))
    + ($all | of(["$$$P.string = $V", "$$$P.setValue($V, forPasteboardType: $T)"])
       | where_capture("P"; $isTheGeneralBoard)
       | where_capture("V"; $namesASecret)) )
| focus("V")
| finding("swift-secret-on-general-pasteboard";
    "$V goes on the pasteboard every app can read and Universal Clipboard "
    + "copies to the user's other devices; setItems with localOnly and an "
    + "expirationDate bounds it")
| report
