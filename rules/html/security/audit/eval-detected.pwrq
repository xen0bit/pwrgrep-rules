# rules: eval-detected
# languages: html
# fixture: html/eval-detected.html
# from: html/security/audit/eval-detected.yaml

. as $root
| ( ($root | scan_regex(["*.html"]; [
      "eval\\s*\\("
    ])) as $all
    | ( $all | of(["eval\\s*\\("])
        | finding("eval-detected";
            "Detected the use of eval(...).") ) )
| report
