# rules: gcp-cloud-storage-logging
# languages: hcl
# fixture: terraform/gcp-cloud-storage-logging.tf
# from: terraform/gcp/security/gcp-cloud-storage-logging.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"google_storage_bucket\" $ANYTHING {\n  $$$_\n  logging {\n      log_bucket = $$$_\n  }          \n  $$$_\n}",
      "resource \"google_storage_bucket\" $ANYTHING {\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["resource \"google_storage_bucket\" $ANYTHING {\n  $$$_\n}"])
          | outside($all | of(["resource \"google_storage_bucket\" $ANYTHING {\n  $$$_\n  logging {\n      log_bucket = $$$_\n  }          \n  $$$_\n}"]))
        | finding("gcp-cloud-storage-logging";
            "Ensure bucket logs access.") ) )
| report
