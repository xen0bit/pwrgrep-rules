# rules: state-variable-read-in-a-loop
# languages: solidity
# fixture: solidity/state-variable-read-in-a-loop.sol
#
# The ported identifier-span machinery matches every token in and around
# loops, firing many times per line, and state names cannot be correlated
# to declarations with RE2. Rewritten as an audit over loop headers: each
# finding names a loop whose body the reviewer checks for state reads.
# from: solidity/performance/state-variable-read-in-a-loop.yaml

. as $root
| ( ($root | scan_regex(["*.sol"]; [
      "for\\s*\\(",
      "while\\s*\\("
    ])) as $all
    | ( $all | of(["for\\s*\\(","while\\s*\\("])
        | finding("state-variable-read-in-a-loop";
            "Replace state variable reads and writes within loops with local variable reads and writes.") ) )
| report
