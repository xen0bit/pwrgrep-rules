# rules: remote-property-injection
# languages: javascript, typescript
# fixture: javascript/remote-property-injection.js
# from: javascript/express/security/audit/remote-property-injection.yaml
#
# Repair: dead as written. The `$INDEX` lone hole matched everything while
# `$OBJ[$$$] = $$$` with bare holes never matched, and `at_same_place`
# needed exact span coincidence. The sink is now `$OBJ[$KEY] = $VAL` focused
# on the key with static-literal exclusions, and sources are taken `within`
# fixed handler wrappers. Globs cover *.js as well as *.ts.

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$APP.$METHOD($$$_, function $FUNC($REQ, $RES) {$$$_})",
      "$APP.$METHOD($$$_, function $FUNC($REQ, $RES, $NEXT) {$$$_})",
      "$APP.$METHOD($$$_, function ($REQ, $RES) {$$$_})",
      "$APP.$METHOD($$$_, function ($REQ, $RES, $NEXT) {$$$_})",
      "$OBJ[$KEY] = $VAL",
      "$OBJ[\"$LIT\"] = $VAL",
      "$OBJ[$KEY] = \"$LIT\"",
      "$REQ.body",
      "$REQ.cookies",
      "$REQ.headers",
      "$REQ.params",
      "$REQ.query",
      "({ $REQ }: Request,$RES: Response) => {$$$_}",
      "({ $REQ }: Request,$RES: Response, $NEXT: NextFunction) =>\n{$$$_}",
      "body",
      "cookies",
      "function ($REQ, $RES) {$$$_}",
      "function $FUNC($REQ, $RES) {$$$_}",
      "function ($REQ, $RES, $NEXT) {$$$_}",
      "function $FUNC($REQ, $RES, $NEXT) {$$$_}",
      "headers",
      "params",
      "query",
      "var $X = $$$_",
      "var $X = $REQ.$ANY"
    ])) as $all
    | ( (($all | of(["$OBJ[$KEY] = $VAL"])
          | outside($all | of(["$OBJ[\"$LIT\"] = $VAL"]))
          | outside($all | of(["$OBJ[$KEY] = \"$LIT\""]))
          | focus("KEY")))
          | reaching(((($all | of(["$REQ.query","$REQ.body","$REQ.params","$REQ.cookies","$REQ.headers"]))
          | within((($all | of(["function ($REQ, $RES) {$$$_}","function $FUNC($REQ, $RES) {$$$_}"]))
          + ($all | of(["function ($REQ, $RES, $NEXT) {$$$_}","function $FUNC($REQ, $RES, $NEXT) {$$$_}"]))
          + ((($all | of(["$APP.$METHOD($$$_, function $FUNC($REQ, $RES) {$$$_})","$APP.$METHOD($$$_, function ($REQ, $RES) {$$$_})"]))
          + ($all | of(["$APP.$METHOD($$$_, function $FUNC($REQ, $RES, $NEXT) {$$$_})","$APP.$METHOD($$$_, function ($REQ, $RES, $NEXT) {$$$_})"])))
          | where_capture("METHOD"; "^(get|post|put|head|delete|options)$")))))
              + (($all
          | within($all | of(["({ $REQ }: Request,$RES: Response, $NEXT: NextFunction) =>\n{$$$_}"])))
          + ($all
          | within($all | of(["({ $REQ }: Request,$RES: Response) => {$$$_}"])))
          | at_same_place(($all | of(["params","query","cookies","headers","body"])))
          | focus("REQ")));
              (($all | of(["var $X = $$$_"])
          | not_at($all | of(["var $X = $REQ.$ANY"])))))
        | finding("remote-property-injection";
            "Bracket object notation with user input is present, this might allow an attacker to access all properties of the object and even it's prototype.") ) )
| report
