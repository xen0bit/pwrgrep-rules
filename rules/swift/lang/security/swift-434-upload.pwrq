# rules: swift-434-upload
# languages: swift
# fixture: swift/CWE-434.swift
# from: CWE-434 (Unrestricted Upload of File with Dangerous Type)
#
# FileManager createFile without ext check.
# The rule tracks uploaded file path reaching createFile and excludes allowlist via where_capture_not.

["$FILE.name", "$FILE.filename", "$FILE.originalFilename", "uploadedFile.name", "requestData.fileName"] as $src
| ["FileManager.default.createFile(atPath: $PATH, $$$_)", "FileManager.default.createFile(atPath: $PATH, contents: $$$_)", "Data.write(to: $PATH)", "FileManager.createFile($PATH, $$$_)"] as $sink
| scan_ast("*.swift"; $src + $sink) as $all
| ( $all | of($sink) | focus("PATH") | reaching($all | of($src); []) | where_capture_not("PATH"; "allowlist|whitelist|\\.png|\\.jpg|\\.jpeg") )
| finding("swift-434-upload"; "Unrestricted upload: $PATH from upload reaches FileManager createFile without extension allowlist")
| report
