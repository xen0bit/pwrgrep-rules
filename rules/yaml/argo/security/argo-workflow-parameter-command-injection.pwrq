# rules: argo-workflow-parameter-command-injection
# languages: yaml
# fixture: yaml/argo-command-injection.yaml
#
# The multi-line command shapes never coincide, so the rule never fired.
# Rewritten as a script-source block containing a {{parameter}} reference,
# in files carrying an argoproj apiVersion. Blocks use lazy bodies.
# from: yaml/argo/security/argo-workflow-parameter-command-injection.yaml

. as $root
| ( ($root | scan_regex(["*.yaml","*.yml"]; [
      "source:\\s*\\|[^\n]*((?:\n          [^\n]*)*)",
      "argoproj\\.io"
    ])) as $all
    | ( $all | of(["source:\\s*\\|[^\n]*((?:\n          [^\n]*)*)"])
          | where_text("\\{\\{")
          | in_files_with($all | of(["argoproj\\.io"]))
        | finding("argo-workflow-parameter-command-injection";
            "Using input or workflow parameters in here-scripts can lead to command injection or code injection.") ) )
| report
