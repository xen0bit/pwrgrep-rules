# rules: elixir-command-injection
# languages: elixir
# fixture: elixir/CWE-78.ex
# from: CWE-78 (OS Command Injection)

. as $root
| ( $root | scan_ast(["*.ex"]; ["System.cmd($A, $B)", "System.shell($CMD)"]) ) as $all
| ( ( $all | of(["System.cmd($A, $B)"]) | where_capture_not("A"; "^\".*\"$") | finding("elixir-command-injection";
        "this hands a value the caller chose to a shell, so a `;` or a backtick "
        + "in it starts a second command; pass the program and its arguments "
        + "separately instead") )
  + ( $all | of(["System.shell($CMD)"]) | where_capture_not("CMD"; "^\".*\"$") | finding("elixir-command-injection";
        "this hands a value the caller chose to a shell, so a `;` or a backtick "
        + "in it starts a second command; pass the program and its arguments "
        + "separately instead") ) )
| report
