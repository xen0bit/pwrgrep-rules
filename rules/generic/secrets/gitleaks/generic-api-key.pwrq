# rules: generic-api-key
# languages:
# fixture: generic/generic-api-key.txt
# from: generic/secrets/gitleaks/generic-api-key.yaml
#
# The entropy test is not enough on its own, and the two guards under it are
# what it misses. `unique_owner_pet_name` in the string
# `"Duplicate key: unique_owner_pet_name"` passes an entropy check - it is
# twenty-one characters of mixed letters - and is an identifier in a test.
# So a candidate has to carry a digit somewhere, which almost every issued
# credential does and almost no English-shaped identifier does, and a run of
# lowercase words joined by underscores is refused outright.

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)(?:key|api|token|secret|client|passwd|password|auth|access)[0-9A-Za-z\\-_\\.\\t]{0,20}[\\s'\\\"]{0,3}(?:=|>|:=|\\|\\|:|<=|=>|:)[\\s'\\\"`=@]{0,5}(?P<SECRET>[0-9A-Za-z\\-_.=~@]{10,150})"
    ])) as $all
    | ( $all | of(["(?i)(?:key|api|token|secret|client|passwd|password|auth|access)[0-9A-Za-z\\-_\\.\\t]{0,20}[\\s'\\\"]{0,3}(?:=|>|:=|\\|\\|:|<=|=>|:)[\\s'\\\"`=@]{0,5}(?P<SECRET>[0-9A-Za-z\\-_.=~@]{10,150})"])
          | where_capture_entropy("SECRET")
          | where_capture_not("SECRET"; "(?i)^(example|test|sample|placeholder|changeme|xxx|fake|dummy|redacted)$")
          | where_capture_not("SECRET"; ".*\\.(bin|json|exe)$")
          | where_capture("SECRET"; "[0-9]")
          | where_capture_not("SECRET"; "^[a-z]+(?:_[a-z]+)+$")
        | finding("generic-api-key";
        "this is a gitleaks generic api key written into the source, so it is in every checkout "
        + "and every image built from one; read it from the environment, and "
        + "rotate this one because it has leaked") ) )
| report
