# rules: jwt-exposed-data
# languages: javascript, typescript
# fixture: javascript/jwt-exposed-data.js
# from: javascript/jsonwebtoken/security/audit/jwt-exposed-data.yaml
#
# Coincidence of whole-match spans can never say "the signed value is the
# parameter": a call span is not a function span, so at_same_place let a
# literal object through. The sink arg is focused and reached from the
# focused parameter instead, which a bare parameter taints under its own
# name; a literal payload has no flow and goes quiet.

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "const $JWT = require('jsonwebtoken')",
      "var $JWT = require('jsonwebtoken')",
      "$JWT = require('jsonwebtoken');\n$$$_",
      "$JWT.sign($INPUT,$$$_)",
      "function $F($$$_,$INPUT,$$$_) {$$$_}",
      "function ($$$_,$INPUT,$$$_) {$$$_}"
    ])) as $all
    | ( $all | of(["$JWT.sign($INPUT,$$$_)"]) | focus("INPUT")
        | reaching(($all | of(["function $F($$$_,$INPUT,$$$_) {$$$_}",
      "function ($$$_,$INPUT,$$$_) {$$$_}"]) | focus("INPUT")); [])
        | in_files_with($all | of(["const $JWT = require('jsonwebtoken')",
      "var $JWT = require('jsonwebtoken')",
      "$JWT = require('jsonwebtoken');\n$$$_"]))
        | finding("jwt-exposed-data";
            "The object is passed strictly to jsonwebtoken.sign(...) Make sure that sensitive information is not exposed through JWT token payload.") ) )
| report
