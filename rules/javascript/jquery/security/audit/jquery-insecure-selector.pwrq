# rules: jquery-insecure-selector
# languages: javascript, typescript
# fixture: javascript/jquery-insecure-selector.js
# from: javascript/jquery/security/audit/jquery-insecure-selector.yaml
#
# Repair: the translated rule reported every `$(...)` whose argument was a
# bare identifier inside any function that had one - 5,089 findings, and 75%
# of the ones the audit judged had a rationale saying the call was safe,
# because a parameter passed to jQuery is usually a static selector built
# just above. What is demonstrable is the selector built from the URL, which
# the page does not own: `$(location.hash)` and `$(window.location.search)`
# are parsed as markup when the fragment looks like one (CVE-2020-11022).

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$($SEL)",
      "$(\"#\" + $SEL)",
      "$('#' + $SEL)",
      "$($SEL + \"\")",
      "$(\"#\" + $SEL + \"\")"
    ])) as $all
    | ( ($all | of(["$($SEL)","$(\"#\" + $SEL)","$('#' + $SEL)","$($SEL + \"\")","$(\"#\" + $SEL + \"\")"])
          | where_capture("SEL"; "(?i)(location|document\\.URL|document\\.referrer|document\\.documentURI|document\\.location|window\\.location)"))
        | finding("jquery-insecure-selector";
            "a selector built from `$SEL` is parsed as markup, and the URL is "
            + "written by whoever sent the link; build the selector from a "
            + "fixed list, or pass the value to `.text()`") ) )
| report
