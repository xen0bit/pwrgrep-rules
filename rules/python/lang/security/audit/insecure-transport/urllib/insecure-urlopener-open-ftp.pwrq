# rules: insecure-urlopener-open-ftp
# languages: python
# fixture: python/insecure-urlopener-open-ftp.py
#
# The translated patterns embedded a Semgrep `=~/.../` regex inside a string literal, where the matcher reads it as literal text, so the rule could never fire. Each literal is now a $P hole guarded by where_capture with the same character class (quote-anchored, since captures carry their quotes); the finding set is unchanged.
# from: python/lang/security/audit/insecure-transport/urllib/insecure-urlopener-open-ftp.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "$OPENERDIRECTOR = urllib.request.URLopener($$$_)\n$$$_",
      "$OPENERDIRECTOR.open($P, $$$_)",
      "$OPENERDIRECTOR.open($URL, $$$_)",
      "$URL = $P\n$$$_\n$OPENERDIRECTOR.open($URL, $$$_)",
      "$URL = $P\n$$$_\nurllib.request.URLopener($$$_).open($URL, $$$_)",
      "def $FUNC($$$_, $URL = $P, $$$_):\n  $$$_BODY",
      "urllib.request.URLopener($$$_).open($P, $$$_)",
      "urllib.request.URLopener($$$_).open($URL, $$$_)"
    ])) as $all
    | ( ($all | of(["urllib.request.URLopener($$$_).open($P, $$$_)"]) | where_capture("P"; "^['\"][Ff][Tt][Pp]://"))
        + ($all | of(["$OPENERDIRECTOR.open($P, $$$_)"]) | in_files_with($all | of(["$OPENERDIRECTOR = urllib.request.URLopener($$$_)\n$$$_"])) | where_capture("P"; "^['\"][Ff][Tt][Pp]://"))
        + ($all | of(["$URL = $P\n$$$_\n$OPENERDIRECTOR.open($URL, $$$_)"]) | in_files_with($all | of(["$OPENERDIRECTOR = urllib.request.URLopener($$$_)\n$$$_"])) | where_capture("P"; "^['\"][Ff][Tt][Pp]://"))
        + ($all | of(["$URL = $P\n$$$_\nurllib.request.URLopener($$$_).open($URL, $$$_)"]) | where_capture("P"; "^['\"][Ff][Tt][Pp]://"))
        + ($all | of(["urllib.request.URLopener($$$_).open($URL, $$$_)"]) | within($all | of(["def $FUNC($$$_, $URL = $P, $$$_):\n  $$$_BODY"]) | where_capture("P"; "^['\"][Ff][Tt][Pp]://")))
        + ($all | of(["$OPENERDIRECTOR.open($URL, $$$_)"]) | in_files_with($all | of(["$OPENERDIRECTOR = urllib.request.URLopener($$$_)\n$$$_"])) | within($all | of(["def $FUNC($$$_, $URL = $P, $$$_):\n  $$$_BODY"]) | where_capture("P"; "^['\"][Ff][Tt][Pp]://"))) )
        | finding("insecure-urlopener-open-ftp";
            "Detected an unsecured transmission channel.") )
| report
| report
