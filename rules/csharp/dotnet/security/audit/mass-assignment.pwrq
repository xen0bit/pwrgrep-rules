# rules: mass-assignment
# languages: c_sharp
# fixture: csharp/mass-assignment.cs
#
# The action linchpins were bodies written `$$$`, which compile to a statement
# literally named `$$$`, and the MVC `using` ended in a dead gap. Both read
# whole bodies and plain imports now.
# from: csharp/dotnet/security/audit/mass-assignment.yaml

. as $root
| ( ($root | scan_ast(["*.cs"]; [
      "View($$$_)",
      "public ActionResult $METHOD($$$_, $TYPE $ARG, $$$_){\n  $$$BODY\n}",
      "public ActionResult $METHOD($$$_, [Bind($$$_)] $TYPE $ARG, $$$_){\n  $$$BODY\n}",
      "public IActionResult $METHOD($$$_, $TYPE $ARG, $$$_){\n  $$$BODY\n}",
      "public IActionResult $METHOD($$$_, [Bind($$$_)] $TYPE $ARG, $$$_){\n  $$$BODY\n}",
      "using Microsoft.AspNetCore.Mvc;"
    ])) as $all
    | ( (($all | of(["View($$$_)"])))
          | reaching((($all | of(["public IActionResult $METHOD($$$_, $TYPE $ARG, $$$_){\n  $$$BODY\n}","public ActionResult $METHOD($$$_, $TYPE $ARG, $$$_){\n  $$$BODY\n}"])
          | in_files_with($all | of(["using Microsoft.AspNetCore.Mvc;"]))
          | not_at($all | of(["public IActionResult $METHOD($$$_, [Bind($$$_)] $TYPE $ARG, $$$_){\n  $$$BODY\n}"]))
          | not_at($all | of(["public ActionResult $METHOD($$$_, [Bind($$$_)] $TYPE $ARG, $$$_){\n  $$$BODY\n}"]))
          | focus("ARG")));
              ([]))
        | finding("mass-assignment";
            "Mass assignment or Autobinding vulnerability in code allows an attacker to execute over-posting attacks, which could create a new parameter in the binding request and manipulate the underlying object in the application.") ) )
| report
