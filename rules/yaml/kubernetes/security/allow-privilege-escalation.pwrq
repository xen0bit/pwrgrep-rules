# rules: allow-privilege-escalation
# languages: yaml
# fixture: yaml/k8s-allow-privilege-escalation.yaml
# from: yaml/kubernetes/security/allow-privilege-escalation.yaml

. as $root
| ($root | scan_ast(["*.yaml","*.yml"]; [
      "allowPrivilegeEscalation: true"
    ])) as $all
| ($all | of(["allowPrivilegeEscalation: true"]) | finding("allow-privilege-escalation"; "In Kubernetes, each pod runs in its own isolated environment with its own set of security policies."))
| report
