# rules: elixir-ssrf
# languages: elixir
# fixture: elixir/CWE-918.ex
# from: CWE-918 (SSRF)

. as $root
| ( $root | scan_ast(["*.ex"]; ["HTTPoison.get($URL)"]) ) as $all
| ( $all | of(["HTTPoison.get($URL)"]) | where_capture_not("URL"; "^\".*\"$") | finding("elixir-ssrf";
        "the destination of this request is a value the caller chose, so it can "
        + "be pointed at the metadata service or anything else this host can "
        + "reach; check it against the hosts you meant to allow") )
| report
