# rules: php-open-redirect
# languages: php
# fixture: php/CWE-601b.php
# from: CWE-601 (Open Redirect)
#
# header('Location: ' . $_GET['url']) with tainted data.
#
# A PHP superglobal cannot be written into a pattern: `$_GET` is a `$` and
# a name, which is how a hole is spelled, so `$_GET[$K]` reads as "any
# variable subscripted by anything". The four spellings were one pattern
# four times over, and the source set was every array access in the file.
# The name is pinned by guard on the capture instead, whose text carries
# the `$`.

["$T $V = $S;"] as $assigned
| ["header($H, $$$_)"] as $sinks
| ["$SG[$K]"] as $srcDirect
| scan_ast("*.php"; $assigned + $sinks + $srcDirect) as $all
| ( ($all | of($assigned) | where_capture("S"; "\\$_GET|\\$_POST|\\$_REQUEST") | focus("S")) + ($all | of($srcDirect) | where_capture("SG"; "^\\$_(?:GET|POST|REQUEST|COOKIE)$")) ) as $untrusted
| ($all | of($sinks) | where_capture("H"; "(?i)Location:") | focus("H"))
| reaching($untrusted; [])
| finding("php-open-redirect"; "Open redirect: header Location with tainted $_GET/$_POST")
| report
