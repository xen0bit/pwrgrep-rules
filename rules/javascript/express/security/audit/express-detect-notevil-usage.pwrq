# rules: express-detect-notevil-usage
# languages: javascript, typescript
# fixture: javascript/express-detect-notevil-usage.js
# from: javascript/express/security/audit/express-detect-notevil-usage.yaml
#
# Repair: dead as written. The file gate `$EVAL = require('notevil')` missed
# const/let/var declarations, and the literal-argument exclusion
# `$EVAL('$$$_')` read its hole as any value, so it subtracted every call.
# The exclusion now spells the literal argument and keeps only quoted text
# (the angular-open-redirect shape), the require itself is excluded by span,
# and the gates cover all declaration forms. The trailing bare `$$$` in the
# `vm.*` shapes never matched, now `$$$_`.

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$EVAL($ARG)",
      "$EVAL($LIT)",
      "$EVAL = require('notevil')\n$$$_",
      "$VM.compileFunction(\"$CMD\", $$$_)",
      "$VM.runInContext(\"$CMD\", $$$_)",
      "$VM.runInNewContext(\"$CMD\", $$$_)",
      "$VM.runInThisContext(\"$CMD\", $$$_)",
      "const $EVAL = require('notevil')",
      "import $EVAL from 'notevil'\n$$$_",
      "import {$EVAL} from 'notevil'\n$$$_",
      "let $EVAL = require('notevil')",
      "var $EVAL = require('notevil')"
    ])) as $all
    | ( (($all | of(["$EVAL($ARG)"])
          | not_at(($all | of(["$EVAL($LIT)"]) | where_capture("LIT"; "^[\"']")))
          | outside(($all | of(["$EVAL = require('notevil')\n$$$", "const $EVAL = require('notevil')", "let $EVAL = require('notevil')", "var $EVAL = require('notevil')"])))
          + ($all | of(["$VM.runInContext(\"$CMD\", $$$_)","$VM.runInNewContext(\"$CMD\", $$$_)","$VM.runInThisContext(\"$CMD\", $$$_)","$VM.compileFunction(\"$CMD\", $$$_)"]))))
          | in_files_with(($all | of(["$EVAL = require('notevil')\n$$$", "const $EVAL = require('notevil')", "let $EVAL = require('notevil')", "var $EVAL = require('notevil')"])) + ($all | of(["import $EVAL from 'notevil'\n$$$", "import {$EVAL} from 'notevil'\n$$$"])))
        | finding("express-detect-notevil-usage";
            "Detected usage of the `notevil` package, which is unmaintained and has vulnerabilities.") ) )
| report
