# rules: detected-newrelic-token
# languages:
# fixture: generic/detected-newrelic-token.txt
# from: CWE-798 (Use of Hard-coded Credentials)
#
# Newrelic token hardcoded.

. as $root
| ( ($root | scan_regex(["*"]; [
      "newrelic_(?P<SECRET>[A-Za-z0-9_\\-]{20,})"
    ])) as $all
    | ( $all | of(["newrelic_(?P<SECRET>[A-Za-z0-9_\\-]{20,})"])
          | where_capture_entropy("SECRET")
        | finding("detected-newrelic-token";
        "this is a newrelic token written into the source, so it is in every checkout "
        + "and every image built from one; read it from the environment, and "
        + "rotate this one because it has leaked") ) )
| report
