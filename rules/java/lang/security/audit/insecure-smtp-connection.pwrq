# rules: insecure-smtp-connection
# languages: java
# fixture: java/insecure-smtp-connection.java
# from: java/lang/security/audit/insecure-smtp-connection.yaml
#
# The construction gate was a bare assignment with a trailing gap, which
# never matches a declaration. It names the declaration now.

. as $root
| ( ($root | scan_ast(["*.java"]; [
      "$T $EMAIL = new SimpleEmail($$$_);",
      "$EMAIL.send($$$_);",
      "$EMAIL.setSSLCheckServerIdentity(true);\n$$$_"
    ])) as $all
    | ( $all | of(["$EMAIL.send($$$_);"])
          | in_files_without($all | of(["$EMAIL.setSSLCheckServerIdentity(true);\n$$$_"]))
          | in_files_with($all | of(["$T $EMAIL = new SimpleEmail($$$_);"]))
        | finding("insecure-smtp-connection";
            "Insecure SMTP connection detected.") ) )
| report
