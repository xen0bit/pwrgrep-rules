# rules: pull-request-target-code-checkout
# languages: yaml
# fixture: yaml/gh-pull-request-target.yaml
# from: yaml/github-actions/security/pull-request-target-code-checkout.yaml

. as $root
| ( ($root | scan_regex(["*.yaml","*.yml"]; [
      "pull_request_target:"
    ])) as $all
    | ( $all | of(["pull_request_target:"])
        | finding("pull-request-target-code-checkout";
            "This GitHub Actions workflow file uses `pull_request_target` and checks out code from the incoming pull request.") ) )
| report
