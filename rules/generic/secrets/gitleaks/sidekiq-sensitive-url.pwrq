# rules: sidekiq-sensitive-url
# fixture: generic/sidekiq-sensitive-url.txt
# from: generic/secrets/gitleaks/sidekiq-sensitive-url.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)\\b(http(?:s??):\\/\\/)([a-f0-9]{8}:[a-f0-9]{8})@(?:gems.contribsys.com|enterprise.contribsys.com)(?:[\\/|\\#|\\?|:]|$)"
    ])) as $all
    | ( $all | of(["(?i)\\b(http(?:s??):\\/\\/)([a-f0-9]{8}:[a-f0-9]{8})@(?:gems.contribsys.com|enterprise.contribsys.com)(?:[\\/|\\#|\\?|:]|$)"])
        | finding("sidekiq-sensitive-url";
            "A gitleaks sidekiq-sensitive-url was detected which attempts to identify hard-coded credentials.") ) )
| report
