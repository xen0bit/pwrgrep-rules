# rules: detected-sendgrid-api-key
# fixture: generic/detected-sendgrid-api-key.txt
# from: generic/secrets/security/detected-sendgrid-api-key.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "SG\\.[a-zA-Z0-9]{22}\\.[a-zA-Z0-9-]{43}\\b"
    ])) as $all
    | ( $all | of(["SG\\.[a-zA-Z0-9]{22}\\.[a-zA-Z0-9-]{43}\\b"])
        | finding("detected-sendgrid-api-key";
        "this is a sendgrid api key written into the source, so it is in every checkout "
        + "and every image built from one; read it from the environment, and "
        + "rotate this one because it has leaked") ) )
| report
