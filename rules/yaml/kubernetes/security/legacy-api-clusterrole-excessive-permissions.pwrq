# rules: legacy-api-clusterrole-excessive-permissions
# languages: yaml
# fixture: yaml/k8s-legacy-clusterrole.yaml
#
# Trailing statement gaps and the within scope never matched, so the rule
# never fired. Rewritten with gapless file-level checks: any star string
# in a core ClusterRole file flags. Same-block confirmation is reviewer work.
# from: yaml/kubernetes/security/legacy-api-clusterrole-excessive-permissions.yaml

. as $root
| ( ($root | scan_ast(["*.yaml","*.yml"]; [
      "\"*\"",
      "- apiGroups: [\"\"]",
      "apiVersion: rbac.authorization.k8s.io/v1",
      "kind: ClusterRole",
      "resources: $A",
      "verbs: $A"
    ])) as $all
    | ( $all | of(["\"*\""])
          | in_files_with($all | of(["- apiGroups: [\"\"]"]))
          | in_files_with($all | of(["resources: $A"]))
          | in_files_with($all | of(["verbs: $A"]))
          | in_files_with($all | of(["apiVersion: rbac.authorization.k8s.io/v1"]))
          | in_files_with($all | of(["kind: ClusterRole"]))
        | finding("legacy-api-clusterrole-excessive-permissions";
            "Semgrep detected a Kubernetes core API ClusterRole with excessive permissions.") ) )
| report
