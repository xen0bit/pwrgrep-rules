# rules: pg-sqli
# languages: go
# fixture: go/pg-sqli.go
#
# In Go a quoted $$$_ matches any argument, so the literal-only subtractions (a "$$$_" call-operand pair and literal-built $QUERY file tests, each paired with a bare string that matches anywhere) excluded every file and every call. The literal tests now bind $S/$T and keep only full string literals via guard; the vacuous bare-string partners are dropped.
# from: go/lang/security/audit/sqli/pg-sqli.yaml

. as $root
| ( ($root | scan_ast(["*.go"]; [
      "$DB = pg.Connect($$$_)\n$$$_",
      "$DB.$METHOD($$$_, $S + $T, $$$_)",
      "$DB.$METHOD($$$_, $X + $Y, $$$_)",
      "$DB.$METHOD($$$_, fmt.Sprintf(\"$$$_\", $PARAM1, $$$_), $$$_)",
      "$DB.$METHOD($$$_,$QUERY,$$$_)",
      "$QUERY += $S\n$$$_",
      "$QUERY += $X\n$$$_",
      "$QUERY = $S + $T\n$$$_",
      "$QUERY = $X + $Y\n$$$_",
      "$QUERY = fmt.Sprintf(\"$$$_\", $PARAM1, $$$_)\n$$$_",
      "func $FUNCNAME($$$_, $DB *pg.DB, $$$_) {\n  $$$_\n}"
    ])) as $all
    | ( ($all | of(["$DB.$METHOD($$$_,$QUERY,$$$_)"])
          | at_same_place((($all
          | in_files_with($all | of(["$QUERY = $X + $Y\n$$$_"])))
          + ($all
          | in_files_with($all | of(["$QUERY += $X\n$$$_"])))
          + ($all
          | in_files_with($all | of(["$QUERY = fmt.Sprintf(\"$$$_\", $PARAM1, $$$_)\n$$$_"])))))
          | in_files_without($all | of(["$QUERY += $S\n$$$_"]) | where_capture("S"; "^\"[^\"]*\"$"))
          | in_files_without($all | of(["$QUERY = $S + $T\n$$$_"]) | where_capture("S"; "^\"[^\"]*\"$") | where_capture("T"; "^\"[^\"]*\"$")))
          + ($all | of(["$DB.$METHOD($$$_, $X + $Y, $$$_)"]))
          + ($all | of(["$DB.$METHOD($$$_, fmt.Sprintf(\"$$$_\", $PARAM1, $$$_), $$$_)"]))
          | at_same_place((($all
          | in_files_with($all | of(["$DB = pg.Connect($$$_)\n$$$_"])))
          + ($all
          | within($all | of(["func $FUNCNAME($$$_, $DB *pg.DB, $$$_) {\n  $$$_\n}"])))))
          | not_at($all | of(["$DB.$METHOD($$$_, $S + $T, $$$_)"]) | where_capture("S"; "^\"[^\"]*\"$") | where_capture("T"; "^\"[^\"]*\"$"))
          | where_capture("METHOD"; "^(Exec|ExecContext|ExecOne|ExecOneContext|Query|QueryOne|QueryContext|QueryOneContext)$")
        | finding("pg-sqli";
            "Detected string concatenation with a non-literal variable in a go-pg SQL statement.") ) )
| report
