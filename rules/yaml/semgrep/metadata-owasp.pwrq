# rules: metadata-owasp
# languages: yaml
# fixture: yaml/semgrep-metadata-owasp.yaml
#
# The OWASP tag check compared file-spanning shapes that never coincide,
# so the rule never fired. Rewritten as string and first-list-item matches
# with a Top-10 number:year guard. Later list items are out of scope.
# A `rules:` key at column zero is what says the file is a Semgrep rule and
# not something else that spells a key the same way: `metadata:` is every
# Kubernetes manifest, `- id:` is any list of records, and `message: |` is
# any workflow that writes more than a line.
# from: yaml/semgrep/metadata-owasp.yaml

. as $root
| ($root | scan_regex(["*.yaml","*.yml"]; [
      "(?m)^rules:[^\\S\n]*$"
    ])) as $semgrep
| ( (($root | scan_regex(["*.yaml","*.yml"]; [
      "owasp:\\s*\"(?P<O>[^\"\n]*)\"",
      "owasp:[^\\S\n]*\n\\s+-\\s+(?P<O>\\S+)"
    ])) | in_files_with($semgrep)) as $all
    | ( (($all | of(["owasp:\\s*\"(?P<O>[^\"\n]*)\""]) | where_capture_not("O"; "^(A\\d\\d|K\\d\\d|LLM\\d\\d):\\d{4}"))
          + ($all | of(["owasp:[^\\S\n]*\n\\s+-\\s+(?P<O>\\S+)"]) | where_capture_not("O"; "^(A\\d\\d|K\\d\\d|LLM\\d\\d):"))
        | finding("metadata-owasp";
            "The `owasp` tag in Semgrep rule metadata should start with the format \"A00:YYYY\", where A00 is the OWASP Top 10 number and YYYY is the OWASP Top 10 year.") ) ) )
| report
