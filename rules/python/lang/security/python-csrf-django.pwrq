# rules: python-csrf-django
# languages:
# fixture: python/CWE-352.py
# from: CWE-352 Cross-Site Request Forgery
#
# The file has to be Django. A `<form method="post">` with no `{% csrf_token %}`
# is a finding in a Django template and nothing at all in a Thymeleaf, ERB or
# Handlebars one, where the framework writes the token itself under another
# name - and `*.html` is `*.html` in every repository there is. Run over Spring
# PetClinic, whose templates are Thymeleaf, the unguarded rule reported three
# forms that Spring protects automatically.
#
# Django templates that render a POST form without {% csrf_token %} allow
# an attacker to submit the form from another origin. The fixture marks
# forms with method POST/PUT/DELETE/PATCH that lack the token as vulnerable;
# those that include {% csrf_token %} or {{ csrf_token }} are ok.
# This uses scan_regex because the pattern is HTML, not Python code.
# The query is scan_regex over *.html and *.py (templates may be inline).

. as $root
| ($root | scan_regex(["*.html", "*.py"];
    ["\\{%\\s*(?:csrf_token|extends|block|load|include|if|for|url)\\b",
     "from\\s+django\\b", "import\\s+django\\b"])) as $isDjango
| ( ($root | scan_regex(["*.html", "*.py"]; [
      "<form[^>]*method=\"(?P<METHOD>[^\"]+)\"[^>]*>[\\s\\S]*?<\\/form>",
      "<form[^>]*method='(?P<METHOD>[^']+)'[^>]*>[\\s\\S]*?<\\/form>",
      "<form[^>]*method=(?P<METHOD>[^\\s>]+)[^>]*>[\\s\\S]*?<\\/form>"
    ])) as $all
    | ( $all | of(["<form[^>]*method=\"(?P<METHOD>[^\"]+)\"[^>]*>[\\s\\S]*?<\\/form>","<form[^>]*method='(?P<METHOD>[^']+)'[^>]*>[\\s\\S]*?<\\/form>","<form[^>]*method=(?P<METHOD>[^\\s>]+)[^>]*>[\\s\\S]*?<\\/form>"])
          | where_capture("METHOD"; "(?i)^(post|put|delete|patch)$")
          | where_text_not("csrf_token")
          | in_files_with($isDjango)
        | finding("python-csrf-django";
            "Manually-created POST form lacks {% csrf_token %}; add it to prevent CSRF attacks") ) )
| report
