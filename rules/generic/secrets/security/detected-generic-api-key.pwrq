# rules: detected-generic-api-key
# fixture: generic/detected-generic-api-key.txt
# from: generic/secrets/security/detected-generic-api-key.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "[aA][pP][iI]_?[kK][eE][yY][=_:\\s-]+['|\"]?(?<SECRET>[0-9a-zA-Z]{32,45})['|\"]?"
    ])) as $all
    | ( $all | of(["[aA][pP][iI]_?[kK][eE][yY][=_:\\s-]+['|\"]?(?<SECRET>[0-9a-zA-Z]{32,45})['|\"]?"])
          | where_capture_entropy("SECRET")
        | finding("detected-generic-api-key";
        "this is a generic api key written into the source, so it is in every checkout "
        + "and every image built from one; read it from the environment, and "
        + "rotate this one because it has leaked") ) )
| report
