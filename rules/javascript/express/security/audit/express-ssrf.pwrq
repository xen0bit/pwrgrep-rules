# rules: express-ssrf
# languages: javascript, typescript
# fixture: javascript/express-ssrf.js
# from: javascript/express/security/audit/express-ssrf.yaml
#
# Repair: `function $$$_ (...)` matched only named declarations and `at_same_place` needed exact span coincidence, so the request shapes never connected to a source; wrappers now cover anon and named shapes, the `request` gates are file-level, and the sink is one `$URL` hole with the method filtered by `where_capture`. Globs cover *.js as well as *.ts.

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$APP.$METHOD($$$_, function $FUNC($REQ, $RES) {$$$_})",
      "$APP.$METHOD($$$_, function $FUNC($REQ, $RES, $NEXT) {$$$_})",
      "$APP.$METHOD($$$_, function ($REQ, $RES) {$$$_})",
      "$APP.$METHOD($$$_, function ($REQ, $RES, $NEXT) {$$$_})",
      "$REQ.query",
      "$REQ.body",
      "$REQ.params",
      "$REQ.cookies",
      "$REQ.headers",
      "$RQ.$METHOD($URL)",
      "$RQ.$METHOD($URL, $OPTS)",
      "$RQ = require('$IMPORT')\n$$$_",
      "const $RQ = require('$IMPORT')",
      "let $RQ = require('$IMPORT')",
      "var $RQ = require('$IMPORT')",
      "import $RQ from '$IMPORT'\n$$$_",
      "import * as $RQ from '$IMPORT'\n$$$_",
      "({ $REQ }: Request,$RES: Response) => {$$$_}",
      "({ $REQ }: Request,$RES: Response, $NEXT: NextFunction) =>\n{$$$_}",
      "body",
      "cookies",
      "headers",
      "params",
      "query",
      "function ($REQ, $RES) {$$$_}",
      "function $FUNC($REQ, $RES) {$$$_}",
      "function ($REQ, $RES, $NEXT) {$$$_}",
      "function $FUNC($REQ, $RES, $NEXT) {$$$_}"
    ])) as $all
    | ( (($all | of(["$RQ.$METHOD($URL)", "$RQ.$METHOD($URL, $OPTS)"])
          | where_capture("METHOD"; "^(get|post|put|patch|del|head|delete)$")
          | focus("URL"))
          | in_files_with(($all | of(["$RQ = require('$IMPORT')\n$$$_", "const $RQ = require('$IMPORT')", "let $RQ = require('$IMPORT')", "var $RQ = require('$IMPORT')"])) + ($all | of(["import $RQ from '$IMPORT'\n$$$_", "import * as $RQ from '$IMPORT'\n$$$_"])))
          )
          | reaching(((($all | of(["$REQ.query", "$REQ.body", "$REQ.params", "$REQ.cookies", "$REQ.headers"]))
          | within((($all | of(["function ($REQ, $RES) {$$$_}", "function $FUNC($REQ, $RES) {$$$_}", "function ($REQ, $RES, $NEXT) {$$$_}", "function $FUNC($REQ, $RES, $NEXT) {$$$_}"])))
          + ((($all | of(["$REQ.query", "$REQ.body", "$REQ.params", "$REQ.cookies", "$REQ.headers"])) | within((($all | of(["$APP.$METHOD($$$_, function $FUNC($REQ, $RES) {$$$_})", "$APP.$METHOD($$$_, function $FUNC($REQ, $RES, $NEXT) {$$$_})"])) + ($all | of(["$APP.$METHOD($$$_, function ($REQ, $RES) {$$$_})", "$APP.$METHOD($$$_, function ($REQ, $RES, $NEXT) {$$$_})"])))) | where_capture("METHOD"; "^(get|post|put|head|delete|options)$")))))
              + (($all
          | within($all | of(["({ $REQ }: Request,$RES: Response, $NEXT: NextFunction) =>\n{$$$_}"])))
          + ($all
          | within($all | of(["({ $REQ }: Request,$RES: Response) => {$$$_}"])))
          | at_same_place(($all | of(["params","query","cookies","headers","body"])))
          | focus("REQ")));
              ([]))
        | finding("express-ssrf";
            "The following request was found to be crafted from user-input which can lead to Server-Side Request Forgery (SSRF) vulnerabilities.") ) )
| report
