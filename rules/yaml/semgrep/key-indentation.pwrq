# rules: yaml-key-indentation-check
# languages: yaml
# fixture: yaml/semgrep-key-indentation.yaml
#
# The rules-span within never encloses list items, so the rule never fired.
# Rewritten as a line-anchored regex for a list dash fused to the key.
# from: yaml/semgrep/key-indentation.yaml

. as $root
| ( ($root | scan_regex(["*.yaml","*.yml"]; [
      "(?m)^\\s*-(?P<KEY>\\w+):\\s*>-"
    ])) as $all
    | ( $all | of(["(?m)^\\s*-(?P<KEY>\\w+):\\s*>-"])
          | focus("KEY")
        | finding("yaml-key-indentation-check";
            "It looks like you have an YAML indentation issue -- instead of writing `$KEY`, put a space between the hyphen and what comes after!") ) )
| report
