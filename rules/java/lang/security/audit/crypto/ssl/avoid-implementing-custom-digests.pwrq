# rules: avoid-implementing-custom-digests
# languages: java
# fixture: java/avoid-implementing-custom-digests.java
# from: java/lang/security/audit/crypto/ssl/avoid-implementing-custom-digests.yaml

. as $root
| ( ($root | scan_ast(["*.java"]; [
      "class $CLASS extends MessageDigest {\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["class $CLASS extends MessageDigest {\n  $$$_\n}"])
        | finding("avoid-implementing-custom-digests";
            "Cryptographic algorithms are notoriously difficult to get right.") ) )
| report
