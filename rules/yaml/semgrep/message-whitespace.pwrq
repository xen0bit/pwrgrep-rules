# rules: message-whitespace-check
# languages: yaml
# fixture: yaml/semgrep-message-whitespace.yaml
#
# The at_same_place pair against regex-literal shapes never coincided, so the
# rule never fired. Rewritten as a block message containing a double space;
# the backslash-escape half is out of scope.
# from: yaml/semgrep/message-whitespace.yaml

. as $root
| ( ($root | scan_regex(["*.yaml","*.yml"]; [
      "message:\\s*>-\\s*(?P<VALUE>[^\n]*)"
    ])) as $all
    | ( $all | of(["message:\\s*>-\\s*(?P<VALUE>[^\n]*)"])
          | where_capture("VALUE"; "  ")
        | finding("message-whitespace-check";
            "It looks like you have an additional space in your rule message, this can look awkward in the finding output, please remove the additional whitespace!") ) )
| report
