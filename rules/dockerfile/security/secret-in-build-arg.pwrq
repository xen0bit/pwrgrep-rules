# rules: secret-in-build-arg
# languages: dockerfile
# fixture: dockerfile/CWE-secret-arg.dockerfile
# from: dockerfile/security/secret-in-build-arg.yaml

. as $root
| ( ($root | scan_regex(["Dockerfile*","*.dockerfile"]; [
      "(?m)(?i)^\\s*ARG\\s+.*(secret|key|password|token)"
    ])) as $all
    | ( $all | of(["(?m)(?i)^\\s*ARG\\s+.*(secret|key|password|token)"])
        | finding("secret-in-build-arg";
            "Docker build time arguments are not suited for secrets, because the argument values are saved with the image.") ) )
| report
