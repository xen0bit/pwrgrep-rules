# rules: math-random-used
# languages: go
# fixture: go/math-random-used.go
# from: go/lang/security/audit/crypto/math_random.yaml
#
# The translation kept the imports with `at_same_place` against the `rand`
# uses, which never share a span, so the rule never fired. The finding is the
# import in a file that uses it, hence `in_files_with`.

. as $root
| ( ($root | scan_ast(["*.go"]; [
      "$$$_\n$RAND.$FUNC($$$_)",
      "$$$_\nrand.$FUNC($$$_)",
      "import \"$MATH\"",
      "import $RAND \"$MATH\""
    ])) as $all
    | ( $all | of(["import $RAND \"$MATH\"","import \"$MATH\""])
          | in_files_with((($all
          | within($all | of(["$$$_\nrand.$FUNC($$$_)"])))
          + ($all
          | within($all | of(["$$$_\n$RAND.$FUNC($$$_)"])))))
          | where_capture("MATH"; "^(math/rand(\\/v[0-9]+)*)$")
          | focus("MATH")
        | finding("math-random-used";
            "Do not use `math/rand`.") ) )
| report
