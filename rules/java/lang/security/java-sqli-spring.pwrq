# rules: java-sqli-spring
# languages: java
# fixture: java/CWE-89-spring.java
# from: CWE-89 SQL Injection
#
# Spring JdbcTemplate and JPA repository calls that build a query from
# request data allow SQL injection. The rule tracks tainted request
# parameters (getParameter, getHeader, etc.) that reach a SQL sink like
# jdbcTemplate.query/queryForObject/update or entityManager.createQuery.
# Safe code uses parameterised queries with ? or named parameters.

["$R.getParameter($K)", "$R.getHeader($K)", "$R.getQueryString()", "$R.getCookies()", "$R.getParameterValues($K)", "$R.getParameterMap()"] as $src
| ["jdbcTemplate.query($Q, $$$_)", "jdbcTemplate.queryForObject($Q, $$$_)", "jdbcTemplate.update($Q, $$$_)", "jdbcTemplate.execute($Q)", "$EM.createQuery($Q, $$$_)", "$EM.createNativeQuery($Q, $$$_)", "$Q = \"SELECT \" + $T"] as $sink
| ["$S.setString($$$_)", "$S.setInt($$$_)", "$S.setObject($$$_)", "PreparedStatement"] as $clean
| scan_ast("*.java"; $src + $sink + $clean) as $all
| ($all | of($sink) | focus("Q") | reaching($all | of($src); $all | of($clean)))
| finding("java-sqli-spring"; "SQL injection: $Q came from the request and reaches a Spring SQL sink")
| report
