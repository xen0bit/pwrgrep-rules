# rules: exposing-docker-socket-volume
# languages: yaml
# fixture: yaml/compose-exposing-socket.yaml
# from: yaml/docker-compose/security/exposing-docker-socket-volume.yaml

. as $root
| ( ($root | scan_regex(["*.yaml","*.yml"]; [
      "/var/run/docker[.]sock:/var/run/docker[.]sock"
    ])) as $all
    | ( $all | of(["/var/run/docker[.]sock:/var/run/docker[.]sock"])
        | finding("exposing-docker-socket-volume";
            "Exposing host's Docker socket to containers via a volume.") ) )
| report
