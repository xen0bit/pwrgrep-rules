# rules: random-fd-exhaustion
# languages: c
# fixture: c/CWE-400.c
# from: c/lang/security/random-fd-exhaustion.yaml, CWE-400, CERT C FIO34-C
#
# read() on /dev/random blocks while the pool is short of entropy, and returns
# -1 with EAGAIN where the descriptor is non-blocking. A caller that does not
# look at the count believes it has random bytes, uses whatever the buffer
# held, and opens the next descriptor - so a loop written this way exhausts
# the process's file descriptors and produces no randomness while doing it.
#
# The check is on where the call was written: a read whose count is assigned
# to something is a read that was looked at, and one written as a statement of
# its own is not. Both spellings of "assigned to something" have to be listed,
# because a declaration with an initialiser and an assignment are different
# constructs, and it was the declaration - which is how this is usually
# written - that the rule did not have.
#
# The finding is moved onto the read rather than onto the open, and that is
# what makes the subtraction work as well as what makes it readable. "Anything
# else here" between the two statements will pair one open with every later
# read of that name, so a checked read further down the function would cancel
# an unchecked one just above it if both were reported at the open they share.
# Focused onto the read, each pairing cancels only itself.

["/dev/random", "/dev/urandom", "/dev/srandom", "/dev/arandom"] as $devices
| ["$FD = open(\"", "$_ $FD = open(\""] as $opens
| [ $opens[] as $open | $devices[] | $open + . + "\", $$$_);\n$$$_\n" ] as $prefixes
| ($prefixes | map(. + "read($R, $$$_);")) as $dropped
| ($prefixes | map(. + "$_ = read($R, $$$_);")
   + ($prefixes | map(. + "$_ $_ = read($R, $$$_);"))) as $kept
| scan_ast("*.[ch]"; $dropped + $kept) as $all
| ( $all | of($dropped) | where_same("FD"; "R") | focus("R")
    | not_at($all | of($kept) | where_same("FD"; "R") | focus("R")) )
| finding("random-fd-exhaustion";
    "the count this read returns is dropped, so a short read or an EAGAIN "
    + "looks like a full buffer of randomness and the next descriptor is "
    + "opened anyway")
| report
