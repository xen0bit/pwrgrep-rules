# rules: named-credentials-constant-match
# languages: apex
# fixture: apex/named-credentials-constant-match.cls
# from: apex/lang/security/ncino/endpoints/NamedCredentialsConstantMatch.yaml

. as $root
| ( ($root | scan_ast(["*.cls"]; [
      "String $X = 'Authorization';\n$$$_\nreq.setHeader($X, $$$_);"
    ])) as $all
    | ( $all | of(["String $X = 'Authorization';\n$$$_\nreq.setHeader($X, $$$_);"])
        | finding("named-credentials-constant-match";
            "Named Credentials (and callout endpoints) should be used instead of hard-coding credentials.") ) )
| report
