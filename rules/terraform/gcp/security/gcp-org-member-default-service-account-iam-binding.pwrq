# rules: gcp-org-member-default-service-account-iam-binding
# languages: hcl
# fixture: terraform/gcp-org-member-default-service-account-iam-binding.tf
#
# The translated rule filtered `of(["resource"])` — bare-keyword matches that bind nothing — by the block and then guarded on a hole the base never bound, so the guard saw no hole and the rule was empty. The finding base is now the block reading itself, and since a list hole binds only its first element, the members list is read whole into $MS with the same guard; the guard is otherwise byte-identical.
# from: terraform/gcp/security/gcp-org-member-default-service-account-iam-binding.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"google_organization_iam_binding\" \"$$$_\" {\n$$$_\nmembers = $MS\n$$$_\n}"
    ])) as $all
    | ( ($all | of(["resource \"google_organization_iam_binding\" \"$$$_\" {\n$$$_\nmembers = $MS\n$$$_\n}"])
        | where_capture("MS"; "^(?:((.*)-compute@developer.gserviceaccount.com))")
        | focus("MS"))
        | finding("gcp-org-member-default-service-account-iam-binding";
            "Ensure default service account is not used at an organization level") ) )
| report
