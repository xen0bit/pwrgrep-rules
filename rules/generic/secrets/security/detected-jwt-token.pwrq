# rules: detected-jwt-token
# fixture: generic/detected-jwt-token.txt
# from: generic/secrets/security/detected-jwt-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "eyJ[A-Za-z0-9-_=]{14,}\\.[A-Za-z0-9-_=]{13,}\\.?[A-Za-z0-9-_.+/=]*?"
    ])) as $all
    | ( $all | of(["eyJ[A-Za-z0-9-_=]{14,}\\.[A-Za-z0-9-_=]{13,}\\.?[A-Za-z0-9-_.+/=]*?"])
        | finding("detected-jwt-token";
        "this is a jwt token written into the source, so it is in every checkout "
        + "and every image built from one; read it from the environment, and "
        + "rotate this one because it has leaked") ) )
| report
