# rules: java-xxe-3
# languages: java
# fixture: java/CWE-611-3.java
# from: CWE-611 XML External Entity via TransformerFactory/SAXParser

["$R.getParameter($$$_)", "$R.getHeader($$$_)", "$R.getQueryString()"] as $outside
| ["$TRANS.transform($XML, $$$_)", "$PARSER.parse($XML, $$$_)"] as $sinks
| scan_ast("*.java"; $outside + $sinks) as $all
| ($all | of($sinks) | focus("XML") | reaching($all | of($outside); []))
| finding("java-xxe-3";
    "XXE: $XML came from the request and reaches XML transform/parse without disabling external entities")
| report
