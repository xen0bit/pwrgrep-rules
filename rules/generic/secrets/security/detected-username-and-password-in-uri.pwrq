# rules: detected-username-and-password-in-uri
# languages:
# fixture: generic/detected-username-and-password-in-uri.txt
# from: generic/secrets/security/detected-username-and-password-in-uri.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?P<PROTOCOL>[A-Za-z0-9+._-]*?(?:http|sql|ftp|smtp)[A-Za-z0-9+._-]*)://(?P<USERNAME>[A-Za-z][A-Za-z0-9_-]{5,31}):(?P<PASSWORD>[^\\s@]{6,32})@(?P<HOST>[^\\s/]+)"
    ])) as $all
    | ( $all | of(["(?P<PROTOCOL>[A-Za-z0-9+._-]*?(?:http|sql|ftp|smtp)[A-Za-z0-9+._-]*)://(?P<USERNAME>[A-Za-z][A-Za-z0-9_-]{5,31}):(?P<PASSWORD>[^\\s@]{6,32})@(?P<HOST>[^\\s/]+)"])
          | where_capture("PROTOCOL"; "(?i)(?:http|sql|ftp|smtp)")
          | where_capture("USERNAME"; "^[A-Za-z][A-Za-z0-9_-]{5,31}$")
          | where_capture("PASSWORD"; ".*[0-9].*")
          | where_capture("PASSWORD"; ".*[a-z].*")
          | where_capture("PASSWORD"; ".*[A-Z].*")
          | where_capture("PASSWORD"; ".*[!\"#$%&'()*+,\\./:;<=>?@\\[\\]^_`{|}~].*")
          | where_capture_not("PASSWORD"; ".*\\s.*")
          | where_capture_not("PASSWORD"; "^\\*+$")
        | finding("detected-username-and-password-in-uri";
        "this is an username and password in uri written into the source, so it is in every checkout "
        + "and every image built from one; read it from the environment, and "
        + "rotate this one because it has leaked") ) )
| report
