# rules: flask-debugging-enabled
# languages: yaml
# fixture: yaml/k8s-flask-debugging-enabled.yaml
# from: yaml/kubernetes/security/env/flask-debugging-enabled.yaml
. as $root
| ( ($root | scan_ast(["*.yaml","*.yml"]; [
      "env: [$$$_]",
      "{name: FLASK_ENV, value: \"development\"}"
    ])) as $all
    | ( $all | of(["{name: FLASK_ENV, value: \"development\"}"])
          | within($all | of(["env: [$$$_]"]))
        | finding("flask-debugging-enabled";
            "Do not set FLASK_ENV to \"development\" since that sets `debug=True` in Flask.") ) )
| report
