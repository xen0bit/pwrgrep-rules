# rules: express-puppeteer-injection
# languages: javascript, typescript
# fixture: javascript/express-puppeteer-injection.js
# from: javascript/express/security/express-puppeteer-injection.yaml
#
# Repair: `function $$$_ (...)` matched only named declarations, route callbacks had to be named, and `at_same_place` needed exact span coincidence; wrappers now cover anon and named shapes, the `puppeteer` gate is file-level, and the sinks are one `$DST` hole each. Globs cover *.js as well as *.ts.

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$APP.$METHOD($$$_, function $FUNC($REQ, $RES) {$$$_})",
      "$APP.$METHOD($$$_, function $FUNC($REQ, $RES, $NEXT) {$$$_})",
      "$APP.$METHOD($$$_, function ($REQ, $RES) {$$$_})",
      "$APP.$METHOD($$$_, function ($REQ, $RES, $NEXT) {$$$_})",
      "$REQ.query",
      "$REQ.body",
      "$REQ.params",
      "$REQ.cookies",
      "$REQ.headers",
      "$PAGE.goto($DST, $$$_)",
      "$PAGE.setContent($DST, $$$_)",
      "$PAGE.evaluate($DST)",
      "$PAGE.evaluate($CODE, $DST, $$$_)",
      "$PAGE.evaluateHandle($DST)",
      "$PAGE.evaluateHandle($CODE, $DST, $$$_)",
      "$PAGE.evaluateOnNewDocument($DST)",
      "$PAGE.evaluateOnNewDocument($CODE, $DST, $$$_)",
      "require('puppeteer');\n$$$_",
      "import 'puppeteer';\n$$$_",
      "({ $REQ }: Request,$RES: Response) => {$$$_}",
      "({ $REQ }: Request,$RES: Response, $NEXT: NextFunction) =>\n{$$$_}",
      "body",
      "cookies",
      "headers",
      "params",
      "query",
      "function ($REQ, $RES) {$$$_}",
      "function $FUNC($REQ, $RES) {$$$_}",
      "function ($REQ, $RES, $NEXT) {$$$_}",
      "function $FUNC($REQ, $RES, $NEXT) {$$$_}"
    ])) as $all
    | ( (($all | of(["$PAGE.goto($DST, $$$_)", "$PAGE.setContent($DST, $$$_)", "$PAGE.evaluate($DST)", "$PAGE.evaluate($CODE, $DST, $$$_)", "$PAGE.evaluateHandle($DST)", "$PAGE.evaluateHandle($CODE, $DST, $$$_)", "$PAGE.evaluateOnNewDocument($DST)", "$PAGE.evaluateOnNewDocument($CODE, $DST, $$$_)"])
          | focus("DST"))
          | in_files_with(($all | of(["require('puppeteer');\n$$$_", "import 'puppeteer';\n$$$_"])))
          )
          | reaching(((($all | of(["$REQ.query", "$REQ.body", "$REQ.params", "$REQ.cookies", "$REQ.headers"]))
          | within((($all | of(["function ($REQ, $RES) {$$$_}", "function $FUNC($REQ, $RES) {$$$_}", "function ($REQ, $RES, $NEXT) {$$$_}", "function $FUNC($REQ, $RES, $NEXT) {$$$_}"])))
          + ((($all | of(["$REQ.query", "$REQ.body", "$REQ.params", "$REQ.cookies", "$REQ.headers"])) | within((($all | of(["$APP.$METHOD($$$_, function $FUNC($REQ, $RES) {$$$_})", "$APP.$METHOD($$$_, function $FUNC($REQ, $RES, $NEXT) {$$$_})"])) + ($all | of(["$APP.$METHOD($$$_, function ($REQ, $RES) {$$$_})", "$APP.$METHOD($$$_, function ($REQ, $RES, $NEXT) {$$$_})"])))) | where_capture("METHOD"; "^(get|post|put|head|delete|options)$")))))
              + (($all
          | within($all | of(["({ $REQ }: Request,$RES: Response, $NEXT: NextFunction) =>\n{$$$_}"])))
          + ($all
          | within($all | of(["({ $REQ }: Request,$RES: Response) => {$$$_}"])))
          | at_same_place(($all | of(["params","query","cookies","headers","body"])))
          | focus("REQ")));
              ([]))
        | finding("express-puppeteer-injection";
            "If unverified user data can reach the `puppeteer` methods it can result in Server-Side Request Forgery vulnerabilities") ) )
| report
