# rules: detected-bcrypt-hash
# fixture: generic/detected-bcrypt-hash.txt
# from: generic/secrets/security/detected-bcrypt-hash.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "\\$2[aby]?\\$[\\d]+\\$[./A-Za-z0-9]{53}"
    ])) as $all
    | ( $all | of(["\\$2[aby]?\\$[\\d]+\\$[./A-Za-z0-9]{53}"])
        | finding("detected-bcrypt-hash";
        "this is a bcrypt hash written into the source, so it is in every checkout "
        + "and every image built from one; read it from the environment, and "
        + "rotate this one because it has leaked") ) )
| report
