# rules: detected-snyk-api-key
# fixture: generic/detected-snyk-api-key.txt
# from: generic/secrets/security/detected-snyk-api-key.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)snyk.{0,50}['|\"|`]?[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}['\"\\s]?"
    ])) as $all
    | ( $all | of(["(?i)snyk.{0,50}['|\"|`]?[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}['\"\\s]?"])
        | finding("detected-snyk-api-key";
            "Snyk API Key detected") ) )
| report
