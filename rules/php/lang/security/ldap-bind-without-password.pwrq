# rules: ldap-bind-without-password
# languages: php
# fixture: php/CWE-287.php
# from: php/lang/security/ldap-bind-without-password.yaml, CWE-287, CWE-521
#
# An LDAP bind with no password, or an empty one, is an anonymous bind, and a
# directory that allows anonymous binds answers it with success. Code that
# reads "did ldap_bind succeed" as "was that the right password" therefore
# authenticates anyone who leaves the password field blank - which is a login
# bypass reachable by pressing return.
#
# Omitting the argument and passing '' are the same thing to the server, so
# both arities are reported, and NULL with them.
#
# The original combined `ldap_bind($$$_)` - a PHP pattern with no named hole,
# read as text and matching nothing - with a `not_at` against the three-
# argument form. Written out by arity there is nothing to subtract.

["ldap_bind($DS)", "ldap_bind($DS, $DN)", "ldap_bind($DS, $DN, $PW)"] as $binds
| scan_ast("*.php"; $binds) as $all
| ( ($all | of(["ldap_bind($DS)", "ldap_bind($DS, $DN)"]))
    + ($all | of(["ldap_bind($DS, $DN, $PW)"])
       | where_capture("PW"; "^(?:''|\"\"|NULL|null|Null)$")) )
| finding("ldap-bind-without-password";
    "this binds with no password, which most directories answer with success; "
    + "a caller reading that as authentication lets anyone in with a blank "
    + "password")
| report
