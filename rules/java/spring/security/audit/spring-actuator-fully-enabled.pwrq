# rules: spring-actuator-fully-enabled
# fixture: java/spring-actuator-fully-enabled.properties
# from: java/spring/security/audit/spring-actuator-fully-enabled.yaml

. as $root
| ( ($root | scan_regex(["*properties"]; [
      "management\\.endpoints\\.web\\.exposure\\.include=\\*"
    ])) as $all
    | ( $all | of(["management\\.endpoints\\.web\\.exposure\\.include=\\*"])
        | finding("spring-actuator-fully-enabled";
            "Spring Boot Actuator is fully enabled.") ) )
| report
