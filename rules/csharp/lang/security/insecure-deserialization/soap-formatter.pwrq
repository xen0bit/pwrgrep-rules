# rules: insecure-soapformatter-deserialization
# languages: c_sharp
#
# The `using` file condition ended in a `\n$$$` gap, which matches nothing -
# `new X();` must also stand as its own statement, since a declaration is not
# an assignment. The fixture writes both accordingly.
# fixture: csharp/soap-formatter.cs
# from: csharp/lang/security/insecure-deserialization/soap-formatter.yaml

. as $root
| ( ($root | scan_ast(["*.cs"]; [
      "new SoapFormatter();",
      "using System.Runtime.Serialization.Formatters.Soap;"
    ])) as $all
    | ( $all | of(["new SoapFormatter();"])
          | in_files_with($all | of(["using System.Runtime.Serialization.Formatters.Soap;"]))
        | finding("insecure-soapformatter-deserialization";
            "The SoapFormatter type is dangerous and is not recommended for data processing.") ) )
| report
