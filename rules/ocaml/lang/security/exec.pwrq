# rules: ocamllint-exec
# languages: ocaml
# fixture: ocaml/CWE-78.ml
# from: ocaml/lang/security/exec.yaml

. as $root
| ( ($root | scan_ast(["*.ml"]; [
      "Sys.command $STR",
      "Unix.execve $STR",
      "Unix.execvp $STR",
      "Unix.execvpe $STR",
      "Unix.system $STR"
    ])) as $all
    | ( $all | of(["Sys.command $STR","Unix.system $STR","Unix.execve $STR","Unix.execvp $STR","Unix.execvpe $STR"])
          | where_capture_not("STR"; "^\".*\"$")
        | finding("ocamllint-exec";
            "Executing external programs might lead to comand or argument injection vulnerabilities.") ) )
| report
