# rules: template-explicit-unescape
# from: javascript/express/security/audit/xss/pug/explicit-unescape.yaml
# fixture: javascript/explicit-unescape-pug.js

. as $root
| ( ($root | scan_regex(["*.pug"]; [
      "!{.*?}",
      "\\w.*(!=)[^=].*"
    ])) as $all
    | ( $all | of(["\\w.*(!=)[^=].*","!{.*?}"])
        | finding("template-explicit-unescape";
            "Detected an explicit unescape in a Pug template, using either '!=' or '!{...}'.") ) )
| report
