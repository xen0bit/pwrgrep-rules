# rules: missing-language-field
# languages: yaml
# fixture: yaml/semgrep-missing-language-field.yaml
#
# Rule-list spans never enclose per-rule matches, so the form never fired.
# Rewritten as a greedy rule block (id line plus following four-space lines,
# which ends at the next rule) with text guards; join-mode rules are out of
# scope.
# from: yaml/semgrep/missing-language-field.yaml

. as $root
| ( ($root | scan_regex(["*.yaml","*.yml"]; [
      "(?m)^  - id:\\s*(?P<RULEID>\\S+)[^\n]*\n((?:    [^\n]*\n?)*)"
    ])) as $all
    | ( $all | of(["(?m)^  - id:\\s*(?P<RULEID>\\S+)[^\n]*\n((?:    [^\n]*\n?)*)"])
          | where_text_not("\n    languages:")
          | where_text_not("mode:\\s*join")
          | focus("RULEID")
        | finding("missing-language-field";
            "Please include a 'languages' field for your rule $RULEID!") ) )
| report
