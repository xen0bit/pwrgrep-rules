# rules: vm2-context-injection
# languages: javascript, typescript
# fixture: javascript/vm2-context-injection.js
# from: javascript/vm2/security/audit/vm2-context-injection.yaml
#
# Repair: the whole-function statement-sequence shapes never matched real code outside their exact spelling. The rule now matches `VM`/`NodeVM` constructions whose sandbox flows from a function argument, with a file-level `vm2` gate.

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "($$$_, $FUNC, $$$_) => {$$$_}",
      "($FUNC) => {$$$_}",
      "new $V({sandbox: $SB})",
      "new $V({sandbox: $SB}, $REST)",
      "$V2 = require('vm2')",
      "const $V2 = require('vm2')",
      "function ($$$_, $FUNC, $$$_) {$$$_}",
      "function $F($$$_, $FUNC, $$$_) {$$$_}"
    ])) as $all
    | ( (($all | of(["new $V({sandbox: $SB})", "new $V({sandbox: $SB}, $REST)"])
          | not_at(($all | of(["new $V({sandbox: $SB})", "new $V({sandbox: $SB}, $REST)"]) | where_capture("SB"; "^[\"'].*[\"']$")))
          | focus("SB"))
          | in_files_with(($all | of(["$V2 = require('vm2')", "const $V2 = require('vm2')"])))
          | reaching(((($all | of(["function ($$$_, $FUNC, $$$_) {$$$_}","function $F($$$_, $FUNC, $$$_) {$$$_}"]))
          + ($all | of(["($FUNC) => {$$$_}","($$$_, $FUNC, $$$_) => {$$$_}"]))
          | focus("FUNC")));
              ([]))
        | finding("vm2-context-injection";
            "Make sure that unverified user data can not reach the `vm2` sandbox.") ) ))
| report
