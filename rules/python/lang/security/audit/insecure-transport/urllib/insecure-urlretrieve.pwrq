# rules: insecure-urlretrieve
# languages: python
# fixture: python/insecure-urlretrieve.py
#
# The translated patterns embedded a Semgrep `=~/.../` regex inside a string literal, where the matcher reads it as literal text, so the rule could never fire. Each literal is now a $P hole guarded by where_capture with the same character class; the finding set is unchanged.
# from: python/lang/security/audit/insecure-transport/urllib/insecure-urlretrieve.yaml

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "urllib.request.urlretrieve($P, $$$_)",
      "$URL = $P\n$$$_\nurllib.request.urlretrieve($URL, $$$_)",
      "def $FUNC($$$_, $URL = $P, $$$_):\n  $$$_BODY",
      "urllib.request.urlretrieve($URL, $$$_)"
    ])) as $all
    | ( ($all | of(["urllib.request.urlretrieve($P, $$$_)","$URL = $P\n$$$_\nurllib.request.urlretrieve($URL, $$$_)"]) | where_capture("P"; "[Hh][Tt][Tt][Pp]://"))
        + ($all | of(["urllib.request.urlretrieve($URL, $$$_)"]) | within($all | of(["def $FUNC($$$_, $URL = $P, $$$_):\n  $$$_BODY"]) | where_capture("P"; "[Hh][Tt][Tt][Pp]://"))) )
    | finding("insecure-urlretrieve";
        "Detected 'urllib.urlretrieve()' using 'http://'.") )
| report
