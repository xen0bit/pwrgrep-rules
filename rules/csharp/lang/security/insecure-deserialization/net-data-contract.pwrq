# rules: insecure-netdatacontract-deserialization
# languages: c_sharp
#
# The `using` file condition ended in a `\n$$$` gap, which matches nothing -
# `new X();` must also stand as its own statement, since a declaration is not
# an assignment. The fixture writes both accordingly.
# fixture: csharp/net-data-contract.cs
# from: csharp/lang/security/insecure-deserialization/net-data-contract.yaml

. as $root
| ( ($root | scan_ast(["*.cs"]; [
      "new NetDataContractSerializer();",
      "using System.Runtime.Serialization;"
    ])) as $all
    | ( $all | of(["new NetDataContractSerializer();"])
          | in_files_with($all | of(["using System.Runtime.Serialization;"]))
        | finding("insecure-netdatacontract-deserialization";
            "The NetDataContractSerializer type is dangerous and is not recommended for data processing.") ) )
| report
