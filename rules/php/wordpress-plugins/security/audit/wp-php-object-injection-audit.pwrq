# rules: wp-php-object-injection-audit
# languages: php
# fixture: php/wp-php-object-injection-audit.php
#
# The original call patterns used anonymous holes, which the PHP grammar
# reads as inline HTML text instead of code, so the rule never fired.
# Rewritten with a hole in function position plus a where_capture allowlist
# of the audited names (the eval-use shape); see GUIDE.md.
# from: php/wordpress-plugins/security/audit/wp-php-object-injection-audit.yaml

["$F($CODE)", "$F($CODE, $$$_)"] as $calls
| scan_ast("*.php"; $calls) as $all
| ($all | of(["$F($CODE)", "$F($CODE, $$$_)"]))
| where_capture("F"; "^(?:maybe_unserialize|unserialize)$")
| finding("wp-php-object-injection-audit";
            "If the data used inside the patterns are directly used without proper sanitization, then this could lead to PHP Object Injection.")
| report
