# rules: detected-coinbase-token
# fixture: generic/detected-coinbase-token.txt
# from: CWE-798 (Use of Hard-coded Credentials)

. as $root
| ( ($root | scan_regex(["*"]; [
      "coinbase_(?P<SECRET>[A-Za-z0-9_\\-]{20,})"
    ])) as $all
    | ( $all | of(["coinbase_(?P<SECRET>[A-Za-z0-9_\\-]{20,})"])
          | where_capture_entropy("SECRET")
        | finding("detected-coinbase-token";
        "this is a coinbase token written into the source, so it is in every checkout "
        + "and every image built from one; read it from the environment, and "
        + "rotate this one because it has leaked") ) )
| report
