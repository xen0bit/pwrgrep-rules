# rules: check-dynamic-render-local-file-include
# fixture: ruby/check-dynamic-render-local-file-include.erb
# from: ruby/rails/security/brakeman/check-dynamic-render-local-file-include.yaml
#
# The render context ended in an open wildcard, so it matched almost nothing
# and no parameter was ever within it. It runs to the rendered value now.

. as $root
| ( ($root | scan_regex(["*.erb"]; [
      "params\\[[\\s\\S]*?\\]",
      "render\\s+:file\\s+=>\\s+\\S+"
    ])) as $all
    | ( $all | of(["params\\[[\\s\\S]*?\\]"])
          | within($all | of(["render\\s+:file\\s+=>\\s+\\S+"]))
        | finding("check-dynamic-render-local-file-include";
            "Found request parameters in a call to `render` in a dynamic context.") ) )
| report
