# rules: private-key
# fixture: generic/private-key.txt
# from: generic/secrets/gitleaks/private-key.yaml
#
# The trailing star was greedy, so one match spanned every key block in the
# file and only the first was reported. It is lazy now (bare, never
# sandwiched between \s+ — RE2 goes long there), so each block reports.

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)-----BEGIN[ A-Z0-9_-]{0,100}PRIVATE KEY( BLOCK)?-----[\\s\\S-]*?KEY( BLOCK)?----"
    ])) as $all
    | ( $all | of(["(?i)-----BEGIN[ A-Z0-9_-]{0,100}PRIVATE KEY( BLOCK)?-----[\\s\\S-]*?KEY( BLOCK)?----"])
        | finding("private-key";
            "A gitleaks private-key was detected which attempts to identify hard-coded credentials.") ) )
| report
