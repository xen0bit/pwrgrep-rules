# rules: http-request
# languages: go
# fixture: problem-based-packs/go-http-request.go
# from: problem-based-packs/insecure-transport/go-stdlib/http-request.yaml

. as $root
| ( ($root | scan_ast(["*.go"]; [
      "$CLIENT := &http.Client{$$$_}\n$$$_",
      "client.$FUNC($URL, $$$_)",
      "http.$FUNC($URL, $$$_)"
    ])) as $all
    | ( ($all | of(["http.$FUNC($URL, $$$_)"]))
          + ($all | of(["client.$FUNC($URL, $$$_)"])
          | in_files_with($all | of(["$CLIENT := &http.Client{$$$_}\n$$$_"])))
          | where_capture("URL"; "http://")
          | where_capture_not("URL"; "127\\.0\\.0\\.1")
          | where_capture_not("URL"; "localhost")
          | where_capture("FUNC"; "^(?:(Get|Post|Head|PostForm))")
        | finding("http-request";
            "Checks for requests sent via http.$FUNC to http:// URLS.") ) )
| report
