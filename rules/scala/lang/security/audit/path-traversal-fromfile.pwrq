# rules: path-traversal-fromfile
# languages: scala
# fixture: scala/path-traversal-fromfile.scala
# from: scala/lang/security/audit/path-traversal-fromfile.yaml

. as $root
| ( ($root | scan_ast(["*.scala"]; [
      "Source.fromFile($F, $$$_)",
      "def $FUNC($$$_, $VAR: $TYPE, $$$_) = Action {\n  $$$_\n}"
    ])) as $all
    | ( $all | of(["Source.fromFile($F, $$$_)"])
          | where_capture("F"; ".*\\+.*")
          | within($all | of(["def $FUNC($$$_, $VAR: $TYPE, $$$_) = Action {\n  $$$_\n}"]))
        | finding("path-traversal-fromfile";
            "Flags cases of possible path traversal.") ) )
| report
