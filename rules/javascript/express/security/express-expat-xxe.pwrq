# rules: express-expat-xxe
# languages: javascript, typescript
# fixture: javascript/express-expat-xxe.js
# from: javascript/express/security/express-expat-xxe.yaml
#
# Repair: `function $$$_ (...)` matched only named declarations, route callbacks had to be named, and `at_same_place` needed exact span coincidence; wrappers now cover anon and named shapes, the `node-expat` gates are file-level, and the sinks are one `$DATA` hole each. Globs cover *.js as well as *.ts.

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$APP.$METHOD($$$_, function $FUNC($REQ, $RES) {$$$_})",
      "$APP.$METHOD($$$_, function $FUNC($REQ, $RES, $NEXT) {$$$_})",
      "$APP.$METHOD($$$_, function ($REQ, $RES) {$$$_})",
      "$APP.$METHOD($$$_, function ($REQ, $RES, $NEXT) {$$$_})",
      "$REQ.query",
      "$REQ.body",
      "$REQ.params",
      "$REQ.cookies",
      "$REQ.headers",
      "$PARSER.parse($DATA)",
      "$PARSER.write($DATA)",
      "$PARSER = new $XML.Parser($$$_);\n$$$_",
      "const $PARSER = new $XML.Parser($$$_)",
      "$XML = require('$IMPORT')\n$$$_",
      "const $XML = require('$IMPORT')",
      "let $XML = require('$IMPORT')",
      "var $XML = require('$IMPORT')",
      "import $XML from '$IMPORT'\n$$$_",
      "import * as $XML from '$IMPORT'\n$$$_",
      "({ $REQ }: Request,$RES: Response) => {$$$_}",
      "({ $REQ }: Request,$RES: Response, $NEXT: NextFunction) =>\n{$$$_}",
      "body",
      "cookies",
      "headers",
      "params",
      "query",
      "function ($REQ, $RES) {$$$_}",
      "function $FUNC($REQ, $RES) {$$$_}",
      "function ($REQ, $RES, $NEXT) {$$$_}",
      "function $FUNC($REQ, $RES, $NEXT) {$$$_}"
    ])) as $all
    | ( (($all | of(["$PARSER.parse($DATA)", "$PARSER.write($DATA)"])
          | focus("DATA"))
          | in_files_with(($all | of(["$PARSER = new $XML.Parser($$$_);\n$$$_", "const $PARSER = new $XML.Parser($$$_)", "$XML = require('$IMPORT')\n$$$_", "const $XML = require('$IMPORT')"])) + ($all | of(["let $XML = require('$IMPORT')", "var $XML = require('$IMPORT')", "import $XML from '$IMPORT'\n$$$_", "import * as $XML from '$IMPORT'\n$$$_"])))
          )
          | reaching(((($all | of(["$REQ.query", "$REQ.body", "$REQ.params", "$REQ.cookies", "$REQ.headers"]))
          | within((($all | of(["function ($REQ, $RES) {$$$_}", "function $FUNC($REQ, $RES) {$$$_}", "function ($REQ, $RES, $NEXT) {$$$_}", "function $FUNC($REQ, $RES, $NEXT) {$$$_}"])))
          + ((($all | of(["$REQ.query", "$REQ.body", "$REQ.params", "$REQ.cookies", "$REQ.headers"])) | within((($all | of(["$APP.$METHOD($$$_, function $FUNC($REQ, $RES) {$$$_})", "$APP.$METHOD($$$_, function $FUNC($REQ, $RES, $NEXT) {$$$_})"])) + ($all | of(["$APP.$METHOD($$$_, function ($REQ, $RES) {$$$_})", "$APP.$METHOD($$$_, function ($REQ, $RES, $NEXT) {$$$_})"])))) | where_capture("METHOD"; "^(get|post|put|head|delete|options)$")))))
              + (($all
          | within($all | of(["({ $REQ }: Request,$RES: Response, $NEXT: NextFunction) =>\n{$$$_}"])))
          + ($all
          | within($all | of(["({ $REQ }: Request,$RES: Response) => {$$$_}"])))
          | at_same_place(($all | of(["params","query","cookies","headers","body"])))
          | focus("REQ")));
              ([]))
        | finding("express-expat-xxe";
            "Make sure that unverified user data can not reach the XML Parser, as it can result in XML External or Internal Entity (XXE) Processing vulnerabilities.") ) )
| report
