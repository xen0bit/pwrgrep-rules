# rules: jquery-insecure-method
# languages: javascript, typescript
# fixture: javascript/jquery-insecure-method.js
# from: javascript/jquery/security/audit/jquery-insecure-method.yaml
#
# Repair: dead as written. The literal-argument exclusions read their holes
# as any value and subtracted every call. The exclusions now keep only
# fully-quoted text via the argument hole.

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$(\"$$$_\",$$$_).$METHOD($$$_)",
      "$($$$_).$METHOD($VAR,$$$_)",
      "$($$$_).$METHOD($VAR,$$$_)",
      "$.$METHOD($VAR,$$$_)",
      "$.$METHOD($VAR,$$$_)",
      "jQuery(\"$$$_\",$$$_).$METHOD($$$_)",
      "jQuery($$$_).$METHOD($VAR,$$$_)",
      "jQuery($$$_).$METHOD($VAR,$$$_)",
      "jQuery.$METHOD($VAR,$$$_)",
      "jQuery.$METHOD($VAR,$$$_)"
    ])) as $all
    | ( ($all | of(["$.$METHOD($VAR,$$$_)","$($$$_).$METHOD($VAR,$$$_)","jQuery.$METHOD($VAR,$$$_)","jQuery($$$_).$METHOD($VAR,$$$_)"])
          | not_at(($all | of(["$.$METHOD($VAR,$$$_)"]) | where_capture("VAR"; "^[\"'].*[\"']$")))
          | not_at(($all | of(["$($$$_).$METHOD($VAR,$$$_)"]) | where_capture("VAR"; "^[\"'].*[\"']$")))
          | not_at(($all | of(["jQuery.$METHOD($VAR,$$$_)"]) | where_capture("VAR"; "^[\"'].*[\"']$")))
          | not_at(($all | of(["jQuery($$$_).$METHOD($VAR,$$$_)"]) | where_capture("VAR"; "^[\"'].*[\"']$")))
          | where_capture("METHOD"; "^(html|append|prepend|wrap|wrapInner|wrapAll|before|after|globalEval|getScript)$"))
          + ($all | of(["$($$$_).$METHOD($VAR,$$$_)","jQuery($$$_).$METHOD($VAR,$$$_)"])
          | not_at(($all | of(["$($$$_).$METHOD($VAR,$$$_)","jQuery($$$_).$METHOD($VAR,$$$_)"]) | where_capture("VAR"; "^[\"'].*[\"']$")))
          | where_capture("METHOD"; "^(appendTo|insertAfter|insertBefore|prependTo)$"))
        | finding("jquery-insecure-method";
            "User controlled data in a jQuery's `.$METHOD(...)` is an anti-pattern that can lead to XSS vulnerabilities") ) )
| report
