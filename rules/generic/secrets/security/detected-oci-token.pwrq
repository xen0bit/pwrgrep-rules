# rules: detected-oci-token
# languages:
# fixture: generic/detected-oci-token.txt
# from: CWE-798 (Use of Hard-coded Credentials)
#
# OCI token hardcoded.

. as $root
| ( ($root | scan_regex(["*"]; [
      "ocid1\\.(?P<SECRET>[A-Za-z0-9_\\-]{20,})"
    ])) as $all
    | ( $all | of(["ocid1\\.(?P<SECRET>[A-Za-z0-9_\\-]{20,})"])
          | where_capture_entropy("SECRET")
        | finding("detected-oci-token";
        "this is an oci token written into the source, so it is in every checkout "
        + "and every image built from one; read it from the environment, and "
        + "rotate this one because it has leaked") ) )
| report
