# rules: gcp-org-member-default-service-account-iam-member
# languages: hcl
# fixture: terraform/gcp-org-member-default-service-account-iam-member.tf
#
# The translated rule filtered `of(["resource"])` — bare-keyword matches that bind nothing — by the block and then guarded on $MEMBER, a hole bound only in the block reading, so the guard saw no hole and the rule was empty. The finding base is now the block reading itself; the guard is byte-identical.
# from: terraform/gcp/security/gcp-org-member-default-service-account-iam-member.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"google_organization_iam_member\" \"$$$_\" {\n$$$_\nmember = $MEMBER\n$$$_\n}"
    ])) as $all
    | ( ($all | of(["resource \"google_organization_iam_member\" \"$$$_\" {\n$$$_\nmember = $MEMBER\n$$$_\n}"])
        | where_capture("MEMBER"; "^(?:((.*)-compute@developer.gserviceaccount.com))")
        | focus("MEMBER"))
        | finding("gcp-org-member-default-service-account-iam-member";
            "Ensure default service account is not used at an organization level") ) )
| report
