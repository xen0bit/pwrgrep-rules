# rules: open-directory-listing
# languages: c_sharp
# fixture: csharp/open-directory-listing.cs
# fixture: csharp/open-directory-listing.cs
#
# The sink read the builder through a cast, which no call site has. It reads
# a plain receiver now, and the Configure linchpin is a whole body (a body
# written `$$$` is a statement literally named `$$$`).
# from: csharp/dotnet/security/audit/open-directory-listing.yaml

. as $root
| ( ($root | scan_ast(["*.cs"]; [
      "$BUILDER.Services.AddDirectoryBrowser($$$_);",
      "$APP.UseDirectoryBrowser($$$_);",
      "public void Configure($$$_) {\n  $$$BODY\n}"
    ])) as $all
    | ( $all | of(["$APP.UseDirectoryBrowser($$$_);","$BUILDER.Services.AddDirectoryBrowser($$$_);"])
          | within($all | of(["public void Configure($$$_) {\n  $$$BODY\n}"]))
        | finding("open-directory-listing";
            "An open directory listing is potentially exposed, potentially revealing sensitive information to attackers.") ) )
| report
