# rules: missing-hsts-header
# languages: c_sharp
# fixture: csharp/missing-hsts-header.cs
# from: csharp/lang/security/missing-hsts-header.yaml
#
# The translated Configure shapes put `$$$` gaps around a cast call, which
# match nothing: a gap is not an ellipsis, and `(IApplicationBuilder $APP)`
# as a statement is a cast, not the parameter. The parameter is bound in the
# signature and the body in a named hole instead, and the HSTS call is asked
# of the body textually - the finding is the Configure missing it.

. as $root
| ( ($root | scan_ast(["*.cs"]; [
      "public void Configure(IApplicationBuilder $APP) { $BODY }",
      "public void ConfigureServices(IServiceCollection $SERVICES) { $BODY }"
    ])) as $all
    | ( ($all | of(["public void Configure(IApplicationBuilder $APP) { $BODY }"])
          | where_capture_not("BODY"; "UseHsts")
          | focus("APP"))
          + ($all | of(["public void ConfigureServices(IServiceCollection $SERVICES) { $BODY }"])
          | where_capture_not("BODY"; "AddHsts")
          | focus("SERVICES"))
        | finding("missing-hsts-header";
            "The HSTS HTTP response security header is missing, allowing interaction and communication to be sent over the insecure HTTP protocol.") ) )
| report
