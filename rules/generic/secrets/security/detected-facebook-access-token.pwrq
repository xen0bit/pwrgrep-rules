# rules: detected-facebook-access-token
# fixture: generic/detected-facebook-access-token.txt
# from: generic/secrets/security/detected-facebook-access-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "EAAAACZAVC6ygB[0-9A-Za-z]+",
      "EAAAAZAw4[0-9A-Za-z]+",
      "EAACEdEose0cBA[0-9A-Za-z]+"
    ])) as $all
    | ( $all | of(["EAACEdEose0cBA[0-9A-Za-z]+","EAAAACZAVC6ygB[0-9A-Za-z]+","EAAAAZAw4[0-9A-Za-z]+"])
        | finding("detected-facebook-access-token";
        "this is a facebook access token written into the source, so it is in every checkout "
        + "and every image built from one; read it from the environment, and "
        + "rotate this one because it has leaked") ) )
| report
