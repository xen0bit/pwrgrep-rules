# rules: run-as-non-root-unsafe-value
# languages: yaml
# fixture: yaml/k8s-runasnonroot.yaml
# from: yaml/kubernetes/security/run-as-non-root-unsafe-value.yaml

. as $root
| ( ($root | scan_ast(["*.yaml","*.yml"]; [
      "runAsNonRoot: false"
    ])) as $all
    | ( $all | of(["runAsNonRoot: false"])
        | finding("run-as-non-root-unsafe-value";
            "When running containers in Kubernetes, it's important to ensure that they are properly secured to prevent privilege escalation attacks.") ) )
| report
