# rules: open-redirect
# languages: c_sharp
# fixture: csharp/open-redirect.cs
#
# The reaching half is coarse: any Redirect outside an IsLocalUrl guard fires
# when its method takes a string, whether the value flows there or not - a
# constant Redirect in `Home(string unused)` reports too. The fixture keeps
# strings out of its safe methods, and safe input arrives via Request instead
# of a parameter.
# from: csharp/lang/security/open-redirect.yaml

. as $root
| ( ($root | scan_ast(["*.cs"]; [
      "Redirect($$$_)",
      "if ($URL.IsLocalUrl($$$_)) { $$$BODY }",
      "if (IsLocalUrl($$$_)) { $$$BODY }",
      "public $TYPE $FUNCNAME ($$$_, string $PARAM, $$$_) {\n  $$$_\n}"
    ])) as $all
    | ( (($all | of(["Redirect($$$_)"])
          | outside($all | of(["if (IsLocalUrl($$$_)) { $$$BODY }"]))
          | outside($all | of(["if ($URL.IsLocalUrl($$$_)) { $$$BODY }"]))))
          | reaching((($all
          | focus("PARAM")
          | within($all | of(["public $TYPE $FUNCNAME ($$$_, string $PARAM, $$$_) {\n  $$$_\n}"]))));
              ([]))
        | finding("open-redirect";
            "A query string parameter may contain a URL value that could cause the web application to redirect the request to a malicious website controlled by an attacker.") ) )
| report
