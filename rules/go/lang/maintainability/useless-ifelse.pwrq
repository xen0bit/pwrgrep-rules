# rules: useless-if-conditional, useless-if-body
# languages: go
# fixture: go/useless-if-conditional.go
# from: go/lang/maintainability/useless-ifelse.yaml
#
# Both patterns were written C-style: `if ($X)` never matches Go's
# unparenthesised condition, and the anonymous `{ $$$_ }` bodies match
# nothing. The conditions are unparenthesised and the bodies named.
# The fixture covers the first id only; the `else` bodies there differ, so
# the second id stays quiet.

. as $root
| ( ($root | scan_ast(["*.go"]; [
      "if $X { $$$A } else if $X { $$$B }",
      "if $X { $S } else { $S }"
    ])) as $all
    | ( $all | of(["if $X { $$$A } else if $X { $$$B }"])
        | finding("useless-if-conditional";
            "Detected an if block that checks for the same condition on both branches (`$X`).") )
      + ( $all | of(["if $X { $S } else { $S }"])
        | finding("useless-if-body";
            "Detected identical statements in the if body and the else body of an if-statement.") ) )
| report
