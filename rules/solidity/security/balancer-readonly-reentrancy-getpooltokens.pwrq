# rules: balancer-readonly-reentrancy-getpooltokens
# languages: solidity
# fixture: solidity/balancer-readonly-reentrancy-getpooltokens.sol
#
# The ported finding filtered a regex capture through where_capture_ast with
# a regex-shaped snippet, which never matches, and the contract-name and
# same-span exclusions never coincide, so nothing ever fired. Rewritten as a
# regex over flat functions assigning a getPoolTokens result, with the vault
# guards as where_text_not on the whole span. Only flat function bodies are
# covered; Balancer-repo contract-name exclusions are out of scope.
# from: solidity/security/balancer-readonly-reentrancy-getpooltokens.yaml

. as $root
| ( ($root | scan_regex(["*.sol"]; [
      "function\\s+(?P<F>\\w+)\\s*\\([\\s\\S]*?\\)\\s*[^{]*\\{(?:[^{}]|\\{[^{}]*\\})*?(?P<VAULT>\\w+)\\.getPoolTokens\\s*\\((?:[^{}]|\\{[^{}]*\\})*?\\}"
    ])) as $all
    | ( $all | of(["function\\s+(?P<F>\\w+)\\s*\\([\\s\\S]*?\\)\\s*[^{]*\\{(?:[^{}]|\\{[^{}]*\\})*?(?P<VAULT>\\w+)\\.getPoolTokens\\s*\\((?:[^{}]|\\{[^{}]*\\})*?\\}"])
          | where_text_not("ensureNotInVaultContext")
          | where_text_not("manageUserBalance")
        | finding("balancer-readonly-reentrancy-getpooltokens";
            "$VAULT.getPoolTokens() call on a Balancer pool is not protected from the read-only reentrancy.") ) )
| report
