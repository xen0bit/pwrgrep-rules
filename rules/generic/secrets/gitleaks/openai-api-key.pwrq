# rules: openai-api-key
# fixture: generic/openai-api-key.txt
# from: generic/secrets/gitleaks/openai-api-key.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)\\b(sk-[a-zA-Z0-9]{20}T3BlbkFJ[a-zA-Z0-9]{20})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"
    ])) as $all
    | ( $all | of(["(?i)\\b(sk-[a-zA-Z0-9]{20}T3BlbkFJ[a-zA-Z0-9]{20})(?:['|\\\"|\\n|\\r|\\s|\\x60|;]|$)"])
        | finding("openai-api-key";
            "A gitleaks openai-api-key was detected which attempts to identify hard-coded credentials.") ) )
| report
