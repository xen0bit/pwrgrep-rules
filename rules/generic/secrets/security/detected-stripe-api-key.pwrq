# rules: detected-stripe-api-key
# fixture: generic/detected-stripe-api-key.txt
# from: generic/secrets/security/detected-stripe-api-key.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "sk_live_[0-9a-zA-Z]{24}"
    ])) as $all
    | ( $all | of(["sk_live_[0-9a-zA-Z]{24}"])
        | finding("detected-stripe-api-key";
        "this is a stripe api key written into the source, so it is in every checkout "
        + "and every image built from one; read it from the environment, and "
        + "rotate this one because it has leaked") ) )
| report
