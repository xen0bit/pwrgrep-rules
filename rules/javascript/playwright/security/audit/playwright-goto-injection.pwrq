# rules: playwright-goto-injection
# languages: javascript, typescript
# fixture: javascript/playwright-goto-injection.js
# from: javascript/playwright/security/audit/playwright-goto-injection.yaml
#
# The require gate trailed a statement gap that matches nothing, and the
# literal exclusion read a two-slot shape that subtracted every call. The
# gate is bare now and the finding keeps only non-literal targets.

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$PAGE.goto($INPUT,$$$_)",
      "require('playwright')",
      "require('playwright')\nvar $INPUT = \"$$$_\";\n$$$_\n$PAGE.goto($INPUT,$$$_)"
    ])) as $all
    | ( $all | of(["$PAGE.goto($INPUT,$$$_)"])
          | in_files_with($all | of(["require('playwright')"]))
          | outside($all | of(["require('playwright')\nvar $INPUT = \"$$$_\";\n$$$_\n$PAGE.goto($INPUT,$$$_)"]))
          | where_capture_not("INPUT"; "^[\"']")
        | finding("playwright-goto-injection";
            "If unverified user data can reach the `goto` method it can result in Server-Side Request Forgery vulnerabilities") ) )
| report
