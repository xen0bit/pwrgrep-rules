# rules: kotlin-os-command
# languages: kotlin
# fixture: kotlin/CWE-78b.kt
# from: CWE-78 OS Command Injection

["Runtime.getRuntime().exec($CMD)", "ProcessBuilder($CMD, $$$_)"] as $sinks
| scan_ast("*.kt"; $sinks) as $all
| ($all | of($sinks) | where_capture_not("CMD"; "^\"") | finding("kotlin-os-command";
        "this hands a value the caller chose to a shell, so a `;` or a backtick "
        + "in it starts a second command; pass the program and its arguments "
        + "separately instead"))
| report
