# rules: no-slippage-check
# languages: solidity
# fixture: solidity/no-slippage-check.sol
#
# Call fragments never match in the solidity grammar, so no form fired.
# Rewritten as a regex per swap shape with the limit in a named hole; the
# original zero-or-max guard is kept. Struct params use a single-line shape.
# from: solidity/security/no-slippage-check.yaml

. as $root
| ( ($root | scan_regex(["*.sol"]; [
      "swapExactTokensForTokens\\s*\\(\\s*[^,()]+,\\s*(?P<LIMIT>[^,()]+)",
      "swapExactTokensForETH\\s*\\(\\s*[^,()]+,\\s*(?P<LIMIT>[^,()]+)",
      "swapTokensForExactTokens\\s*\\(\\s*[^,()]+,\\s*(?P<LIMIT>[^,()]+)",
      "swapTokensForExactETH\\s*\\(\\s*[^,()]+,\\s*(?P<LIMIT>[^,()]+)",
      "amountOutMinimum\\s*:\\s*(?P<LIMIT>[^,\\s]+)",
      "amountInMaximum\\s*:\\s*(?P<LIMIT>[^,\\s]+)"
    ])) as $all
    | ( (($all | of(["swapExactTokensForTokens\\s*\\(\\s*[^,()]+,\\s*(?P<LIMIT>[^,()]+)"]) | where_capture("LIMIT"; "^(0)|(0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff)|(type\\(uint(256)?\\)\\.max)|(uint(256)?\\(-1)|(115792089237316195423570985008687907853269984665640564039457584007913129639935)|(2\\s?\\*\\*\\s?-\\s?1)$"))
          + ($all | of(["swapExactTokensForETH\\s*\\(\\s*[^,()]+,\\s*(?P<LIMIT>[^,()]+)"]) | where_capture("LIMIT"; "^(0)|(0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff)|(type\\(uint(256)?\\)\\.max)|(uint(256)?\\(-1)|(115792089237316195423570985008687907853269984665640564039457584007913129639935)|(2\\s?\\*\\*\\s?-\\s?1)$"))
          + ($all | of(["swapTokensForExactTokens\\s*\\(\\s*[^,()]+,\\s*(?P<LIMIT>[^,()]+)"]) | where_capture("LIMIT"; "^(0)|(0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff)|(type\\(uint(256)?\\)\\.max)|(uint(256)?\\(-1)|(115792089237316195423570985008687907853269984665640564039457584007913129639935)|(2\\s?\\*\\*\\s?-\\s?1)$"))
          + ($all | of(["swapTokensForExactETH\\s*\\(\\s*[^,()]+,\\s*(?P<LIMIT>[^,()]+)"]) | where_capture("LIMIT"; "^(0)|(0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff)|(type\\(uint(256)?\\)\\.max)|(uint(256)?\\(-1)|(115792089237316195423570985008687907853269984665640564039457584007913129639935)|(2\\s?\\*\\*\\s?-\\s?1)$"))
          + ($all | of(["amountOutMinimum\\s*:\\s*(?P<LIMIT>[^,\\s]+)"]) | where_capture("LIMIT"; "^(0)|(0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff)|(type\\(uint(256)?\\)\\.max)|(uint(256)?\\(-1)|(115792089237316195423570985008687907853269984665640564039457584007913129639935)|(2\\s?\\*\\*\\s?-\\s?1)$"))
          + ($all | of(["amountInMaximum\\s*:\\s*(?P<LIMIT>[^,\\s]+)"]) | where_capture("LIMIT"; "^(0)|(0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff)|(type\\(uint(256)?\\)\\.max)|(uint(256)?\\(-1)|(115792089237316195423570985008687907853269984665640564039457584007913129639935)|(2\\s?\\*\\*\\s?-\\s?1)$"))
        | finding("no-slippage-check";
            "No slippage check in a Uniswap v2/v3 trade") ) ) )
| report
