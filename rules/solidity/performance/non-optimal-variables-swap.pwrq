# rules: non-optimal-variables-swap
# languages: solidity
# fixture: solidity/non-optimal-variables-swap.sol
#
# Statement gaps never match in the solidity grammar, so the three-line
# shape never fired. Rewritten as exact function bodies (the only multi-line
# form that matches); bodies must hold just the swap, with or without the
# return. Type holes do not match declarations here, so the scratch type is
# uint256, the common case.
# from: solidity/performance/non-optimal-variables-swap.yaml

. as $root
| ( ($root | scan_ast(["*.sol"]; [
      "function $F($$$_) {\n uint256 $TMP = $A;\n $A = $B;\n $B = $TMP;\n return ($A, $B);\n}",
      "function $F($$$_) {\n uint256 $TMP = $A;\n $A = $B;\n $B = $TMP;\n}"
    ])) as $all
    | ( $all | of(["function $F($$$_) {\n uint256 $TMP = $A;\n $A = $B;\n $B = $TMP;\n return ($A, $B);\n}","function $F($$$_) {\n uint256 $TMP = $A;\n $A = $B;\n $B = $TMP;\n}"])
        | finding("non-optimal-variables-swap";
            "Consider swapping variables using `($VAR1, $VAR2) = ($VAR2, $VAR1)` to save gas") ) )
| report
