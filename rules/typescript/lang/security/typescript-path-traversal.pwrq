| ["fs.readFile($PATH, $$$_)", "fs.readFileSync($PATH)", "fs.createReadStream($PATH)", "fs.promises.readFile($PATH)"] as $sink
| scan_ast(["*.ts","*.tsx"]; $src + $sink) as $all
| ( $all | of($sink) | focus("PATH") | reaching($all | of($src); []) | finding("typescript-path-traversal";
