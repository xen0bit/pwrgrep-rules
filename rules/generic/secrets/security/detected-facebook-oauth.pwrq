# rules: detected-facebook-oauth
# fixture: generic/detected-facebook-oauth.txt
# from: generic/secrets/security/detected-facebook-oauth.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "[fF][aA][cC][eE][bB][oO][oO][kK].*[tT][oO][kK][eE][nN].*['|\"]?[0-9a-f]{32}['|\"]?"
    ])) as $all
    | ( $all | of(["[fF][aA][cC][eE][bB][oO][oO][kK].*[tT][oO][kK][eE][nN].*['|\"]?[0-9a-f]{32}['|\"]?"])
        | finding("detected-facebook-oauth";
        "this is a facebook oauth written into the source, so it is in every checkout "
        + "and every image built from one; read it from the environment, and "
        + "rotate this one because it has leaked") ) )
| report
