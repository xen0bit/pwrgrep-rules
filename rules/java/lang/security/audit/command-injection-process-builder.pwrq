# rules: command-injection-process-builder
# languages: java
# fixture: java/command-injection-process-builder.java
#
# Two silent failures compounded: every shell name arrived as a Semgrep
# `=~/.../` regex baked into a string literal, where the matcher reads
# it as literal text; and every "is a literal" subtraction was written
# as `"$$$_"`, which in Java matches any single argument rather than a
# string, so the subtractions cancelled the firing legs as well as each
# other. Shell names are now $SHELL holes kept by guard, and literals
# are tested by guard on a named hole — which also collapses the
# dozens of per-arity literal spellings the translation needed. A
# command held in a variable fires regardless of what initialized it;
# that file-level join has no operator here. Arrays.asList wrappers are
# not covered.
# from: java/lang/security/audit/command-injection-process-builder.yaml

. as $root
| ( ($root | scan_ast(["*.java"]; [
      "$TYPE $PB = new ProcessBuilder($$$_);",
      "new ProcessBuilder($CMD, $$$_)",
      "$PB.command($CMD, $$$_)",
      "new ProcessBuilder($SHELL, \"-c\", $ARG, $$$_)",
      "new ProcessBuilder(\"cmd\", \"/c\", $ARG, $$$_)",
      "new ProcessBuilder(new String[]{$SHELL, \"-c\", $ARG, $$$_}, $$$_)",
      "new ProcessBuilder(new String[]{\"cmd\", \"/c\", $ARG, $$$_}, $$$_)",
      "$PB.command($SHELL, \"-c\", $ARG, $$$_)",
      "$PB.command(\"cmd\", \"/c\", $ARG, $$$_)"
    ])) as $all
    | ( (($all | of(["new ProcessBuilder($CMD, $$$_)"]) | where_capture_not("CMD"; "^\""))
        + ($all | of(["$PB.command($CMD, $$$_)"]) | within($all | of(["$TYPE $PB = new ProcessBuilder($$$_);"])) | where_capture_not("CMD"; "^\""))
        + ($all | of(["new ProcessBuilder($SHELL, \"-c\", $ARG, $$$_)", "new ProcessBuilder(new String[]{$SHELL, \"-c\", $ARG, $$$_}, $$$_)"]) | where_capture("SHELL"; "(sh|bash|ksh|csh|tcsh|zsh)") | where_capture_not("ARG"; "^\""))
        + ($all | of(["new ProcessBuilder(\"cmd\", \"/c\", $ARG, $$$_)", "new ProcessBuilder(new String[]{\"cmd\", \"/c\", $ARG, $$$_}, $$$_)"]) | where_capture_not("ARG"; "^\""))
        + ($all | of(["$PB.command($SHELL, \"-c\", $ARG, $$$_)"]) | within($all | of(["$TYPE $PB = new ProcessBuilder($$$_);"])) | where_capture("SHELL"; "(sh|bash|ksh|csh|tcsh|zsh)") | where_capture_not("ARG"; "^\""))
        + ($all | of(["$PB.command(\"cmd\", \"/c\", $ARG, $$$_)"]) | within($all | of(["$TYPE $PB = new ProcessBuilder($$$_);"])) | where_capture_not("ARG"; "^\""))) )
    | finding("command-injection-process-builder";
        "A formatted or concatenated string was detected as input to a ProcessBuilder call.") )
| report
