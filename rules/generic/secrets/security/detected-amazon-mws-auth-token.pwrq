# rules: detected-amazon-mws-auth-token
# fixture: generic/detected-amazon-mws-auth-token.txt
# from: generic/secrets/security/detected-amazon-mws-auth-token.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "amzn\\.mws\\.[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
    ])) as $all
    | ( $all | of(["amzn\\.mws\\.[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"])
        | finding("detected-amazon-mws-auth-token";
        "this is an amazon mws auth token written into the source, so it is in every checkout "
        + "and every image built from one; read it from the environment, and "
        + "rotate this one because it has leaked") ) )
| report
