# rules: allow-privilege-escalation-no-securitycontext
# languages: yaml
# fixture: yaml/k8s-no-securitycontext.yaml
#
# The scaffolding spans never enclose, so the rule never fired. Rewritten as
# a container-block match with guards for an image and no securityContext.
# Container spans use an indent-anchored block (dash plus deeper fields);
# fixture containers keep the standard four/six-space layout.
# from: yaml/kubernetes/security/allow-privilege-escalation-no-securitycontext.yaml

. as $root
| ( ($root | scan_regex(["*.yaml","*.yml"]; [
      "(?m)^    -\\s+name:\\s*(?P<C>\\S+)[^\n]*((?:\n      [^\n]*)*)"
    ])) as $all
    | ( $all | of(["(?m)^    -\\s+name:\\s*(?P<C>\\S+)[^\n]*((?:\n      [^\n]*)*)"])
          | where_text("image:")
          | where_text_not("securityContext:")
          | focus("C")
        | finding("allow-privilege-escalation-no-securitycontext";
            "In Kubernetes, each pod runs in its own isolated environment with its own set of security policies.") ) )
| report
