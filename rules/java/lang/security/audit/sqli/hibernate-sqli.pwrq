# rules: hibernate-sqli
# languages: java
# fixture: java/hibernate-sqli.java
# from: java/lang/security/audit/sqli/hibernate-sqli.yaml

["$R.getParameter($$$_)", "$R.getHeader($$$_)", "$R.getQueryString()", "$R.getCookies()", "$R.getParameterValues($$$_)"] as $src
| ["$SESSION.createQuery($Q)", "$SESSION.createSQLQuery($Q)", "org.hibernate.criterion.Restrictions.sqlRestriction($Q,$$$_)"] as $sinks
| scan_ast("*.java"; $src + $sinks) as $all
| ($all | of($sinks) | focus("Q") | reaching($all | of($src); []) | finding("hibernate-sqli"; "Detected a formatted string in a SQL statement."))
| report
