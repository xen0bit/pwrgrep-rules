# rules: duplicate-id
# languages: yaml
# fixture: yaml/semgrep-duplicate-id.yaml
#
# Duplicate detection needs value equality across two matches, which the
# ported in_files_with scaffolding never established. Rewritten as one regex
# over an id pair with where_same on the captures (semicolon form).
# from: yaml/semgrep/duplicate-id.yaml

. as $root
| ( ($root | scan_regex(["*.yaml","*.yml"]; [
      "-\\s+id:\\s+(?P<A>\\S+)[\\s\\S]*?-\\s+id:\\s+(?P<B>\\S+)"
    ])) as $all
    | ( $all | of(["-\\s+id:\\s+(?P<A>\\S+)[\\s\\S]*?-\\s+id:\\s+(?P<B>\\S+)"])
          | where_same("A"; "B")
          | focus("A")
        | finding("duplicate-id";
            "The 'id' field $A was used multiple times.") ) )
| report
