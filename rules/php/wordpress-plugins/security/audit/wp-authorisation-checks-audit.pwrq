# rules: wp-authorisation-checks-audit
# languages: php
# fixture: php/wp-authorisation-checks-audit.php
#
# Anonymous holes in call patterns are read as inline HTML text instead
# of code, so the rule never fired. Rewritten with named holes (the eval-use
# shape); see GUIDE.md.
# Zero-argument checks like is_admin() need their own arity alongside the
# general one.
# from: php/wordpress-plugins/security/audit/wp-authorisation-checks-audit.yaml

. as $root
| ( ($root | scan_ast(["*.php"]; [
      "$FUNCTION()",
      "$FUNCTION($ARG,$$$_)"
    ])) as $all
    | ( $all | of(["$FUNCTION()", "$FUNCTION($ARG,$$$_)"])
          | where_capture("FUNCTION"; "^(?:current_user_can|is_admin|is_user_logged_in|is_user_admin)")
        | finding("wp-authorisation-checks-audit";
            "These are some of the patterns used for authorisation.") ) )
| report
