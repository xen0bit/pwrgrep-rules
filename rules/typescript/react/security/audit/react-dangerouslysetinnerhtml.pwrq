# rules: react-dangerouslysetinnerhtml
# languages: javascript
# fixture: typescript/react-dangerouslysetinnerhtml.tsx
# from: typescript/react/security/audit/react-dangerouslysetinnerhtml.yaml
#
# An ellipsis between JSX attributes compiles to an attribute literally named
# `$$$`, which no program contains, so the JSX sinks were dead while the
# object-literal sink worked. The attributes are named without gaps now (as
# in typescript-xss).

. as $root
| ( ($root | scan_ast(["*.js"]; [
      "$F. $$$_ .$SANITIZEUNC($$$_)",
      "$PWRQDEEP1",
      "$S = new Remarkable()\n$$$_",
      "$S = require(\"dompurify\")\n$$$_",
      "$S = require(\"isomorphic-dompurify\")\n$$$_",
      "$S = require(\"sanitize-html\")\n$$$_",
      "$S = require(\"underscore.string\")\n$$$_",
      "$S = require(\"xss\")\n$$$_",
      "$S($$$_)",
      "$S.escapeHTML($$$_)",
      "$S.render($$$_)",
      "$S.sanitize($$$_)",
      "$VALUE = $S($$$_)\n$$$_",
      "$VALUE = $S.sanitize\n$$$_",
      "$VALUE.sanitize($$$_)",
      "<$Y dangerouslySetInnerHTML={{__html: \"$$$_\"}} />",
      "<$Y dangerouslySetInnerHTML={{__html: $X}} />",
      "function $$$_($$$_, $X, $$$_) { $$$_ }",
      "function $$$_({$$$_, $X, $$$_}) { $$$_ }",
      "import $S from \"dompurify\"\n$$$_",
      "import $S from \"isomorphic-dompurify\"\n$$$_",
      "import $S from \"underscore.string\"\n$$$_",
      "import $S from 'sanitize-html';\n$$$_",
      "import $S from 'xss';\n$$$_",
      "import * as $S from \"dompurify\"\n$$$_",
      "import * as $S from \"isomorphic-dompurify\"\n$$$_",
      "import * as $S from \"sanitize-html\";\n$$$_",
      "import * as $S from \"underscore.string\"\n$$$_",
      "import * as $S from 'xss';\n$$$_",
      "import { $$$_, $S,$$$_ } from \"dompurify\"\n$$$_",
      "{dangerouslySetInnerHTML: {__html: $X}, $$$_}",
      "{dangerouslySetInnerHTML: {__html: \"$$$_\"}, $$$_}",
      "{$$$_}"
    ])) as $all
    | ( (($all | of(["{dangerouslySetInnerHTML: {__html: $X}, $$$_}","<$Y dangerouslySetInnerHTML={{__html: $X}} />"])
          | focus("X")
          | not_at($all | of(["<$Y dangerouslySetInnerHTML={{__html: \"$$$_\"}} />"]))
          | not_at($all | of(["{dangerouslySetInnerHTML: {__html: \"$$$_\"}, $$$_}"]))
          | not_at($all | of(["$PWRQDEEP1"])
          | where_capture_ast("PWRQDEEP1"; "{__html: \"$$$_\"}"))
          | not_at($all | of(["$PWRQDEEP1"])
          | where_capture_ast("PWRQDEEP1"; "{__html: `$$$_`}"))))
          | reaching(((($all
          | within($all | of(["function $$$_({$$$_, $X, $$$_}) { $$$_ }"])))
          + ($all
          | within($all | of(["function $$$_($$$_, $X, $$$_) { $$$_ }"])))
          | focus("X")
          | outside($all | of(["$F. $$$_ .$SANITIZEUNC($$$_)"]))));
              ((($all
          | in_files_with($all | of(["import $S from \"underscore.string\"\n$$$_"])))
          + ($all
          | in_files_with($all | of(["import * as $S from \"underscore.string\"\n$$$_"])))
          + ($all
          | in_files_with($all | of(["import $S from \"underscore.string\"\n$$$_"])))
          + ($all
          | in_files_with($all | of(["$S = require(\"underscore.string\")\n$$$_"])))
          | at_same_place(($all | of(["$S.escapeHTML($$$_)"]))))
              + (($all
          | in_files_with($all | of(["import $S from \"dompurify\"\n$$$_"])))
          + ($all
          | in_files_with($all | of(["import { $$$_, $S,$$$_ } from \"dompurify\"\n$$$_"])))
          + ($all
          | in_files_with($all | of(["import * as $S from \"dompurify\"\n$$$_"])))
          + ($all
          | in_files_with($all | of(["$S = require(\"dompurify\")\n$$$_"])))
          + ($all
          | in_files_with($all | of(["import $S from \"isomorphic-dompurify\"\n$$$_"])))
          + ($all
          | in_files_with($all | of(["import * as $S from \"isomorphic-dompurify\"\n$$$_"])))
          + ($all
          | in_files_with($all | of(["$S = require(\"isomorphic-dompurify\")\n$$$_"])))
          | at_same_place((($all | of(["$VALUE.sanitize($$$_)"])
          | in_files_with($all | of(["$VALUE = $S($$$_)\n$$$_"])))
          + ($all | of(["$S($$$_)"])
          | in_files_with($all | of(["$VALUE = $S.sanitize\n$$$_"])))
          + ($all | of(["$S.sanitize($$$_)"]))
          + ($all | of(["$S($$$_)"])))))
              + (($all
          | in_files_with($all | of(["import $S from 'xss';\n$$$_"])))
          + ($all
          | in_files_with($all | of(["import * as $S from 'xss';\n$$$_"])))
          + ($all
          | in_files_with($all | of(["$S = require(\"xss\")\n$$$_"])))
          | at_same_place(($all | of(["$S($$$_)"]))))
              + (($all
          | in_files_with($all | of(["import $S from 'sanitize-html';\n$$$_"])))
          + ($all
          | in_files_with($all | of(["import * as $S from \"sanitize-html\";\n$$$_"])))
          + ($all
          | in_files_with($all | of(["$S = require(\"sanitize-html\")\n$$$_"])))
          | at_same_place(($all | of(["$S($$$_)"]))))
              + (($all
          | in_files_with($all | of(["$S = new Remarkable()\n$$$_"])))
          | at_same_place(($all | of(["$S.render($$$_)"]))))))
        | finding("react-dangerouslysetinnerhtml";
            "Detection of dangerouslySetInnerHTML from non-constant definition.") ) )
| report
