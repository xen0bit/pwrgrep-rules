# rules: dangerous-subprocess-use-audit
# languages: python
# fixture: python/dangerous-subprocess-use-audit.py
# from: python/lang/security/audit/dangerous-subprocess-use-audit.yaml
#
# Repair: the translated rule reported every `subprocess.$FUNC($$$_)`, which
# is any call whose command is not a literal - `subprocess.run(cmd)` with a
# fixed argv list included, and 60% of the 364 findings the audit judged had
# a rationale saying the call was safe. It now reports only the calls that
# build a shell command out of a non-literal value, which is what makes the
# injection real: a shell-formatted command, `shell=True` with a variable, or
# os.system/os.popen with a variable. A literal command is not reported.

. as $root
| ( ($root | scan_ast(["*.py"]; [
      "subprocess.$F($ARG, shell=True, $$$_)",
      "subprocess.$F(\"$$$_\" % $$$_, $$$_)",
      "subprocess.$F(\"$$$_\".format($$$_), $$$_)",
      "subprocess.$F(f\"$$$_\", $$$_)",
      "os.system($ARG)",
      "os.popen($ARG, $$$_)",
      "os.popen($ARG)"
    ])) as $all
    | ( $all
        | not_at($all | of(["subprocess.$F($ARG, shell=True, $$$_)"])
        | where_capture("ARG"; "^[\"'][^\"']*[\"']$"))
        | not_at($all | of(["os.system($ARG)","os.popen($ARG, $$$_)","os.popen($ARG)"])
        | where_capture("ARG"; "^[\"'][^\"']*[\"']$"))
        | finding("dangerous-subprocess-use-audit";
            "the command is built from a non-literal value and runs through a "
            + "shell, so whoever controls that value controls the command; pass "
            + "a list of arguments and shell=False") ) )
| report
