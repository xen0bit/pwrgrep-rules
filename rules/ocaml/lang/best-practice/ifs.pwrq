# rules: ocamllint-useless-else, ocamllint-backwards-if
# languages: ocaml
# fixture: ocaml/ocamllint-useless-else.ml
# from: ocaml/lang/best-practice/ifs.yaml

. as $root
| ( ($root | scan_regex(["*.ml"]; [
      "else\\s+\\(\\)",
      "then\\s+\\(\\)\\s+else"
    ])) as $all
    | ( $all | of(["else\\s+\\(\\)"])
        | finding("ocamllint-useless-else";
            "Useless else.") )
      + ( $all | of(["then\\s+\\(\\)\\s+else"])
        | finding("ocamllint-backwards-if";
            "Backwards if.") ) )
| report
