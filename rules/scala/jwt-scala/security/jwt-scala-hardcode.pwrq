# rules: jwt-scala-hardcode
# languages: scala
# fixture: scala/jwt-scala-hardcode.scala
# from: scala/jwt-scala/security/jwt-scala-hardcode.yaml

. as $root
| ( ($root | scan_ast(["*.scala"]; [
      "$JWT.encode($X, $K, $$$_)",
      "$JWT.decode($X, $K, $$$_)",
      "$JWT.decodeRawAll($X, $K, $$$_)",
      "$JWT.decodeRaw($X, $K, $$$_)",
      "$JWT.decodeAll($X, $K, $$$_)",
      "$JWT.validate($X, $K, $$$_)",
      "$JWT.isValid($X, $K, $$$_)",
      "$JWT.decodeJson($X, $K, $$$_)",
      "$JWT.decodeJsonAll($X, $K, $$$_)",
      "import pdi.jwt.$DEPS\n$$$_"
    ])) as $all
    | ( $all | of(["$JWT.encode($X, $K, $$$_)", "$JWT.decode($X, $K, $$$_)", "$JWT.decodeRawAll($X, $K, $$$_)", "$JWT.decodeRaw($X, $K, $$$_)", "$JWT.decodeAll($X, $K, $$$_)", "$JWT.validate($X, $K, $$$_)", "$JWT.isValid($X, $K, $$$_)", "$JWT.decodeJson($X, $K, $$$_)", "$JWT.decodeJsonAll($X, $K, $$$_)"])
          | where_capture("K"; "^\\\".*\\\"$")
          | in_files_with($all | of(["import pdi.jwt.$DEPS\n$$$_"]))
        | finding("jwt-scala-hardcode";
            "Hardcoded JWT secret or private key is used.") ) )
| report
