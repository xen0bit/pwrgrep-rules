# rules: servletresponse-writer-xss
# languages: java
# fixture: java/CWE-79-xss.java
# from: java/lang/security/servletresponse-writer-xss.yaml

["$R.getParameter($$$_)", "$R.getHeader($$$_)", "$R.getQueryString()"] as $src
| ["$RESP.getWriter().write($X)", "$WRITER.write($X)"] as $sinks
| scan_ast("*.java"; $src + $sinks) as $all
| ($all | of($sinks) | focus("X") | reaching($all | of($src); []) | finding("servletresponse-writer-xss"; "Cross-site scripting detected in HttpServletResponse writer with variable '$VAR'."))
| report
