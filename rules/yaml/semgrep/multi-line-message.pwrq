# rules: multi-line-message
# languages: yaml
# fixture: yaml/semgrep-multi-line-message.yaml
#
# Block scalars are invisible to AST patterns and =~/.../ matches every
# message, so no form distinguished them. Rewritten as a regex over the
# literal-block indicator. Both globs are scanned.
# A `rules:` key at column zero is what says the file is a Semgrep rule and
# not something else that spells a key the same way: `metadata:` is every
# Kubernetes manifest, `- id:` is any list of records, and `message: |` is
# any workflow that writes more than a line.
# from: yaml/semgrep/multi-line-message.yaml
. as $root
| ($root | scan_regex(["*.yaml","*.yml"]; [
      "(?m)^rules:[^\\S\n]*$"
    ])) as $semgrep
| ( (($root | scan_regex(["*.yaml","*.yml"]; [
      "message:\\s*\\|"
    ])) | in_files_with($semgrep)) as $all
    | ( $all | of(["message:\\s*\\|"])
        | finding("multi-line-message";
            "This rule has a multi-line message field, which may display poorly in a terminal.") ) )
| report
