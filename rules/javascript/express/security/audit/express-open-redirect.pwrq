# rules: express-open-redirect
# languages: javascript, typescript
# fixture: javascript/express-open-redirect.js
# from: javascript/express/security/audit/express-open-redirect.yaml
#
# Repair: dead as written. Three defects, all verified with probes:
# `function $$$_ (...)` matches only named declarations and
# `$APP.$METHOD(..., function $FUNC...)` only named callbacks, so anonymous
# route handlers never counted as sources (now split into anon-expression
# and named-declaration shapes); `at_same_place` needs exact span
# coincidence, so a sink call could never coincide with the source inside it
# (gates dropped in favour of `reaching`, sources taken `within` handlers);
# and the 20 overlapping sink spellings suppressed each other in one scan
# (only the `$ASSIGN` catch-all ever matched), so the sinks are a single
# `$DST` hole over the one- and two-argument shapes. Globs cover *.js too.

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$APP.$METHOD($$$_, function $FUNC($REQ, $RES) {$$$_})",
      "$APP.$METHOD($$$_, function $FUNC($REQ, $RES, $NEXT) {$$$_})",
      "$APP.$METHOD($$$_, function ($REQ, $RES) {$$$_})",
      "$APP.$METHOD($$$_, function ($REQ, $RES, $NEXT) {$$$_})",
      "$REQ.body",
      "$REQ.cookies",
      "$REQ.headers",
      "$REQ.params",
      "$REQ.query",
      "$RES.redirect($DST)",
      "$RES.redirect($STA, $DST)",
      "({ $REQ }: Request,$RES: Response) => {$$$_}",
      "({ $REQ }: Request,$RES: Response, $NEXT: NextFunction) =>\n{$$$_}",
      "body",
      "cookies",
      "function ($REQ, $RES) {$$$_}",
      "function $FUNC($REQ, $RES) {$$$_}",
      "function ($REQ, $RES, $NEXT) {$$$_}",
      "function $FUNC($REQ, $RES, $NEXT) {$$$_}",
      "headers",
      "params",
      "query"
    ])) as $all
    | ( (($all | of(["$RES.redirect($DST)","$RES.redirect($STA, $DST)"])
          | focus("DST")))
          | reaching(((($all | of(["$REQ.query","$REQ.body","$REQ.params","$REQ.cookies","$REQ.headers"]))
          | within((($all | of(["function ($REQ, $RES) {$$$_}","function $FUNC($REQ, $RES) {$$$_}","function ($REQ, $RES, $NEXT) {$$$_}","function $FUNC($REQ, $RES, $NEXT) {$$$_}"]))
          + ((($all | of(["$APP.$METHOD($$$_, function $FUNC($REQ, $RES) {$$$_})","$APP.$METHOD($$$_, function ($REQ, $RES) {$$$_})"]))
          + ($all | of(["$APP.$METHOD($$$_, function $FUNC($REQ, $RES, $NEXT) {$$$_})","$APP.$METHOD($$$_, function ($REQ, $RES, $NEXT) {$$$_})"])))
          | where_capture("METHOD"; "^(get|post|put|head|delete|options)$")))))
              + (($all
          | within($all | of(["({ $REQ }: Request,$RES: Response, $NEXT: NextFunction) =>\n{$$$_}"])))
          + ($all
          | within($all | of(["({ $REQ }: Request,$RES: Response) => {$$$_}"])))
          | at_same_place(($all | of(["params","query","cookies","headers","body"])))
          | focus("REQ")));
              ([]))
        | finding("express-open-redirect";
            "The application redirects to a URL specified by user-supplied input that is not validated.") ) )
| report
