# rules: ftp-request
# languages: go
# fixture: problem-based-packs/go-ftp-request.go
#
# The `"=~/^ftp.../"` string guards never match - the matcher has no
# regex-literal reading - and the `;\n$$$_` gaps do not span Go statements,
# so no form fired. Rewritten as direct ftp-package calls with named holes;
# the package only speaks FTP, so no URL guard is needed.
# from: problem-based-packs/insecure-transport/go-stdlib/ftp-request.yaml

. as $root
| ( ($root | scan_ast(["*.go"]; [
      "ftp.Connect($URL)",
      "ftp.Dial($URL)",
      "ftp.Dial($URL,$OPTS)",
      "ftp.DialTimeout($URL,$TIMEOUT)"
    ])) as $all
    | ( $all | of(["ftp.Connect($URL)","ftp.Dial($URL)","ftp.Dial($URL,$OPTS)","ftp.DialTimeout($URL,$TIMEOUT)"])
        | finding("ftp-request";
            "Checks for outgoing connections to ftp servers with the ftp package.") ) )
| report
