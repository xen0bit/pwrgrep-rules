# rules: use_deprecated_cipher_algorithm
# languages: c_sharp
# fixture: csharp/use_deprecated_cipher_algorithm.cs
#
# The translated sink names any `.Create()` call, which flags `Aes.Create()`
# too. It is narrowed to the broken ciphers the rule is about.
# from: csharp/dotnet/security/use_deprecated_cipher_algorithm.yaml

. as $root
| ( ($root | scan_ast(["*.cs"]; [
      "$KEYTYPE.Create($$$_);"
    ])) as $all
    | ( $all | of(["$KEYTYPE.Create($$$_);"])
        | where_capture("KEYTYPE"; "^(?:DES|TripleDES|RC2)$")
        | finding("use_deprecated_cipher_algorithm";
            "Usage of deprecated cipher algorithm detected.") ) )
| report
