# rules: skip-tls-verify-cluster
# languages: yaml
# fixture: yaml/k8s-skip-tls-cluster.yaml
# from: yaml/kubernetes/security/skip-tls-verify-cluster.yaml

. as $root
| ( ($root | scan_ast(["*.yaml","*.yml"]; [
      "insecure-skip-tls-verify: true"
    ])) as $all
    | ( $all | of(["insecure-skip-tls-verify: true"])
        | finding("skip-tls-verify-cluster";
            "Cluster is disabling TLS certificate verification when communicating with the server.") ) )
| report
