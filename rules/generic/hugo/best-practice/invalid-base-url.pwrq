# rules: invalid-base-url
# fixture: generic/invalid-base-url.txt
# from: generic/hugo/best-practice/invalid-base-url.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "\\(\\.\\*http\\)\\.\\*",
      "baseURL\\s+=\\s+\"[\\s\\S]*?\""
    ])) as $all
    | ( $all | of(["baseURL\\s+=\\s+\"[\\s\\S]*?\""])
          | not_at($all | of(["\\(\\.\\*http\\)\\.\\*"]))
        | finding("invalid-base-url";
            "The 'baseURL' is invalid.") ) )
| report
