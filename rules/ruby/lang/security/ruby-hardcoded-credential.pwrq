# rules: ruby-hardcoded-credential
# languages: ruby
# fixture: ruby/CWE-798.rb
# from: generic/secrets/security/detected-generic-secret.yaml + CWE-798
#
# CWE-798 Hardcoded Credential. Non-taint detection via regex for assignments
# where variable name looks like password/secret/api_key and RHS is a quoted string.

. as $root
| ( ($root | scan_regex(["*.rb"]; [
      "(?i)\\b(password|passwd|pwd|secret|api[_-]?key|aws[_-]?secret|token|credential)\\b\\s*=\\s*\"[^\"]{4,}\"",
      "(?i)\\b(password|passwd|pwd|secret|api[_-]?key|aws[_-]?secret|token|credential)\\b\\s*=\\s*'[^']{4,}'"
    ])) as $all
  | ($all | of(["(?i)\\b(password|passwd|pwd|secret|api[_-]?key|aws[_-]?secret|token|credential)\\b\\s*=\\s*\"[^\"]{4,}\"","(?i)\\b(password|passwd|pwd|secret|api[_-]?key|aws[_-]?secret|token|credential)\\b\\s*=\\s*'[^']{4,}'"]) | where_text_not("(?i)\"(test|example|changeme|placeholder)\"") | where_text_not("(?i)'(test|example|changeme|placeholder)'") | where_text_not("(?i)https?://") | where_text_not("(?i)[_-](url|uri|endpoint|host|scheme|name|type)\\s*="))
  | finding("ruby-hardcoded-credential"; "Hardcoded credential detected; use environment variable or secret manager")
)
| report
