# rules: do-privileged-use
# languages: java
# fixture: java/do-privileged-use.java
# from: java/lang/security/do-privileged-use.yaml
#
# The import gate trailed a statement gap that matches nothing, so no
# file ever qualified. It ends at the semicolon now.

. as $root
| ( ($root | scan_ast(["*.java"]; [
      "AccessController.doPrivileged($$$_);",
      "class $ACTION implements PrivilegedAction<Void> { $$$_ }",
      "import java.security.*;"
    ])) as $all
    | ( $all | of(["AccessController.doPrivileged($$$_);","class $ACTION implements PrivilegedAction<Void> { $$$_ }"])
          | in_files_with($all | of(["import java.security.*;"]))
        | finding("do-privileged-use";
            "Marking code as privileged enables a piece of trusted code to temporarily enable access to more resources than are available directly to the code that called it.") ) )
| report
