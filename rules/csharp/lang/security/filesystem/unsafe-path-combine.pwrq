# rules: unsafe-path-combine
# languages: c_sharp
# fixture: csharp/unsafe-path-combine.cs
#
# `Path.Combine($$$_, $A, $$$)` brackets a named hole in ellipses, which
# matches nothing - the two-argument call is named exactly now (with a
# three-argument sibling). The method linchpin had the same brackets and no
# modifier; the filename parameter is bound in typed one- and two-parameter
# signatures instead, with a variadic body so fixture comments do not hide
# the method. Sources are the parameters themselves rather than every
# Combine argument, so a name transformed through GetFileName arrives clean.
# Two file-level sanitizers are dropped: `$X` in a file with a
# guard sanitizes every value in the file, which silenced the whole rule.
# The `if-throw` guard is not modeled - only values transformed through
# GetFileName are clean. The Combine itself is a file-level gate rather
# than a step on the path: a name assigned from Combine and read a
# statement later is the shape the rule exists for, and there is no
# operator for "the value passed through this call on its way".
# from: csharp/lang/security/filesystem/unsafe-path-combine.yaml

. as $root
| ( ($root | scan_ast(["*.cs"]; [
      "File.$METHOD($X)",
      "Path.Combine($A, $B)", "Path.Combine($A, $B, $C)",
      "Path.GetFileName($$$_)",
      "public $TYPE $M($T $A) { $$$BODY }", "public $TYPE $M($T1 $A, $T2 $B) { $$$BODY }"
    ])) as $all
    | ( (($all | of(["File.$METHOD($X)"])
          | focus("X")
          | where_capture("METHOD"; "^(?:(?i)^(read|write))")
          | in_files_with($all | of(["Path.Combine($A, $B)", "Path.Combine($A, $B, $C)"]))))
          | reaching((($all | of(["public $TYPE $M($T $A) { $$$BODY }", "public $TYPE $M($T1 $A, $T2 $B) { $$$BODY }"])
          | focus("A")));
              (($all | of(["Path.GetFileName($$$_)"]))))
        | finding("unsafe-path-combine";
            "String argument $A is used to read or write data from a file via Path.Combine without direct sanitization via Path.GetFileName.") ) )
| report
