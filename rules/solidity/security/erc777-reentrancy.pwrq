# rules: erc777-reentrancy
# languages: solidity
# fixture: solidity/CWE-841-erc777.sol
# from: solidity/security/erc777-reentrancy.yaml

. as $root
| ( ($root | scan_regex(["*.sol"]; [
      "tokensReceived\\s*\\("
    ])) as $all
    | ( $all | of(["tokensReceived\\s*\\("])
        | finding("erc777-reentrancy";
            "ERC777 reentrancy via tokensReceived") ) )
| report
