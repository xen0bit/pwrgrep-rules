# rules: detected-google-api-key
# fixture: generic/detected-google-api-key.txt
# from: generic/secrets/security/detected-google-api-key.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "\\bAIzaSy[0-9A-Za-z-_]{33}\\b",
      "\\bAIzaSy[0-9A-Za-z-_]{33}\\b[=]"
    ])) as $all
    | ( $all | of(["\\bAIzaSy[0-9A-Za-z-_]{33}\\b"])
          | not_at($all | of(["\\bAIzaSy[0-9A-Za-z-_]{33}\\b[=]"]))
        | finding("detected-google-api-key";
        "this is a google api key written into the source, so it is in every checkout "
        + "and every image built from one; read it from the environment, and "
        + "rotate this one because it has leaked") ) )
| report
