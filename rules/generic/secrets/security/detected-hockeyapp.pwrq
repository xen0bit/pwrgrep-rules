# rules: detected-hockeyapp
# fixture: generic/detected-hockeyapp.txt
# from: generic/secrets/security/detected-hockeyapp.yaml

. as $root
| ( ($root | scan_regex(["*"]; [
      "(?i)hockey.{0,50}(\\\\\\\"|'|`)?[0-9a-f]{32}(\\\\\\\"|'|`)?"
    ])) as $all
    | ( $all | of(["(?i)hockey.{0,50}(\\\\\\\"|'|`)?[0-9a-f]{32}(\\\\\\\"|'|`)?"])
        | finding("detected-hockeyapp";
        "this is a hockeyapp written into the source, so it is in every checkout "
        + "and every image built from one; read it from the environment, and "
        + "rotate this one because it has leaked") ) )
| report
