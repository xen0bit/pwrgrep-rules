# rules: phantom-injection
# languages: javascript, typescript
# fixture: javascript/phantom-injection.js
# from: javascript/phantom/security/audit/phantom-injection.yaml
#
# Repair: dead as written. The literal-argument exclusions read their holes
# as any value and subtracted every call, and bare `$X = require()` missed
# const/let/var. The exclusions now keep only fully-quoted text and the gate
# covers all declaration forms.

. as $root
| ( ($root | scan_ast(["*.js","*.ts"]; [
      "$PAGE.evaluateJavaScript($INPUT, $$$_)",
      "$PAGE.open($INPUT, $$$_)",
      "$PAGE.openUrl($INPUT, $$$_)",
      "$PAGE.property(\"content\",$INPUT, $$$_)",
      "$PAGE.setContent($INPUT, $$$_)",
      "$PHANTOM = require('phantom');\n$$$_",
      "const $PHANTOM = require('phantom')"
    ])) as $all
    | ( $all | of(["$PAGE.open($INPUT, $$$_)","$PAGE.property(\"content\",$INPUT, $$$_)","$PAGE.setContent($INPUT, $$$_)","$PAGE.openUrl($INPUT, $$$_)","$PAGE.evaluateJavaScript($INPUT, $$$_)"])
          | not_at(($all | of(["$PAGE.open($INPUT, $$$_)","$PAGE.property(\"content\",$INPUT, $$$_)","$PAGE.setContent($INPUT, $$$_)","$PAGE.openUrl($INPUT, $$$_)","$PAGE.evaluateJavaScript($INPUT, $$$_)"]) | where_capture("INPUT"; "^[\"'].*[\"']$")))
          | in_files_with(($all | of(["$PHANTOM = require('phantom');\n$$$_", "const $PHANTOM = require('phantom')"])))
        | finding("phantom-injection";
            "If unverified user data can reach the `phantom` page methods it can result in Server-Side Request Forgery vulnerabilities") ) )
| report
