# rules: server-dangerous-object-deserialization
# languages: java
# fixture: java/server-dangerous-object-deserialization.java
# from: java/rmi/security/server-dangerous-object-deserialization.yaml

. as $root
| ( ($root | scan_ast(["*.java"]; [
      "interface $INTERFACE extends Remote {\n  $RETURNTYPE $METHOD($PARAMTYPE $PARAM) throws RemoteException;\n}"
    ])) as $all
    | ( $all | of(["interface $INTERFACE extends Remote {\n  $RETURNTYPE $METHOD($PARAMTYPE $PARAM) throws RemoteException;\n}"])
        | finding("server-dangerous-object-deserialization";
            "Using an arbitrary object ('$PARAMTYPE $PARAM') with Java RMI is an insecure deserialization vulnerability.") ) )
| report
