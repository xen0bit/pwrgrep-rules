# rules: azure-network-watcher-flowlog-period
# languages: hcl
# fixture: terraform/azure-network-watcher-flowlog-period.tf
#
# The translated rule filtered `of(["resource"])` — bare-keyword matches that bind no $DAYS — and then compared it, so the comparison saw no hole and the rule was empty (the `at_same_place` against the block could never coincide either). The finding base is now the dated block reading itself, minus the compliant spelling.
# from: terraform/azure/security/azure-network-watcher-flowlog-period.yaml

. as $root
| ( ($root | scan_ast(["*.tf"]; [
      "resource \"azurerm_network_watcher_flow_log\" \"$$$_\" {\n$$$_\nretention_policy {\n$$$_\nenabled = true\ndays = $DAYS\n$$$_\n}\n$$$_\n}",
      "resource \"azurerm_network_watcher_flow_log\" \"$$$_\" {\n$$$_\nretention_policy {\n$$$_\nenabled = true\ndays = 0\n$$$_\n}\n$$$_\n}"
    ])) as $all
    | ( ($all | of(["resource \"azurerm_network_watcher_flow_log\" \"$$$_\" {\n$$$_\nretention_policy {\n$$$_\nenabled = true\ndays = $DAYS\n$$$_\n}\n$$$_\n}"])
        | outside($all | of(["resource \"azurerm_network_watcher_flow_log\" \"$$$_\" {\n$$$_\nretention_policy {\n$$$_\nenabled = true\ndays = 0\n$$$_\n}\n$$$_\n}"]))
        | where_capture_compare("$DAYS < 90"))
        | finding("azure-network-watcher-flowlog-period";
            "Ensure that Network Security Group Flow Log retention period is 90 days or greater") ) )
| report
