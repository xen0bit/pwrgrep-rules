# rules: skip-tls-verify-service
# languages: yaml
# fixture: yaml/k8s-skip-tls-service.yaml
# from: yaml/kubernetes/security/skip-tls-verify-service.yaml

. as $root
| ( ($root | scan_ast(["*.yaml","*.yml"]; [
      "insecureSkipTLSVerify: true"
    ])) as $all
    | ( $all | of(["insecureSkipTLSVerify: true"])
        | finding("skip-tls-verify-service";
            "Service is disabling TLS certificate verification when communicating with the server.") ) )
| report
